+/*
+########
+# ipcacheSimulatorLookup -> const ipcache_addrs * (주소 목록, 실패하면 nullptr)
+# squid --simulate에서 비동기 DNS 대신 쓰는 조회. ipcache_simulator_mode 2일 때만 getaddrinfo()로 동기 조회해
+# 중복을 뺀 주소(최대 32개)를 hosts_file 항목처럼 고정 캐시에 넣고, 1이면 조회하지 않는다.
+# 실패한 이름은 기억해 다시 막히는 조회를 하지 않는다.
+########
+*/
+static const ipcache_addrs *
+ipcacheSimulatorLookup(const char *name)
+{
+    if (ipcache_simulator_mode != 2)
+        return nullptr;
+
+    static std::set<std::string> failed;
+    if (failed.count(name))
+        return nullptr;
+
+    struct addrinfo hints;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = Ip::EnableIpv6 ? AF_UNSPEC : AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    struct addrinfo *res = nullptr;
+    if (getaddrinfo(name, nullptr, &hints, &res) != 0 || !res) {
+        debugs(14, 3, "simulator: cannot resolve " << name);
+        failed.insert(name);
+        return nullptr;
+    }
+
+    const auto i = new ipcache_entry(name);
+    for (const struct addrinfo *ai = res; ai; ai = ai->ai_next) {
+        Ip::Address a;
+        if (!(a = *ai))
+            continue;
+        a.port(0);
+        i->addrs.pushUnique(a);
+    }
+    freeaddrinfo(res);
+    if (i->addrs.empty()) {
+        delete i;
+        failed.insert(name);
+        return nullptr;
+    }
+
+    i->flags.fromhosts = true;
+    ipcacheAddEntry(i);
+    ipcacheLockEntry(i);
+    return &i->addrs;
+}
