+        std::cerr << "squid --simulate: error while writing " << ReportFile << std::endl;
+        return false;
+    }
+    return true;
+}
+
+/*
+########
+# ReadLog -> bool (열지 못하면 false)
+# LogFile(또는 표준 입력)을 줄 단위로 읽어 Records에 넣는다. 끝의 \r을 지우고, 빈 줄과 #으로 시작하는 줄은
+# 건너뛰되 줄 번호는 센다. 파싱에 실패한 줄도 SKIP으로 보고하도록 넣는다.
+########
+*/
+static bool
+ReadLog()
+{
+    std::ifstream file;
+    std::istream *in = &std::cin;
+    if (strcmp(LogFile, "-") != 0) {
+        file.open(LogFile);
+        if (!file) {
+            std::cerr << "squid --simulate: cannot open " << LogFile << std::endl;
+            return false;
+        }
+        in = &file;
+    }
+
+    std::string line;
+    unsigned lineNo = 0;
+    while (std::getline(*in, line)) {
+        ++lineNo;
+        if (!line.empty() && line.back() == '\r')
+            line.pop_back();
+        if (line.empty() || line[0] == '#')
+            continue;
+        Record r;
+        r.lineNo = lineNo;
+        r.parsed = ParseLine(line, r);
+        Records.push_back(r);
+    }
+    return true;
+}
+
+/*
+########
+# RunConfig -> bool (http_access가 없으면 false)
+# 지금 파싱된 squid.conf로 Records 전부를 재생한다. hosts_file을 읽어 두고(--sim-dns off에서도 매칭되도록),
+# 연결 수가 없으므로 client_db를 끄고, 로컬 포트를 정한 뒤 요청마다 Evaluate(), CountDecision(), 필요하면 PrintDecision().
+########
+*/
+static bool
+RunConfig(ConfigRun &run, const bool current, const bool printEach)
+{
+    const Acl::Tree *tree = HttpAccessTree();
+    if (!tree) {
+        std::cerr << "squid --simulate: " << run.path << " has no http_access rules" << std::endl;
+        return false;
+    }
+
+    parseEtcHosts();
+    Config.onoff.client_db = 0;
+    const int localPort = LocalPortOption >= 0 ? LocalPortOption :
+                          (HttpPortList != nullptr ? HttpPortList->s.port() : CACHE_HTTP_PORT);
+
+    run.rules = CollectRules(tree);
+    run.decisions.reserve(Records.size());
+    for (auto &r : Records) {
+        run.decisions.push_back(Evaluate(r, run, current, localPort));
+        CountDecision(run, run.decisions.back());
+        if (printEach)
+            PrintDecision(r, run.decisions.back(), run);
+    }
+    return true;
+}
+
+/*
+########
+# Run -> int (프로세스 종료 코드)
+# 시뮬레이터의 진입점. 로그를 읽고, DNS 모드를 정해 ipcache/fqdncache를 초기화하고, Tracer를 건다.
+# 현재 설정을 재생하고, --optimize면 다른 설정을 읽기 전에 Analyze()한다.
+# --sim-compare면 노트와 hosts_file 캐시 항목을 지우고(새 설정의 hosts_file만 쓰도록) 새 설정을 파싱해
+# 재생·분석하고 바뀐 요청을 출력한다.
+# Tracer를 떼고 요약, 최적화 결과, 리포트를 차례로 쓴다. 요청별 출력은 그것이 주 출력일 때만 한다.
+########
+*/
+static int
+Run()
+{
+    Color = isatty(STDOUT_FILENO);
+    if (LogFile && !ReadLog())
+        return 1;
+
+    ipcache_simulator_mode = DnsMode;
+    fqdncache_simulator_mode = DnsMode;
+    ipcache_init();
+    fqdncache_init();
+    ACLChecklist::Tracer = &Trace;
+
+    const bool printEach = LogFile && !CompareConf && (!ReportFile || ShowTrace);
+
+    Runs[0].path = ConfigFile ? ConfigFile : "";
+    if (!RunConfig(Runs[0], true, printEach))
+        return 1;
+    if (Optimize)
+        Analyze(Runs[0]);
+
+    if (CompareConf) {
+        Runs[1].path = CompareConf;
+        Acl::ClearConfigNotes();
+        ipcache_restart();
+        fqdncache_restart();
+        xfree(ConfigFile);
+        ConfigFile = xstrdup(CompareConf);
+        try {
+            Configuration::Parse();
+        } catch (...) {
+            std::cerr << "squid --simulate: errors in " << CompareConf << ": " << CurrentException << std::endl;
+            return 1;
+        }
+        if (!RunConfig(Runs[1], false, false))
+            return 1;
+        if (Optimize)
+            Analyze(Runs[1]);
+        if (LogFile)
+            PrintChanges();
+    }
+
+    ACLChecklist::Tracer = nullptr;
+    if (LogFile) {
+        PrintRunSummary(CompareConf ? "current" : "", Runs[0], true);
+        if (CompareConf) {
+            PrintRunSummary("new", Runs[1], false);
+            PrintCompareSummary();
+        }
+    }
+    if (Optimize) {
+        PrintFindings(CompareConf ? "current " : "", Runs[0]);
+        if (CompareConf)
+            PrintFindings("new ", Runs[1]);
+    }
+
+    if (ReportFile) {
+        if (!WriteReport())
+            return 1;
+        std::cout << "\n# report written to " << ReportFile << "\n";
+    }
+    return 0;
+}
+
