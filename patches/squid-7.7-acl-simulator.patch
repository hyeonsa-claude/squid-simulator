+*/
+static const char *CompareConf = nullptr;
+
+/*
+########
+# ReportFile -> const char * (--report 인자)
+# HTML 리포트를 쓸 경로. nullptr이면 리포트를 쓰지 않는다.
+########
+*/
+static const char *ReportFile = nullptr;
+
+/*
+########
+# Optimize -> bool (--optimize)
+# true면 Analyze()로 설정 분석을 한다.
+########
+*/
+static bool Optimize = false;
+
+/*
+########
+# ShowTrace -> bool (--sim-trace)
+# true면 요청마다 규칙·ACL별 평가 과정을 출력한다.
+########
+*/
+static bool ShowTrace = false;
+
+/*
+########
+# DnsMode -> int (--sim-dns)
+# 1 = off: 조회하지 않고 hosts_file 항목만 쓴다. 2 = system: getaddrinfo()로 동기 조회한다.
+# ipcache_simulator_mode / fqdncache_simulator_mode에 그대로 넘긴다.
+########
+*/
+static int DnsMode = 1;
+
+/*
+########
+# LocalPortOption -> int (--sim-port)
+# 가짜 요청의 로컬 포트. -1이면 첫 http_port를 쓴다.
+########
+*/
+static int LocalPortOption = -1;
+
+/*
+########
+# ReportRowLimit -> size_t
+# HTML 리포트 표 하나에 넣는 최대 행 수. 큰 로그에서도 리포트가 열리도록 제한한다.
+########
+*/
+static const size_t ReportRowLimit = 5000;
+
+/*
+########
+# Record -> 클래스: 로그 한 줄
+# lineNo: 원본 줄 번호, parsed: 파싱 성공 여부, hasTime/when: %tl을 UTC epoch로 바꾼 값,
+# tzOffset: %tl의 UTC 오프셋(초, 동쪽이 양수), localIp(%la), clientIp(%>a), method(%rm), url(%ru), version(%rv),
+# status(%>Hs), squidStatus(%Ss).
+########
+*/
+class Record
+{
+public:
+    unsigned lineNo = 0;
+    bool parsed = false;
+    bool hasTime = false;
+    time_t when = 0;
+    int tzOffset = 0;
+    std::string localIp, clientIp, method, url, version;
+    std::string status, squidStatus;
+};
+
+/*
+########
+# RuleMatch -> 클래스: 요청에 매칭된 규칙 하나
+# name: "http_access#N", action: allow, deny, 또는 그 규칙에서 검사가 멈춘 예외 응답(auth, dunno),
+# text: treeDump()로 얻은 규칙 줄 전체(이어 쓴 줄도 한 줄로).
+########
+*/
+class RuleMatch
+{
+public:
+    std::string name;
+    std::string action;
+    std::string text;
+};
+
+/*
+########
+# Decision -> 클래스: squid.conf 하나가 요청 하나를 판정한 결과
+# verdict: ALLOW, DENY, AUTH, DUNNO, SKIP. rule: 판정 규칙 이름, implicit, 또는 -. ruleText: 그 규칙 줄.
+# matches: 매칭되는 규칙 전부를 순서대로 (implicit이 아니면 [0]이 판정 규칙, 예외 응답으로 멈춘 규칙도 포함).
+# unsure: 오프라인에서 결과를 확정할 수 없는 ACL 이름들. trace: 규칙별 평가 과정(--sim-trace, 리포트용).
+# vsLog: 실제 로그와의 비교 same / DIFF / UNSURE / n/a (현재 설정에서만).
+# host: 이 설정으로 해석한 "호스트:포트". 설정(append_domain 등)마다 다를 수 있어 판정마다 따로 둔다.
+########
+*/
+class Decision
+{
+public:
+    std::string verdict = "SKIP";
+    std::string rule = "-";
+    std::string ruleText;
+    std::vector<RuleMatch> matches;
+    std::string unsure;
+    std::string trace;
+    std::string vsLog = "n/a";
+    std::string host;
+};
+
+/*
+########
+# RuleInfo -> 클래스: 설정된 http_access 규칙 하나
+# name, action, text, acls(규칙의 ACL 이름, 부정은 "!이름"),
+# decided: 이 규칙이 판정한 요청 수, shadowed: 앞 규칙이 이미 판정했지만 이 규칙에도 매칭된 요청 수.
+########
+*/
+class RuleInfo
+{
+public:
+    std::string name;
+    std::string action;
+    std::string text;
+    std::vector<std::string> acls;
+    unsigned decided = 0;
+    unsigned shadowed = 0;
+};
+
+/*
+########
+# Finding -> 클래스: --optimize 결과 하나
+# severity: 3 HIGH, 2 MEDIUM, 1 LOW, 0 INFO. category: 항목 이름. subject: ACL 또는 규칙 이름.
+# where: 파일:줄 또는 squid.conf 줄. message: 설명. fix: 권장 조치.
+########
+*/
+class Finding
+{
+public:
+    int severity;
+    std::string category;
+    std::string subject;
+    std::string where;
+    std::string message;
+    std::string fix;
+};
+
+/*
+########
+# ConfigRun -> 클래스: 로그를 squid.conf 하나로 재생한 결과
+# path, rules, findings(--optimize), decisions(Records와 같은 순서),
+# traceAt: 리포트 묶음 키 -> 그 묶음의 평가 과정을 가진 decisions 인덱스,
+# allowed/denied/other/skipped/unsure/differ: 요청 수 집계, implicitHits: 어느 규칙에도 안 걸린 요청 수.
+########
+*/
+class ConfigRun
+{
+public:
+    std::string path;
+    std::vector<RuleInfo> rules;
+    std::vector<Finding> findings;
+    std::vector<Decision> decisions;
+    std::map<std::string, size_t> traceAt;
+    unsigned allowed = 0, denied = 0, other = 0, skipped = 0, unsure = 0, differ = 0;
+    unsigned implicitHits = 0;
+};
+
+/*
+########
+# Records -> std::vector<Record>
+# ReadLog()가 읽은 로그 줄 전부. 두 설정을 같은 순서로 재생하는 기준이다.
+########
+*/
+static std::vector<Record> Records;
+
+/*
+########
+# Runs -> ConfigRun[2]
+# [0]은 현재 squid.conf, [1]은 --sim-compare의 새 squid.conf 결과.
+########
+*/
+static ConfigRun Runs[2];
+
+/*
+########
+# Color -> bool
+# 표준 출력이 터미널이면 true. Paint()가 ANSI 색을 붙일지 정한다.
+########
+*/
+static bool Color = false;
+
+/*
+########
+# Step -> 클래스: 평가된 ACL 트리 노드 하나
+# ACLChecklist::Tracer가 알려 준 (부모 노드, 노드, 결과 1/0). 부모가 Acl::Tree면 규칙 단위, 규칙이면 ACL 단위 결과다.
+########
+*/
+class Step
+{
+public:
+    const Acl::InnerNode *parent;
+    const Acl::Node *node;
+    int result;
+};
+
+/*
+########
+# Steps -> std::vector<Step>
+# 지금 진행 중인 fastCheck() 한 번의 평가 순서. 매 패스 전에 비운다.
+########
+*/
+static std::vector<Step> Steps;
+
+/*
+########
+# Skipped -> std::set<std::string>
+# 오프라인에서 결과가 추측일 수밖에 없는 ACL 이름. 비동기 조회가 필요했거나(goAsync 거절),
+# 로그에 없는 데이터를 보는 타입(NoLogData)이다.
+########
+*/
+static std::set<std::string> Skipped;
+
+/*
+########
+# NoLogData -> std::set<std::string>
+# simulformat 로그에 없는 데이터(헤더, 인증, helper, 연결 상태, 응답 등)를 보는 ACL 타입.
+# 이 타입의 결과는 판정에 영향을 주면 UNSURE로 표시한다.
+########
+*/
+static const std::set<std::string> NoLogData = {
+    "browser", "referer_regex", "req_header", "req_mime_type", "rep_header", "rep_mime_type",
+    "http_status", "hier_code", "peername", "peername_regex", "maxconn", "max_user_ip",
+    "proxy_auth", "proxy_auth_regex", "external", "ext_user", "ext_user_regex",
+    "user_cert", "ca_cert", "ssl_error", "server_cert_fingerprint", "at_step", "note", "tag",
+    "client_connection_mark", "adaptation_service", "arp", "eui64", "random",
+    "annotate_client", "annotate_transaction", "squid_error", "connections_encrypted", "snmp_community"
+};
+
+/*
+########
+# HttpAccessTree -> const Acl::Tree * (규칙이 없으면 nullptr)
+# squid 7은 http_access 목록을 포인터로 감싸 두므로, 파싱된 규칙 트리를 꺼내 준다.
+########
+*/
+static const Acl::Tree *
+HttpAccessTree()
+{
+    return (Config.accessList.http && *Config.accessList.http) ? Config.accessList.http->getRaw() : nullptr;
+}
+
+/*
+########
+# NamedAcl -> Acl::Node * (없으면 nullptr)
+# squid.conf에 정의된 이름의 ACL. squid 7은 ACL을 이름 해시로 보관하므로 Acl::Node::FindByName()으로 찾는다.
+########
+*/
+static Acl::Node *
+NamedAcl(const std::string &name)
+{
+    return Acl::Node::FindByName(SBuf(name.c_str()));
+}
+
+/*
+########
+# Trace -> void (ACLChecklist::Tracer 콜백)
+# matchChild()가 노드를 평가할 때마다 불린다. result -1(비동기 거절)이거나 NoLogData 타입이면 Skipped에 넣고,
+# -1이 아니면 Steps에 (부모, 노드, 결과)를 쌓는다.
+########
+*/
+static void
+Trace(const ACLChecklist *, const Acl::InnerNode *parent, const Acl::Node *child, int result)
+{
+    if (result < 0 || NoLogData.count(child->typeString())) {
+        Skipped.insert(child->name.toStdString());
+        if (result < 0)
+            return;
+    }
+    Steps.push_back(Step{parent, child, result});
+}
+
+/*
+########
+# MonthNumber -> int (0~11, 모르면 -1)
+# "Jan"~"Dec"를 대소문자 구분 없이 월 번호로 바꾼다.
+########
+*/
+static int
+MonthNumber(const char *mon)
+{
+    static const char *names[] = { "Jan", "Feb", "Mar", "Apr", "May", "Jun",
+                                   "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
+                                 };
+    for (int i = 0; i < 12; ++i) {
+        if (strcasecmp(mon, names[i]) == 0)
+            return i;
+    }
+    return -1;
+}
+
+/*
+########
+# ParseTime -> bool (성공하면 r.when, r.tzOffset, r.hasTime 설정)
+# %tl의 두 토큰("31/Oct/2026:09:59:01", "+0900")을 읽어, 현지 시각을 timegm()으로 epoch로 만든 뒤
+# 오프셋을 빼서 UTC epoch를 얻는다. 오프셋은 Evaluate()가 TZ로 되돌려 쓰도록 보관한다.
+########
+*/
+static bool
+ParseTime(const std::string &date, const std::string &zone, Record &r)
+{
+    int day, year, hh, mm, ss;
+    char mon[4];
+    if (sscanf(date.c_str(), "%d/%3[A-Za-z]/%d:%d:%d:%d", &day, mon, &year, &hh, &mm, &ss) != 6)
+        return false;
+    const int month = MonthNumber(mon);
+    if (month < 0 || zone.size() != 5 || (zone[0] != '+' && zone[0] != '-'))
+        return false;
+
+    struct tm tm;
+    memset(&tm, 0, sizeof(tm));
+    tm.tm_mday = day;
+    tm.tm_mon = month;
+    tm.tm_year = year - 1900;
+    tm.tm_hour = hh;
+    tm.tm_min = mm;
+    tm.tm_sec = ss;
+
+    const int zh = atoi(zone.substr(1, 2).c_str());
+    const int zm = atoi(zone.substr(3, 2).c_str());
+    r.tzOffset = (zone[0] == '-' ? -1 : 1) * (zh * 3600 + zm * 60);
+    r.when = timegm(&tm) - r.tzOffset;
+    r.hasTime = true;
+    return true;
+}
+
+/*
+########
+# ParseLine -> bool (성공하면 Record 필드 설정)
+# simulformat 한 줄을 위치로 읽는다. 첫 따옴표 앞: 날짜, 오프셋, %la, %>a. 따옴표 안: 메서드, URL, 마지막이 HTTP/x.y면 버전.
+# 마지막 따옴표 뒤: 상태, 크기, %Ss:%Sh에서 %Ss만. 따옴표가 없거나 클라이언트·메서드·URL이 없으면 false(SKIP).
+########
+*/
+static bool
+ParseLine(const std::string &line, Record &r)
+{
+    const auto q1 = line.find('"');
+    const auto q2 = line.rfind('"');
+    if (q1 == std::string::npos || q2 == q1)
+        return false;
+
+    std::istringstream head(line.substr(0, q1));
+    std::string date, zone;
+    head >> date >> zone >> r.localIp >> r.clientIp;
+    if (r.clientIp.empty())
+        return false;
+    (void)ParseTime(date, zone, r);
+
+    std::istringstream req(line.substr(q1 + 1, q2 - q1 - 1));
+    std::vector<std::string> words;
+    for (std::string w; req >> w;)
+        words.push_back(w);
+    if (words.size() < 2)
+        return false;
+    if (words.size() >= 3 && words.back().compare(0, 5, "HTTP/") == 0) {
+        r.version = words.back().substr(5);
+        words.pop_back();
+    }
+    r.method = words[0];
+    r.url = words[1];
+    for (size_t i = 2; i < words.size(); ++i)
+        r.url += " " + words[i];
+
+    std::istringstream tail(line.substr(q2 + 1));
+    std::string size, tags;
+    tail >> r.status >> size >> tags;
+    r.squidStatus = tags.substr(0, tags.find(':'));
+    return true;
+}
+
+/*
+########
+# UseLogTimezone -> void
+# TZ 환경 변수를 로그의 오프셋으로 바꿔 localtime()과 acl time이 프록시 현지 시각으로 동작하게 한다.
+# POSIX TZ는 서쪽이 양수라 부호를 뒤집어 "SIM-09:00"처럼 쓰고, 같은 오프셋이면 다시 설정하지 않는다.
+########
+*/
+static void
+UseLogTimezone(const int offset)
+{
+    static int current = INT_MIN;
+    if (offset == current)
+        return;
+    current = offset;
+    const int a = offset < 0 ? -offset : offset;
+    char tz[32];
+    snprintf(tz, sizeof(tz), "SIM%c%02d:%02d", offset > 0 ? '-' : '+', a / 3600, (a % 3600) / 60);
+    setenv("TZ", tz, 1);
+    tzset();
+}
+
+/*
+########
+# LoggedVerdict -> const char * ("DENY", "ALLOW", 또는 "")
+# 로그의 %Ss가 실제로 무엇이었는지. TCP_DENIED*(TCP_DENIED_REPLY 제외)는 DENY,
+# 비었거나 -, NONE*, TAG_NONE*은 판단할 수 없어 "", 나머지는 ALLOW.
+########
+*/
+static const char *
+LoggedVerdict(const Record &r)
+{
+    const std::string &s = r.squidStatus;
+    if (s.compare(0, 10, "TCP_DENIED") == 0 && s != "TCP_DENIED_REPLY")
+        return "DENY";
+    if (s.empty() || s == "-" || s.compare(0, 4, "NONE") == 0 || s.compare(0, 8, "TAG_NONE") == 0)
+        return "";
+    return "ALLOW";
+}
+
+/*
+########
+# VerdictName -> const char * (ALLOW, DENY, AUTH, DUNNO)
+# fastCheck() 응답을 출력용 이름으로 바꾼다.
+########
+*/
+static const char *
+VerdictName(const Acl::Answer &answer)
+{
+    if (answer.allowed())
+        return "ALLOW";
+    if (answer.denied())
+        return "DENY";
+    if (answer == ACCESS_AUTH_REQUIRED)
+        return "AUTH";
+    return "DUNNO";
+}
+
+/*
+########
+# RulePosition -> int (0부터, 이름이 아니면 -1)
+# "http_access#N"에서 N-1을 얻는다. SkipRulesThrough와 rules 배열 인덱스로 쓴다.
+########
+*/
+static int
+RulePosition(const std::string &name)
+{
+    const auto hash = name.rfind('#');
+    return hash == std::string::npos ? -1 : atoi(name.c_str() + hash + 1) - 1;
+}
+
+/*
+########
+# Short -> std::string ("#N")
+# "http_access#5"처럼 긴 규칙 이름을 "#5"로 줄인다. #이 없으면 그대로.
+########
+*/
+static std::string
+Short(const std::string &name)
+{
+    const auto hash = name.rfind('#');
+    return hash == std::string::npos ? name : name.substr(hash);
+}
+
+/*
+########
+# Upper -> std::string
+# ASCII 대문자로 바꾼 사본.
+########
+*/
+static std::string
+Upper(std::string s)
+{
+    for (auto &c : s)
+        c = toupper(static_cast<unsigned char>(c));
+    return s;
+}
+
+/*
+########
+# Lower -> std::string
+# ASCII 소문자로 바꾼 사본. ACL 이름은 대소문자를 구분하지 않으므로 비교 키로 쓴다.
+########
+*/
+static std::string
+Lower(std::string s)
+{
+    for (auto &c : s)
+        c = tolower(static_cast<unsigned char>(c));
+    return s;
+}
+
+/*
+########
+# ConfLine -> std::string
+# squid.conf 줄에서 공백이나 탭 뒤의 "# 주석"과 끝 공백을 지운다. ACL·규칙 줄을 보여 줄 때 쓴다.
+########
+*/
+static std::string
+ConfLine(const char *cfgline)
+{
+    std::string line = cfgline ? cfgline : "";
+    const auto hash = line.find(" #");
+    if (hash != std::string::npos)
+        line.erase(hash);
+    const auto tab = line.find("\t#");
+    if (tab != std::string::npos)
+        line.erase(tab);
+    while (!line.empty() && (line.back() == ' ' || line.back() == '\t'))
+        line.pop_back();
+    return line;
+}
+
+/*
+########
+# Paint -> std::string
+# Color가 켜져 있으면 ANSI 색 코드로 감싸고, 아니면 그대로 돌려준다.
+########
+*/
+static std::string
+Paint(const std::string &s, const char *code)
+{
+    return Color ? "\033[" + std::string(code) + "m" + s + "\033[0m" : s;
+}
+
+/*
+########
+# VerdictColor -> const char * (ANSI 색 코드)
+# ALLOW 초록, DENY 빨강, 나머지 노랑.
+########
+*/
+static const char *
+VerdictColor(const std::string &verdict)
+{
+    if (verdict == "ALLOW")
+        return "1;32";
+    if (verdict == "DENY")
+        return "1;31";
+    return "1;33";
+}
+
+/*
+########
+# Pad -> std::string
+# width보다 짧으면 오른쪽을 공백으로 채운다.
+########
+*/
+static std::string
+Pad(std::string s, const size_t width)
+{
+    if (s.size() < width)
+        s.append(width - s.size(), ' ');
+    return s;
+}
+
+/*
+########
+# ImplicitVerdict -> std::string (ALLOW, DENY, 또는 DUNNO)
+# 어떤 규칙도 매칭되지 않을 때의 판정 = 마지막 규칙 동작의 반대. without에 준 규칙은 지워진 것으로 보고
+# 그 앞 규칙을 마지막으로 친다. 규칙이 없으면 DUNNO.
+########
+*/
+static std::string
+ImplicitVerdict(const ConfigRun &run, const std::string &without = std::string())
+{
+    for (auto rule = run.rules.rbegin(); rule != run.rules.rend(); ++rule) {
+        if (rule->name != without)
+            return rule->action == "allow" ? "DENY" : "ALLOW";
+    }
+    return "DUNNO";
+}
+
+/*
+########
+# WithoutDecisive -> std::string ("DENY by http_access#9" 형식)
+# 판정 규칙이 없었다면의 결과. AUTH/DUNNO처럼 검사가 멈췄으면 그 뒤는 평가하지 않았으므로 알 수 없다고 답한다.
+# 두 번째로 매칭된 규칙이 있으면 그 규칙(예외 응답이면 AUTH 등), 없으면 그 규칙을 뺀 기본 판정.
+########
+*/
+static std::string
+WithoutDecisive(const Decision &d, const ConfigRun &run)
+{
+    if (d.verdict != "ALLOW" && d.verdict != "DENY")
+        return "not known (the check stopped with " + d.verdict + ")";
+    if (d.matches.size() >= 2)
+        return Upper(d.matches[1].action) + " by " + d.matches[1].name;
+    return ImplicitVerdict(run, d.rule) + " by implicit rule";
+}
+
+/*
+########
+# MatchChain -> std::string ("#5 deny > #9 allow" 형식, 없으면 none)
+# 요청에 매칭되는 규칙 전부를 평가 순서대로 잇는다.
+########
+*/
+static std::string
+MatchChain(const Decision &d)
+{
+    if (d.matches.empty())
+        return "none";
+    std::string chain;
+    for (const auto &m : d.matches) {
+        if (!chain.empty())
+            chain += " > ";
+        chain += Short(m.name) + " " + m.action;
+    }
+    return chain;
+}
+
+/*
+########
+# FirstMatching -> std::string (규칙 이름 또는 "")
+# 매칭 목록에서 action이 주어진 동작인 첫 규칙. 차단된 요청을 허용했을 규칙을 찾을 때 쓴다.
+########
+*/
+static std::string
+FirstMatching(const Decision &d, const char *action)
+{
+    for (const auto &m : d.matches) {
+        if (m.action == action)
+            return m.name;
+    }
+    return "";
+}
+
+/*
+########
+# WasSkipped -> bool
+# 노드가 Skipped에 있는지. "!이름" 노드는 부정하기 전의 ACL 이름으로도 확인한다.
+########
+*/
+static bool
+WasSkipped(const Acl::Node *node)
+{
+    const std::string name = node->name.toStdString();
+    return Skipped.count(name) || (!name.empty() && name[0] == '!' && Skipped.count(name.substr(1)));
+}
+
+/*
+########
+# HostOf -> std::string ("호스트:포트", URL을 못 읽었으면 URL)
+# 판정에 기록된 목적지. 리포트의 묶음 키와 표에 쓴다.
+########
+*/
+static std::string
+HostOf(const Record &r, const Decision &d)
+{
+    return d.host.empty() ? r.url : d.host;
+}
+
+/*
+########
+# RuleText -> std::string (규칙 줄 전체)
+# 규칙 노드의 줄을 treeDump() 결과(run.rules)에서 가져온다. cfgline은 이어 쓴 줄의 마지막 물리 줄만 담기 때문이다.
+# 위치를 알 수 없으면 cfgline을 쓴다.
+########
+*/
+static std::string
+RuleText(const ConfigRun &run, const Acl::Node *rule)
+{
+    const int pos = RulePosition(rule->name.toStdString());
+    if (pos >= 0 && size_t(pos) < run.rules.size())
+        return run.rules[pos].text;
+    return ConfLine(rule->cfgline);
+}
+
+/*
+########
+# FormatTrace -> std::string (규칙별 평가 과정 여러 줄)
+# 직전 fastCheck()의 Steps를 규칙 단위로 묶는다. 트리 직속 Step이 나올 때까지 모은 하위 Step 중
+# 그 규칙의 직속 자식만 "이름=yes/no/?"로 붙인다(?: 오프라인에서 확정 불가). any-of/all-of 내부는 생략한다.
+# 규칙 줄은 RuleText()로 전체를 보여 준다.
+########
+*/
+static std::string
+FormatTrace(const Acl::Tree *tree, const ConfigRun &run)
+{
+    std::ostringstream out;
+    std::vector<const Step *> leaves;
+    for (const auto &step : Steps) {
+        if (step.parent != tree) {
+            leaves.push_back(&step);
+            continue;
+        }
+        out << "             " << Pad(Short(step.node->name.toStdString()), 5) <<
+            (step.result ? " MATCH " : " no    ");
+        for (const auto *leaf : leaves) {
+            if (leaf->parent != step.node)
+                continue;
+            out << " " << leaf->node->name << "=" <<
+                (WasSkipped(leaf->node) ? "?" : (leaf->result ? "yes" : "no"));
+        }
+        out << "   [" << RuleText(run, step.node) << "]\n";
+        leaves.clear();
+    }
+    return out.str();
+}
+
+/*
+########
+# CollectRules -> std::vector<RuleInfo>
+# 파싱된 http_access 트리를 treeDump()로 덤프해 줄바꿈 토큰마다 규칙 하나를 만든다.
+# 두 번째 토큰이 동작, 그 뒤가 ACL 이름이며, 이름은 등장 순서대로 http_access#N.
+########
+*/
+static std::vector<RuleInfo>
+CollectRules(const Acl::Tree *tree)
+{
+    std::vector<RuleInfo> result;
+    const SBufList dump = tree->treeDump("http_access", [](const Acl::Answer &a) {
+        return a.allowed() ? "allow" : "deny";
+    });
+    static const SBuf NewLine("\n");
+    RuleInfo rule;
+    size_t tokens = 0;
+    for (const auto &token : dump) {
+        if (!(token == NewLine)) {
+            if (++tokens == 2)
+                rule.action = token.toStdString();
+            else if (tokens > 2)
+                rule.acls.push_back(token.toStdString());
+            if (!rule.text.empty())
+                rule.text += " ";
+            rule.text += token.toStdString();
+            continue;
+        }
+        rule.name = "http_access#" + std::to_string(result.size() + 1);
+        result.push_back(rule);
+        rule = RuleInfo();
+        tokens = 0;
+    }
+    return result;
+}
+
+/*
+########
+# CountDecision -> void (run의 집계 갱신)
+# 판정 종류별 수, UNSURE·DIFF 수, implicit 수를 센다. 판정 규칙의 decided를 올리고(AUTH로 끝난 경우처럼
+# matches에 없어도), 판정 규칙이 아닌 나머지 매칭 규칙의 shadowed를 올린다.
+########
+*/
+static void
+CountDecision(ConfigRun &run, const Decision &d)
+{
+    if (d.verdict == "ALLOW")
+        ++run.allowed;
+    else if (d.verdict == "DENY")
+        ++run.denied;
+    else if (d.verdict == "SKIP")
+        ++run.skipped;
+    else
+        ++run.other;
+    if (!d.unsure.empty())
+        ++run.unsure;
+    if (d.vsLog == "DIFF")
+        ++run.differ;
+
+    const int decisive = d.rule == "implicit" ? -1 : RulePosition(d.rule);
+    if (d.rule == "implicit")
+        ++run.implicitHits;
+    else if (decisive >= 0 && size_t(decisive) < run.rules.size())
+        ++run.rules[decisive].decided;
+    for (size_t i = 0; i < d.matches.size(); ++i) {
+        const int pos = RulePosition(d.matches[i].name);
+        if (pos < 0 || size_t(pos) >= run.rules.size() || (i == 0 && pos == decisive))
+            continue;
+        ++run.rules[pos].shadowed;
+    }
+}
+
+/*
+########
+# Evaluate -> Decision
+# 로그 한 줄을 현재 http_access로 판정한다.
+# 1. URL과 메서드로 HttpRequest를 만들고 %>a, %la, --sim-port, 그 포트의 myportname, HTTP 버전을 넣는다.
+# AccessLogEntry를 붙이고, 로그 시각이 있으면 그 오프셋으로 TZ를 맞춘다. 목적지 "호스트:포트"를 판정에 기록한다.
+# 2. 패스 0은 실제 판정이다. 패스 k는 SkipRulesThrough를 직전 승자의 위치로 두고 다시 fastCheck()해서
+# 다음으로 매칭되는 규칙을 찾는다. 매칭이 없으면 멈춘다. AUTH·DUNNO로 끝나면 그 규칙을 예외 응답과 함께
+# 사슬에 넣고 멈춘다(Squid도 거기서 검사를 끝낸다).
+# debugs()가 시계를 현재로 되돌리므로 매 패스 직전에 squid_curtime 등을 로그 시각으로 다시 넣는다.
+# 3. 패스 0의 Skipped가 UNSURE가 된다. AUTH/DUNNO면 그 판정을 낸 ACL을, 로그 시각이 없으면 평가된 time ACL을 더한다.
+# 4. 판정 규칙(또는 implicit)을 정하고, 현재 설정이면 로그의 %Ss와 비교한다.
+# 5. 평가 과정은 --sim-trace면 전부, 리포트면 (클라이언트, 메서드, 목적지, 판정, 규칙) 묶음마다 하나만 보관한다.
+########
+*/
+static Decision
+Evaluate(Record &r, ConfigRun &run, const bool current, const int localPort)
+{
+    Decision d;
+    if (!r.parsed) {
+        d.ruleText = "unparsable log line";
+        return d;
+    }
+
+    const Acl::Tree *tree = HttpAccessTree();
+
+    AnyP::PortCfgPointer listener = HttpPortList;
+    for (AnyP::PortCfgPointer p = HttpPortList; p != nullptr; p = p->next) {
+        if (p->s.port() == localPort) {
+            listener = p;
+            break;
+        }
+    }
+
+    HttpRequestMethod method;
+    method.HttpRequestMethodXXX(r.method.c_str());
+    const auto mx = MasterXaction::MakePortful(listener);
+    HttpRequest::Pointer request(HttpRequest::FromUrl(SBuf(r.url.c_str()), mx, method));
+    if (!request) {
+        d.ruleText = "unparsable URL";
+        return d;
+    }
+    d.host = std::string(request->url.host()) + ":" + std::to_string(request->url.port().value_or(0));
+
+    unsigned vMajor = 1, vMinor = 1;
+    if (sscanf(r.version.c_str(), "%u.%u", &vMajor, &vMinor) == 2)
+        request->http_ver = Http::ProtocolVersion(vMajor, vMinor);
+
+    if (!(request->client_addr = r.clientIp.c_str()))
+        request->client_addr.setNoAddr();
+#if FOLLOW_X_FORWARDED_FOR
+    request->indirect_client_addr = request->client_addr;
+#endif
+    if (!(request->my_addr = r.localIp.c_str()))
+        request->my_addr.setAnyAddr();
+    request->my_addr.port(localPort);
+    if (listener != nullptr && listener->name)
+        request->myportname = listener->name;
+    if (DnsMode == 2)
+        request->flags.destinationIpLookedUp = true;
+
+    AccessLogEntry::Pointer al = new AccessLogEntry;
+    al->request = request.getRaw();
+    HTTPMSGLOCK(al->request);
+    al->adapted_request = request.getRaw();
+    HTTPMSGLOCK(al->adapted_request);
+    al->url = SBuf(r.url.c_str());
+    al->cache.caddr = request->client_addr;
+
+    if (r.hasTime)
+        UseLogTimezone(r.tzOffset);
+
+    Skipped.clear();
+    Acl::Answer firstAnswer;
+    const Acl::Node *lastEvaluated = nullptr;
+    bool firstPassMatched = false;
+    std::string trace;
+    std::set<std::string> unsure;
+    ACLChecklist::SkipRulesThrough = -1;
+    for (size_t pass = 0; pass <= run.rules.size(); ++pass) {
+        Steps.clear();
+        ACLFilledChecklist checklist(Config.accessList.http, request.getRaw());
+        checklist.al = al;
+        if (DnsMode == 2) {
+            checklist.markDestinationDomainChecked();
+            checklist.markSourceDomainChecked();
+        }
+        if (r.hasTime) {
+            squid_curtime = r.when;
+            current_time.tv_sec = r.when;
+            current_time.tv_usec = 0;
+            current_dtime = r.when;
+        }
+        const Acl::Answer answer = checklist.fastCheck();
+
+        const Acl::Node *winner = nullptr;
+        const Acl::Node *lastRule = nullptr;
+        for (const auto &step : Steps) {
+            if (step.parent != tree)
+                continue;
+            lastRule = step.node;
+            if (step.result)
+                winner = step.node;
+        }
+        const bool exceptional = !answer.allowed() && !answer.denied();
+        if (pass == 0) {
+            lastEvaluated = lastRule;
+            firstAnswer = answer;
+            firstPassMatched = winner;
+            trace = FormatTrace(tree, run);
+            unsure = Skipped;
+            if (!r.hasTime) {
+                for (const auto &step : Steps) {
+                    if (strcmp(step.node->typeString(), "time") == 0)
+                        unsure.insert(step.node->name.toStdString());
+                }
+            }
+            if (exceptional) {
+                const Acl::Node *culprit = lastEvaluated;
+                for (const auto &step : Steps) {
+                    if (lastEvaluated && step.parent == lastEvaluated)
+                        culprit = step.node;
+                }
+                unsure.insert(culprit ? culprit->name.toStdString() : std::string("?"));
+            }
+        }
+        if (!winner && exceptional && lastRule)
+            winner = lastRule;
+        if (!winner)
+            break;
+
+        RuleMatch m;
+        m.name = winner->name.toStdString();
+        m.action = exceptional ? Lower(VerdictName(answer)) : (answer.allowed() ? "allow" : "deny");
+        m.text = RuleText(run, winner);
+        d.matches.push_back(m);
+        if (exceptional)
+            break;
+
+        ACLChecklist::SkipRulesThrough = RulePosition(m.name);
+        if (ACLChecklist::SkipRulesThrough < 0)
+            break;
+    }
+    ACLChecklist::SkipRulesThrough = -1;
+
+    d.verdict = VerdictName(firstAnswer);
+    if (firstPassMatched || (!firstAnswer.allowed() && !firstAnswer.denied() && !d.matches.empty())) {
+        d.rule = d.matches[0].name;
+        d.ruleText = d.matches[0].text;
+    } else {
+        d.rule = "implicit";
+        d.ruleText = "(no rule matched: opposite of the last rule's action)";
+    }
+
+    for (const auto &name : unsure)
+        d.unsure += (d.unsure.empty() ? "" : " ") + name;
+
+    if (current) {
+        const char *logged = LoggedVerdict(r);
+        if (!d.unsure.empty())
+            d.vsLog = "UNSURE";
+        else if (*logged)
+            d.vsLog = d.verdict == logged ? "same" : "DIFF";
+    }
+
+    const std::string key = r.clientIp + "\x1f" + r.method + "\x1f" + d.host + "\x1f" + d.verdict + "\x1f" + d.rule;
+    const bool firstOfGroup = run.traceAt.find(key) == run.traceAt.end();
+    if (ShowTrace || (ReportFile && firstOfGroup))
+        d.trace = trace;
+    if (ReportFile && firstOfGroup)
+        run.traceAt[key] = run.decisions.size();
+    return d;
+}
+
+/*
+########
+# AddFinding -> void (run.findings에 추가)
+# Finding을 만들어 넣는다. 파서가 같은 문제를 두 번 알릴 수 있으므로(splay 트리 재비교 등)
+# 항목·대상·위치·설명이 모두 같은 것이 이미 있으면 넣지 않는다.
+########
+*/
+static void
+AddFinding(ConfigRun &run, const int severity, const char *category, const std::string &subject,
+           const std::string &where, const std::string &message, const std::string &fix)
+{
+    Finding f;
+    f.severity = severity;
+    f.category = category;
+    f.subject = subject;
+    f.where = where;
+    f.message = message;
+    f.fix = fix;
+    for (const auto &old : run.findings) {
+        if (old.category == f.category && old.subject == f.subject && old.where == f.where && old.message == f.message)
+            return;
+    }
+    run.findings.push_back(f);
+}
+
+/*
+########
+# UniversalAcls -> std::set<std::string> (ACL 이름)
+# 모든 요청에 매칭되는 ACL: all, 모든 값에 매칭되는 url_regex(.*, ., ^), 값에 all, 0.0.0.0/0, ::/0이 있는 src.
+# urlpath_regex는 경로가 없는 요청(CONNECT)에 매칭되지 않고, dst all은 DNS 응답이 있어야 매칭되므로 넣지 않는다.
+# 다른 정규식 타입(browser 등)은 필드가 없으면 불일치하므로 넣지 않는다.
+########
+*/
+static std::set<std::string>
+UniversalAcls()
+{
+    std::set<std::string> names;
+    names.insert("all");
+    for (const auto &note : Acl::ConfigNotes) {
+        if (note.kind == "universal" && note.type == "url_regex")
+            names.insert(note.acl);
+    }
+    static const std::set<std::string> anyAddress = { "all", "0.0.0.0/0", "::/0", "[::]/0" };
+    for (const auto &name : Acl::AclDefinitionOrder) {
+        const auto a = NamedAcl(name);
+        if (!a || strcmp(a->typeString(), "src") != 0)
+            continue;
+        for (const auto &item : a->dump()) {
+            if (anyAddress.count(item.toStdString()))
+                names.insert(name);
+        }
+    }
+    return names;
+}
+
+/*
+########
+# Wide -> typedef std::pair<uint64_t, uint64_t>
+# 128비트 값(상위, 하위). IPv6 주소, IPv4는 ::ffff:a.b.c.d로 매핑한 주소, 포트 번호를 같은 방식으로 담는다.
+########
+*/
+typedef std::pair<uint64_t, uint64_t> Wide;
+
+/*
+########
+# WideRange -> typedef std::pair<Wide, Wide>
+# 양 끝을 포함하는 범위 [first, second].
+########
+*/
+typedef std::pair<Wide, Wide> WideRange;
+
+/*
+########
+# AclValues -> 클래스: 값으로 비교할 수 있는 ACL 하나의 값
+# kind: ACL 타입(비교할 수 없으면 빈 문자열). ranges: 정렬·병합된 주소 또는 포트 범위.
+# domains: dstdomain 값(".example.com"은 example.com과 하위 도메인 전체). words: 메서드, 프로토콜, 포트 이름.
+########
+*/
+class AclValues
+{
+public:
+    std::string kind;
+    std::vector<WideRange> ranges;
+    std::set<std::string> domains;
+    std::set<std::string> words;
+};
+
+/*
+########
+# ParseWideAddress -> bool (out, v4 설정)
+# IPv4 또는 IPv6 주소 문자열(대괄호 허용)을 inet_pton()으로 읽어 128비트 값으로 만든다. IPv4는 ::ffff: 매핑.
+########
+*/
+static bool
+ParseWideAddress(std::string text, Wide &out, bool &v4)
+{
+    if (text.size() > 1 && text[0] == '[' && text[text.size() - 1] == ']')
+        text = text.substr(1, text.size() - 2);
+    unsigned char b[16];
+    memset(b, 0, sizeof(b));
+    struct in_addr a4;
+    struct in6_addr a6;
+    if (inet_pton(AF_INET, text.c_str(), &a4) == 1) {
+        b[10] = b[11] = 0xff;
+        memcpy(b + 12, &a4, 4);
+        v4 = true;
+    } else if (inet_pton(AF_INET6, text.c_str(), &a6) == 1) {
+        memcpy(b, &a6, 16);
+        v4 = false;
+    } else {
+        return false;
+    }
+    out = Wide(0, 0);
+    for (int i = 0; i < 8; ++i)
+        out.first = (out.first << 8) | b[i];
+    for (int i = 8; i < 16; ++i)
+        out.second = (out.second << 8) | b[i];
+    return true;
+}
+
+/*
+########
+# ParseIpValue -> bool (range 설정)
+# squid가 덤프한 IP ACL 값 하나를 범위로 바꾼다: all, 주소, 주소-주소, 그리고 선택적인 /접두어 길이.
+# IPv4 접두어는 매핑 공간에 맞게 96을 더하고, 접두어 밖의 호스트 비트를 시작은 0, 끝은 1로 채운다.
+# 64비트 반쪽마다 따로 계산해 64 이상 시프트를 피한다. 읽을 수 없거나 끝이 시작보다 작으면 false.
+########
+*/
+static bool
+ParseIpValue(const std::string &item, WideRange &range)
+{
+    if (item == "all") {
+        range = WideRange(Wide(0, 0), Wide(~uint64_t(0), ~uint64_t(0)));
+        return true;
+    }
+    std::string text = item;
+    int prefix = -1;
+    const auto slash = text.find('/');
+    if (slash != std::string::npos) {
+        const std::string bits = text.substr(slash + 1);
+        if (bits.empty() || bits.find_first_not_of("0123456789") != std::string::npos)
+            return false;
+        prefix = atoi(bits.c_str());
+        text.resize(slash);
+    }
+    const auto dash = text.find('-');
+    bool v4first = false, v4last = false;
+    if (!ParseWideAddress(text.substr(0, dash), range.first, v4first) ||
+            !ParseWideAddress(dash == std::string::npos ? text : text.substr(dash + 1), range.second, v4last))
+        return false;
+    if (prefix >= 0) {
+        if (v4first)
+            prefix += 96;
+        if (prefix > 128)
+            return false;
+        const auto hostBits = [](const int p, const int from) -> uint64_t {
+            if (p <= from)
+                return ~uint64_t(0);
+            if (p >= from + 64)
+                return 0;
+            return ~uint64_t(0) >> (p - from);
+        };
+        const uint64_t hi = hostBits(prefix, 0), lo = hostBits(prefix, 64);
+        range.first.first &= ~hi;
+        range.first.second &= ~lo;
+        range.second.first |= hi;
+        range.second.second |= lo;
+    }
+    return !(range.second < range.first);
+}
+
+/*
+########
+# ParsePortValue -> bool (range 설정)
+# "80"이나 "1025-65535"를 범위로 바꾼다. 숫자와 '-' 외의 문자가 있으면 false.
+########
+*/
+static bool
+ParsePortValue(const std::string &item, WideRange &range)
+{
+    if (item.empty() || item.find_first_not_of("0123456789-") != std::string::npos)
+        return false;
+    const auto dash = item.find('-');
+    range.first = Wide(0, strtoull(item.c_str(), nullptr, 10));
+    range.second = dash == std::string::npos ? range.first : Wide(0, strtoull(item.c_str() + dash + 1, nullptr, 10));
+    return !(range.second < range.first);
+}
+
+/*
+########
+# WideText -> std::string
+# 128비트 값을 사람이 읽는 형태로: 포트 타입이면 숫자, ::ffff: 매핑이면 IPv4, 나머지는 IPv6 표기.
+########
+*/
+static std::string
+WideText(const Wide &w, const std::string &kind)
+{
+    if (kind == "port" || kind == "localport")
+        return std::to_string(w.second);
+    unsigned char b[16];
+    for (int i = 0; i < 8; ++i) {
+        b[i] = (w.first >> (56 - 8 * i)) & 0xff;
+        b[8 + i] = (w.second >> (56 - 8 * i)) & 0xff;
+    }
+    char buf[INET6_ADDRSTRLEN];
+    if (w.first == 0 && (w.second >> 32) == 0xffff)
+        return inet_ntop(AF_INET, b + 12, buf, sizeof(buf)) ? buf : "?";
+    return inet_ntop(AF_INET6, b, buf, sizeof(buf)) ? buf : "?";
+}
+
+/*
+########
+# RangeText -> std::string
+# 범위를 "a", "a/접두어"(정렬된 블록일 때), 또는 "a-b"로 쓴다.
+########
+*/
+static std::string
+RangeText(const WideRange &r, const std::string &kind)
+{
+    const std::string first = WideText(r.first, kind);
+    if (r.first == r.second)
+        return first;
+    if (kind != "port" && kind != "localport") {
+        const bool v4 = r.first.first == 0 && (r.first.second >> 32) == 0xffff;
+        for (int prefix = v4 ? 96 : 0; prefix < 128; ++prefix) {
+            const uint64_t hi = prefix >= 64 ? 0 : ~uint64_t(0) >> prefix;
+            const uint64_t lo = prefix <= 64 ? ~uint64_t(0) : ~uint64_t(0) >> (prefix - 64);
+            if ((r.first.first & hi) == 0 && (r.first.second & lo) == 0 &&
+                    (r.first.first | hi) == r.second.first && (r.first.second | lo) == r.second.second)
+                return first + "/" + std::to_string(v4 ? prefix - 96 : prefix);
+        }
+    }
+    return first + "-" + WideText(r.second, kind);
+}
+
+/*
+########
+# ValuesOf -> AclValues (비교할 수 없으면 kind가 빈 값)
+# src/dst/localip, port/localport, dstdomain/srcdomain, method/proto/myportname ACL의 dump() 값을 읽는다.
+# 값 하나라도 읽지 못하면 추측하지 않고 비교 대상에서 뺀다. 도메인은 소문자로, method/proto는 대문자로 맞춘다.
+# 범위는 정렬한 뒤 겹치거나 맞닿은 것을 합친다(최댓값에서 +1 넘침은 따로 처리).
+########
+*/
+static AclValues
+ValuesOf(const Acl::Node *acl)
+{
+    static const std::set<std::string> ipTypes = { "src", "dst", "localip" };
+    static const std::set<std::string> portTypes = { "port", "localport" };
+    static const std::set<std::string> domainTypes = { "dstdomain", "srcdomain" };
+    static const std::set<std::string> wordTypes = { "method", "proto", "myportname" };
+    AclValues v;
+    const std::string type = acl->typeString();
+    if (!ipTypes.count(type) && !portTypes.count(type) && !domainTypes.count(type) && !wordTypes.count(type))
+        return v;
+    std::vector<WideRange> ranges;
+    for (const auto &value : acl->dump()) {
+        const std::string item = value.toStdString();
+        WideRange range;
+        if (ipTypes.count(type) || portTypes.count(type)) {
+            if (!(ipTypes.count(type) ? ParseIpValue(item, range) : ParsePortValue(item, range)))
+                return AclValues();
+            ranges.push_back(range);
+        } else if (domainTypes.count(type)) {
+            v.domains.insert(Lower(item));
+        } else {
+            v.words.insert(type == "myportname" ? item : Upper(item));
+        }
+    }
+    std::sort(ranges.begin(), ranges.end());
+    for (const auto &r : ranges) {
+        if (!v.ranges.empty()) {
+            Wide next = v.ranges.back().second;
+            if (++next.second == 0)
+                ++next.first;
+            const bool atEnd = v.ranges.back().second == Wide(~uint64_t(0), ~uint64_t(0));
+            if (atEnd || !(next < r.first)) {
+                if (v.ranges.back().second < r.second)
+                    v.ranges.back().second = r.second;
+                continue;
+            }
+        }
+        v.ranges.push_back(r);
+    }
+    if (!v.ranges.empty() || !v.domains.empty() || !v.words.empty())
+        v.kind = type;
+    return v;
+}
+
+/*
+########
+# DomainCovered -> bool
+# dstdomain 값 narrow가 domains 중 하나에 매칭되는지. 같은 값, "."+narrow,
+# 그리고 narrow의 각 점 위치에서 시작하는 접미사(".example.com")를 집합에서 찾는다. 값 길이만큼만 조회한다.
+########
+*/
+static bool
+DomainCovered(const std::set<std::string> &domains, const std::string &narrow)
+{
+    if (narrow.empty() || domains.count(narrow))
+        return !narrow.empty();
+    if (narrow[0] != '.' && domains.count("." + narrow))
+        return true;
+    for (size_t dot = narrow.find('.', 1); dot != std::string::npos; dot = narrow.find('.', dot + 1)) {
+        if (domains.count(narrow.substr(dot)))
+            return true;
+    }
+    return false;
+}
+
+/*
+########
+# Covers -> bool
+# b에 매칭되는 모든 요청이 a에도 매칭되는지(같은 타입일 때만). b의 범위마다 a의 병합된 범위 하나 안에
+# 들어가는지 이분 탐색하고, 도메인은 DomainCovered(), 단어는 집합 포함으로 본다.
+########
+*/
+static bool
+Covers(const AclValues &a, const AclValues &b)
+{
+    if (a.kind.empty() || a.kind != b.kind)
+        return false;
+    for (const auto &r : b.ranges) {
+        auto it = std::upper_bound(a.ranges.begin(), a.ranges.end(), WideRange(r.first, Wide(~uint64_t(0), ~uint64_t(0))));
+        if (it == a.ranges.begin() || (--it)->second < r.second)
+            return false;
+    }
+    for (const auto &d : b.domains) {
+        if (!DomainCovered(a.domains, d))
+            return false;
+    }
+    for (const auto &w : b.words) {
+        if (!a.words.count(w))
+            return false;
+    }
+    return true;
+}
+
+/*
+########
+# Shared -> std::vector<std::string> (공통 값, 최대 limit개)
+# a와 b 둘 다에 매칭되는 값. 범위는 두 병합 목록을 한 번씩 훑어 교집합을 만들고,
+# 도메인은 한쪽 값이 다른 쪽에 매칭되는 것, 단어는 교집합이다. limit개를 채우면 멈춘다(겹침 여부만 볼 때 1).
+########
+*/
+static std::vector<std::string>
+Shared(const AclValues &a, const AclValues &b, const size_t limit = SIZE_MAX)
+{
+    std::vector<std::string> shared;
+    if (a.kind.empty() || a.kind != b.kind)
+        return shared;
+    auto x = a.ranges.begin(), y = b.ranges.begin();
+    while (x != a.ranges.end() && y != b.ranges.end() && shared.size() < limit) {
+        const Wide first = std::max(x->first, y->first), last = std::min(x->second, y->second);
+        if (!(last < first))
+            shared.push_back(RangeText(WideRange(first, last), a.kind));
+        if (x->second < y->second)
+            ++x;
+        else
+            ++y;
+    }
+    std::set<std::string> seen;
+    for (const auto &d : b.domains) {
+        if (shared.size() >= limit)
+            break;
+        if (DomainCovered(a.domains, d) && seen.insert(d).second)
+            shared.push_back(d);
+    }
+    for (const auto &d : a.domains) {
+        if (shared.size() >= limit)
+            break;
+        if (DomainCovered(b.domains, d) && seen.insert(d).second)
+            shared.push_back(d);
+    }
+    for (const auto &w : a.words) {
+        if (shared.size() >= limit)
+            break;
+        if (b.words.count(w))
+            shared.push_back(w);
+    }
+    return shared;
+}
+
+/*
+########
+# FirstValues -> std::string ("a, b, c, ... (N in all)")
+# 값 목록의 처음 limit개와 전체 개수를 출력용으로 잇는다.
+########
+*/
+static std::string
+FirstValues(const std::vector<std::string> &values, const size_t limit = 3)
+{
+    std::string text;
+    for (size_t i = 0; i < values.size() && i < limit; ++i)
+        text += (i ? ", " : "") + values[i];
+    if (values.size() > limit)
+        text += ", ... (" + std::to_string(values.size()) + " in all)";
+    return text;
+}
+
+/*
+########
+# HasIpLiteral -> bool
+# dstdomain 값 중 IP 주소가 있는지. dstdomain은 URL 호스트가 IP면 역방향 DNS 이름으로도 비교하므로,
+# IP 값이 있으면 공통 값이 없다는 것만으로 두 ACL이 동시에 매칭되지 않는다고 할 수 없다.
+########
+*/
+static bool
+HasIpLiteral(const AclValues &v)
+{
+    for (const auto &d : v.domains) {
+        Wide w;
+        bool v4 = false;
+        if (ParseWideAddress(d, w, v4))
+            return true;
+    }
+    return false;
+}
+
+/*
+########
+# AclValueMap -> typedef std::map<std::string, AclValues>
+# 소문자 ACL 이름 -> 그 ACL의 값.
+########
+*/
+typedef std::map<std::string, AclValues> AclValueMap;
+
+/*
+########
+# Implies -> bool (why에 근거 설정)
+# 규칙 조건 narrow("이름" 또는 "!이름")가 맞으면 wide도 반드시 맞는지.
+# 같은 조건이면 참. B가 A 안에 있으면 B -> A. A가 B 안에 있으면 !B -> !A.
+# A와 B에 공통 값이 없으면 B -> !A. 단, 한 요청이 둘 다에 매칭될 수 있는 경우는 제외한다:
+# dst, srcdomain(DNS 응답이 여럿), IP 값이 있는 dstdomain(IP 호스트는 역방향 이름으로도 비교).
+########
+*/
+static bool
+Implies(const std::string &narrow, const std::string &wide, const AclValueMap &values, std::string &why)
+{
+    why.clear();
+    if (narrow == wide)
+        return true;
+    const bool narrowNot = narrow[0] == '!', wideNot = wide[0] == '!';
+    const std::string n = narrowNot ? narrow.substr(1) : narrow, w = wideNot ? wide.substr(1) : wide;
+    const auto nv = values.find(Lower(n)), wv = values.find(Lower(w));
+    if (nv == values.end() || wv == values.end())
+        return false;
+    if (!narrowNot && !wideNot && Covers(wv->second, nv->second)) {
+        why = "'" + n + "' is inside '" + w + "'";
+        return true;
+    }
+    if (narrowNot && wideNot && Covers(nv->second, wv->second)) {
+        why = "'" + w + "' is inside '" + n + "'";
+        return true;
+    }
+    if (!narrowNot && wideNot && nv->second.kind == wv->second.kind && nv->second.kind != "dst" &&
+            nv->second.kind != "srcdomain" && !HasIpLiteral(nv->second) && !HasIpLiteral(wv->second) &&
+            Shared(nv->second, wv->second, 1).empty()) {
+        why = "'" + n + "' has no value in common with '" + w + "'";
+        return true;
+    }
+    return false;
+}
+
+/*
+########
+# RuleCovers -> bool (why에 근거 목록 설정)
+# later 규칙에 매칭되는 모든 요청이 earlier 규칙에도 매칭되는지. earlier의 조건 하나하나에 대해
+# later 조건 중 그것을 보장하는(Implies) 것이 있어야 한다. earlier에 조건이 없으면 항상 참.
+########
+*/
+static bool
+RuleCovers(const std::set<std::string> &earlier, const std::set<std::string> &later, const AclValueMap &values,
+           std::string &why)
+{
+    why.clear();
+    for (const auto &wide : earlier) {
+        bool found = false;
+        for (const auto &narrow : later) {
+            std::string reason;
+            if (Implies(narrow, wide, values, reason)) {
+                if (!reason.empty())
+                    why += (why.empty() ? "" : "; ") + reason;
+                found = true;
+                break;
+            }
+        }
+        if (!found)
+            return false;
+    }
+    return true;
+}
+
+/*
+########
+# Analyze -> void (run.findings 채움)
+# 1. 파서 노트: 내장 ACL 재정의, 넓은 값에 포함된 값, 중복 값, 모든 값에 매칭되는 정규식(7.7은 병합된 범위도).
+# 2. ACL: 참조되지 않는 ACL, 타입·옵션·값이 같은 ACL. ValuesOf()로 같은 타입끼리 비교해
+# 표기만 다른 동일 ACL, 일부 값을 공유하는 ACL(공유 값 예시), 다른 ACL 안에 들어가는 ACL(INFO,
+# 한 ACL 안에 6개 이상이면 한 줄로 묶음)을 보고한다. 내장 ACL은 비교 대상에서 빼지만 값은 규칙 판단에 쓴다.
+# 3. 규칙: 반복된 ACL, X와 !X 동시 요구, !all, 다른 조건과 함께 쓴 all. all류를 뺀 조건 집합을 만든다.
+# 4. 앞 규칙이 RuleCovers()로 뒤 규칙을 덮으면 같은 동작은 중복, 반대 동작은 도달 불가. 판단에 쓴 ACL 포함 관계를
+# 메시지에 붙인다. 그 규칙이 마지막이라 기본 판정을 정하고 있으면 지우라고 하지 않고 심각도를 낮춘다.
+# urlpath_regex의 '모든 값'은 경로가 있는 요청만이라는 점을 메시지에 덧붙인다.
+# 5. 반대 동작의 앞 규칙의 모든 ACL이 이 규칙의 같은 타입 ACL과 값을 공유하면 일부 가려진 규칙(LOW).
+# 6. 로그를 재생했다면 어떤 요청에도 매칭되지 않은 규칙, 매칭은 됐지만 판정한 적이 없는 규칙.
+# 마지막에 심각도 순으로 안정 정렬한다.
+########
+*/
+static void
+Analyze(ConfigRun &run)
+{
+    for (const auto &note : Acl::ConfigNotes) {
+        if (note.kind == "predefined")
+            AddFinding(run, 2, "built-in ACL redefined", note.acl, note.where + "  " + ConfLine(note.line.c_str()), note.message,
+                       "delete this acl line; Squid already defines '" + note.acl + "'");
+        else if (note.kind == "covered")
+            AddFinding(run, 1, "covered by a wider entry", note.acl, note.where + "  " + ConfLine(note.line.c_str()), note.message,
+                       "delete the narrower entry");
+        else if (note.kind == "duplicate")
+            AddFinding(run, 1, "duplicate entry", note.acl, note.where + "  " + ConfLine(note.line.c_str()), note.message,
+                       "delete the repeated entry");
+        else if (note.kind == "universal")
+            AddFinding(run, 2, "matches everything", note.acl, note.where + "  " + ConfLine(note.line.c_str()),
+                       note.message + (note.type == "urlpath_regex" ? " that has a path (CONNECT requests have none)" : ""),
+                       "use the built-in 'all' ACL or remove the pattern");
+        else if (note.kind == "overlap")
+            AddFinding(run, 1, "overlapping entries", note.acl, note.where + "  " + ConfLine(note.line.c_str()), note.message,
+                       "replace the overlapping entries with the merged one");
+    }
+
+    std::map<std::string, std::vector<std::string> > bySignature;
+    for (const auto &name : Acl::AclDefinitionOrder) {
+        const auto a = NamedAcl(name);
+        if (!a || Acl::PredefinedAcls.count(Lower(name)))
+            continue;
+        if (!Acl::AclReferences.count(Lower(name)))
+            AddFinding(run, 1, "unused ACL", name, ConfLine(a->cfgline),
+                       "defined, but no directive or other ACL uses it", "delete its acl line(s)");
+        std::ostringstream whole;
+        a->dumpWhole("acl", whole);
+        std::string signature = whole.str();
+        const auto nameEnd = signature.find(' ', signature.find(' ') + 1);
+        if (nameEnd != std::string::npos)
+            signature.erase(0, nameEnd + 1);
+        while (!signature.empty() && (signature.back() == '\n' || signature.back() == ' '))
+            signature.pop_back();
+        bySignature[signature].push_back(name);
+    }
+    std::set<std::pair<std::string, std::string> > sameText;
+    for (const auto &entry : bySignature) {
+        if (entry.second.size() < 2)
+            continue;
+        std::string names;
+        for (const auto &name : entry.second)
+            names += (names.empty() ? "" : ", ") + name;
+        for (const auto &x : entry.second) {
+            for (const auto &y : entry.second)
+                sameText.insert(std::make_pair(x, y));
+        }
+        AddFinding(run, 1, "identical ACLs", names, entry.first,
+                   "these ACLs have the same type and values", "keep one of them and use its name everywhere");
+    }
+
+    AclValueMap values;
+    std::vector<std::string> comparable;
+    for (const auto &name : Acl::AclDefinitionOrder) {
+        const auto a = NamedAcl(name);
+        if (!a || values.count(Lower(name)))
+            continue;
+        AclValues v = ValuesOf(a);
+        if (v.kind.empty())
+            continue;
+        values[Lower(name)] = v;
+        if (!Acl::PredefinedAcls.count(Lower(name)))
+            comparable.push_back(name);
+    }
+    std::map<std::string, std::vector<std::string> > inside;
+    std::vector<std::string> insideOrder;
+    for (size_t i = 0; i < comparable.size(); ++i) {
+        for (size_t j = i + 1; j < comparable.size(); ++j) {
+            const std::string &a = comparable[i], &b = comparable[j];
+            const AclValues &va = values[Lower(a)], &vb = values[Lower(b)];
+            if (va.kind != vb.kind || sameText.count(std::make_pair(a, b)))
+                continue;
+            const std::string lineA = ConfLine(NamedAcl(a)->cfgline), lineB = ConfLine(NamedAcl(b)->cfgline);
+            const bool aInB = Covers(vb, va), bInA = Covers(va, vb);
+            const std::string what = "(" + va.kind + ")";
+            if (aInB && bInA) {
+                AddFinding(run, 1, "identical ACLs", a + ", " + b, lineA,
+                           "written differently, but '" + a + "' and '" + b + "' match the same values " + what,
+                           "keep one of them and use its name everywhere");
+            } else if (aInB || bInA) {
+                auto &list = inside[aInB ? b : a];
+                if (list.empty())
+                    insideOrder.push_back(aInB ? b : a);
+                list.push_back(aInB ? a : b);
+            } else {
+                const std::vector<std::string> both = Shared(va, vb);
+                if (!both.empty())
+                    AddFinding(run, 1, "overlapping ACLs", a + ", " + b, lineA,
+                               "'" + a + "' and '" + b + "' both match " + FirstValues(both) + " " + what +
+                               " [" + lineB + "]",
+                               "check that requests matching both are meant to be treated alike");
+            }
+        }
+    }
+    static const char *insideFix = "fine when both are needed; check rules that list both or use them with opposite actions";
+    for (const auto &wide : insideOrder) {
+        const std::vector<std::string> &narrows = inside[wide];
+        const std::string what = "(" + values[Lower(wide)].kind + ")";
+        const std::string wideLine = ConfLine(NamedAcl(wide)->cfgline);
+        if (narrows.size() <= 5) {
+            for (const auto &narrow : narrows)
+                AddFinding(run, 0, "ACL inside another ACL", narrow, ConfLine(NamedAcl(narrow)->cfgline),
+                           "every value of '" + narrow + "' is also in '" + wide + "' " + what + " [" + wideLine + "]",
+                           insideFix);
+            continue;
+        }
+        AddFinding(run, 0, "ACL inside another ACL", FirstValues(narrows), wideLine,
+                   std::to_string(narrows.size()) + " ACLs have only values that are also in '" + wide + "' " + what,
+                   insideFix);
+    }
+
+    const std::set<std::string> universal = UniversalAcls();
+    const size_t count = run.rules.size();
+    std::vector<std::set<std::string> > conditions(count);
+    std::vector<bool> impossible(count, false), reported(count, false);
+    for (size_t j = 0; j < count; ++j) {
+        const RuleInfo &rule = run.rules[j];
+        std::set<std::string> seen;
+        for (const auto &acl : rule.acls) {
+            const bool negated = acl[0] == '!';
+            const std::string base = negated ? acl.substr(1) : acl;
+            if (!seen.insert(acl).second)
+                AddFinding(run, 1, "repeated ACL in rule", rule.name, rule.text,
+                           "'" + acl + "' appears twice", "remove the repetition");
+            if (seen.count(negated ? base : "!" + base)) {
+                impossible[j] = true;
+                AddFinding(run, 3, "rule never matches", rule.name, rule.text,
+                           "it requires both '" + base + "' and '!" + base + "'", "fix or delete the rule");
+            }
+            if (universal.count(base)) {
+                if (negated) {
+                    impossible[j] = true;
+                    AddFinding(run, 3, "rule never matches", rule.name, rule.text,
+                               "'!" + base + "' never matches because '" + base + "' matches everything",
+                               "fix or delete the rule");
+                } else if (rule.acls.size() > 1) {
+                    AddFinding(run, 1, "redundant 'all'", rule.name, rule.text,
+                               "'" + base + "' matches everything, so it adds no condition",
+                               "remove it, unless it is last on purpose to suppress an authentication challenge");
+                }
+                continue;
+            }
+            conditions[j].insert(acl);
+        }
+    }
+
+    bool unconditionalBefore = false;
+    for (size_t j = 0; j < count; ++j) {
+        if (impossible[j])
+            continue;
+        const bool unconditional = conditions[j].empty();
+        const RuleInfo &rule = run.rules[j];
+        for (size_t i = 0; i < j; ++i) {
+            std::string why;
+            if (impossible[i] || !RuleCovers(conditions[i], conditions[j], values, why))
+                continue;
+            if (!why.empty())
+                why = " (" + why + ")";
+            const RuleInfo &earlier = run.rules[i];
+            reported[j] = true;
+            const bool setsDefault = j + 1 == count && !unconditionalBefore &&
+                                     ImplicitVerdict(run, rule.name) != ImplicitVerdict(run);
+            if (earlier.action == rule.action && setsDefault)
+                AddFinding(run, 1, "redundant rule", rule.name, rule.text,
+                           "every request it matches is already matched by " + earlier.name + " [" + earlier.text +
+                           "] with the same action" + why,
+                           "keep it anyway: as the last rule it makes unmatched requests " + ImplicitVerdict(run));
+            else if (earlier.action == rule.action)
+                AddFinding(run, 2, "redundant rule", rule.name, rule.text,
+                           "every request it matches is already matched by " + earlier.name + " [" + earlier.text +
+                           "] with the same action" + why, "delete this rule");
+            else if (setsDefault)
+                AddFinding(run, 2, "unreachable rule", rule.name, rule.text,
+                           "every request it matches is decided first by " + earlier.name + " [" + earlier.text +
+                           "] with the opposite action" + why,
+                           "move it above " + earlier.name + ", or replace it with 'http_access " +
+                           (rule.action == "allow" ? "deny" : "allow") +
+                           " all': as the last rule it still makes unmatched requests " + ImplicitVerdict(run));
+            else
+                AddFinding(run, 3, "unreachable rule", rule.name, rule.text,
+                           "every request it matches is decided first by " + earlier.name + " [" + earlier.text +
+                           "] with the opposite action" + why, "move it above " + earlier.name + " or delete it");
+            break;
+        }
+        unconditionalBefore = unconditionalBefore || unconditional;
+    }
+
+    for (size_t j = 0; j < count; ++j) {
+        if (impossible[j] || reported[j])
+            continue;
+        const RuleInfo &rule = run.rules[j];
+        for (size_t i = 0; i < j; ++i) {
+            const RuleInfo &earlier = run.rules[i];
+            if (impossible[i] || conditions[i].empty() || earlier.action == rule.action)
+                continue;
+            std::string overlap;
+            for (const auto &wide : conditions[i]) {
+                std::string found;
+                for (const auto &narrow : conditions[j]) {
+                    if (wide[0] == '!' || narrow[0] == '!')
+                        continue;
+                    const auto wv = values.find(Lower(wide)), nv = values.find(Lower(narrow));
+                    if (wv == values.end() || nv == values.end())
+                        continue;
+                    const std::vector<std::string> both = Shared(wv->second, nv->second, 2);
+                    if (!both.empty()) {
+                        found = "'" + wide + "' and '" + narrow + "' share " + FirstValues(both, 2);
+                        break;
+                    }
+                }
+                if (found.empty()) {
+                    overlap.clear();
+                    break;
+                }
+                overlap += (overlap.empty() ? "" : "; ") + found;
+            }
+            if (overlap.empty())
+                continue;
+            AddFinding(run, 1, "partly shadowed rule", rule.name, rule.text,
+                       "some requests it matches are decided first by " + earlier.name + " [" + earlier.text +
+                       "] with the opposite action (" + overlap + ")",
+                       "check the order, or narrow one of the ACLs if the overlap is unintended");
+            break;
+        }
+    }
+
+    if (LogFile && !Records.empty()) {
+        for (size_t j = 0; j < count; ++j) {
+            if (impossible[j] || reported[j])
+                continue;
+            const RuleInfo &rule = run.rules[j];
+            if (!rule.decided && !rule.shadowed)
+                AddFinding(run, 1, "no logged request matches", rule.name, rule.text,
+                           "none of the " + std::to_string(Records.size()) + " logged requests match it",
+                           "check whether it is still needed");
+            else if (!rule.decided)
+                AddFinding(run, 2, "never decides in the log", rule.name, rule.text,
+                           "it matches " + std::to_string(rule.shadowed) +
+                           " logged requests, but an earlier rule always decides them first",
+                           "check the rule order or delete it");
+        }
+    }
+
+    std::stable_sort(run.findings.begin(), run.findings.end(), [](const Finding &x, const Finding &y) {
+        return x.severity > y.severity;
+    });
+}
+
+/*
+########
+# SeverityName -> const char * (HIGH, MEDIUM, LOW, INFO)
+# Finding.severity 3, 2, 1, 0을 이름으로 바꾼다.
+########
+*/
+static const char *
+SeverityName(const int severity)
+{
+    return severity >= 3 ? "HIGH" : (severity == 2 ? "MEDIUM" : (severity == 1 ? "LOW" : "INFO"));
+}
+
+/*
+########
+# PrintFindings -> void (표준 출력)
+# --optimize 결과를 심각도(색), 항목, 대상, 설명, 위치, 권장 조치 순으로 출력한다.
+########
+*/
+static void
+PrintFindings(const char *label, const ConfigRun &run)
+{
+    std::cout << "\n# optimize " << label << "squid.conf: " << run.path << " (" << run.findings.size() << " findings)\n";
+    for (const auto &f : run.findings) {
+        const char *color = f.severity >= 3 ? "1;31" : (f.severity == 2 ? "1;33" : (f.severity == 1 ? "36" : "2"));
+        std::cout << "  " << Paint(Pad(SeverityName(f.severity), 6), color) << "  " << Pad(f.category, 27) <<
+                  "  " << f.subject << "\n" <<
+                  "          " << f.message << "\n";
+        if (!f.where.empty())
+            std::cout << "          at:  " << f.where << "\n";
+        std::cout << "          fix: " << f.fix << "\n";
+    }
+}
+
+/*
+########
+# PrintDecision -> void (표준 출력)
+# 요청 한 줄의 결과: 줄 번호, 판정, 판정 규칙, 클라이언트, 메서드, URL, 로그와의 비교.
+# 이어서 판정 규칙 줄, 매칭 규칙 사슬과 판정 규칙이 없었다면의 결과, 확정 불가 ACL, --sim-trace면 평가 과정.
+########
+*/
+static void
+PrintDecision(const Record &r, const Decision &d, const ConfigRun &run)
+{
+    char num[16];
+    snprintf(num, sizeof(num), "%7u", r.lineNo);
+    std::cout << num << "  " << Paint(Pad(d.verdict, 5), VerdictColor(d.verdict)) << "  " <<
+              Pad(d.rule, 16) << "  " << r.clientIp << "  " << r.method << " " << r.url;
+    if (!r.squidStatus.empty()) {
+        std::string vs = d.vsLog;
+        if (vs == "DIFF")
+            vs = Paint(vs, "1;35");
+        std::cout << "  (log " << r.squidStatus << "/" << r.status << ": " << vs << ")";
+    }
+    std::cout << "\n";
+    if (d.verdict == "SKIP") {
+        std::cout << "           " << d.ruleText << "\n";
+        return;
+    }
+    std::cout << "           decided by: " << d.ruleText << "\n";
+    std::cout << "           matching:   " << MatchChain(d);
+    if (d.rule != "implicit")
+        std::cout << "   | without " << Short(d.rule) << ": " << WithoutDecisive(d, run);
+    std::cout << "\n";
+    if (!d.unsure.empty())
+        std::cout << "           " << Paint("not evaluable offline: " + d.unsure, "33") << "\n";
+    if (ShowTrace)
+        std::cout << d.trace;
+}
+
+/*
+########
+# Changed -> bool
+# 두 설정의 결과가 다른지. 규칙이 추가되면 번호가 밀리므로 번호가 아니라 판정과 규칙 줄 텍스트를 비교한다.
+########
+*/
+static bool
+Changed(const Decision &a, const Decision &b)
+{
+    return a.verdict != b.verdict || a.ruleText != b.ruleText;
+}
+
+/*
+########
+# PrintChanges -> void (표준 출력)
+# --sim-compare에서 결과가 바뀐 요청마다 현재/새 판정, 판정 변경인지 규칙만 바뀐 것인지, 양쪽 규칙 줄을 출력한다.
+########
+*/
+static void
+PrintChanges()
+{
+    std::cout << "# requests whose result differs between\n#   current: " << Runs[0].path <<
+              "\n#   new:     " << Runs[1].path << "\n";
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Decision &a = Runs[0].decisions[i];
+        const Decision &b = Runs[1].decisions[i];
+        if (!Changed(a, b))
+            continue;
+        const Record &r = Records[i];
+        char num[16];
+        snprintf(num, sizeof(num), "%7u", r.lineNo);
+        const bool verdictChanged = a.verdict != b.verdict;
+        std::cout << num << "  " << Paint(Pad(a.verdict, 5), VerdictColor(a.verdict)) << " -> " <<
+                  Paint(Pad(b.verdict, 5), VerdictColor(b.verdict)) << "  " <<
+                  (verdictChanged ? Paint("VERDICT", "1;35") : std::string("rule   ")) << "  " <<
+                  r.clientIp << "  " << r.method << " " << r.url << "\n" <<
+                  "           current: " << Pad(Short(a.rule), 9) << a.ruleText << "\n" <<
+                  "           new:     " << Pad(Short(b.rule), 9) << b.ruleText << "\n";
+        if (ShowTrace)
+            std::cout << "           current trace:\n" << a.trace << "           new trace:\n" << b.trace;
+    }
+}
+
+/*
+########
+# PrintRunSummary -> void (표준 출력)
+# 설정 하나의 집계(판정별 수, 확정 불가, 로그와 다름)와 규칙별 decided / also-matched 표, implicit 줄을 출력한다.
+########
+*/
+static void
+PrintRunSummary(const char *label, const ConfigRun &run, const bool current)
+{
+    std::cout << "\n# " << label << " squid.conf: " << run.path << "\n" <<
+              "#   ALLOW " << run.allowed << "  DENY " << run.denied << "  other " << run.other <<
+              "  skipped " << run.skipped << "  not-evaluable-offline " << run.unsure;
+    if (current)
+        std::cout << "  differs-from-log " << run.differ;
+    std::cout << "\n#   decided  also-matched  rule\n";
+    for (const auto &rule : run.rules) {
+        char counts[64];
+        snprintf(counts, sizeof(counts), "%9u  %12u  ", rule.decided, rule.shadowed);
+        std::cout << "# " << counts << Pad(Short(rule.name), 5) << " " << rule.text <<
+                  (rule.decided ? "" : "   <- never decides") << "\n";
+    }
+    char counts[64];
+    snprintf(counts, sizeof(counts), "%9u  %12s  ", run.implicitHits, "-");
+    std::cout << "# " << counts << "implicit " << ImplicitVerdict(run) << "\n";
+}
+
+/*
+########
+# PrintCompareSummary -> void (표준 출력)
+# 판정 변경 수, 규칙만 바뀐 수, 그리고 "현재 판정 규칙 -> 새 판정 규칙" 전환을 많은 순으로 출력한다.
+########
+*/
+static void
+PrintCompareSummary()
+{
+    std::map<std::string, unsigned> transitions;
+    unsigned verdictChanges = 0, ruleChanges = 0;
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Decision &a = Runs[0].decisions[i];
+        const Decision &b = Runs[1].decisions[i];
+        if (!Changed(a, b))
+            continue;
+        if (a.verdict != b.verdict)
+            ++verdictChanges;
+        else
+            ++ruleChanges;
+        ++transitions[a.verdict + " " + Short(a.rule) + " -> " + b.verdict + " " + Short(b.rule)];
+    }
+    std::vector<std::pair<std::string, unsigned> > sorted(transitions.begin(), transitions.end());
+    std::sort(sorted.begin(), sorted.end(), [](const std::pair<std::string, unsigned> &x, const std::pair<std::string, unsigned> &y) {
+        return x.second > y.second;
+    });
+    std::cout << "\n# changes: " << verdictChanges << " verdict changes, " << ruleChanges <<
+              " deciding-rule changes (same verdict)\n";
+    for (const auto &t : sorted)
+        std::cout << "# " << Pad(std::to_string(t.second), 9) << " " << t.first << "\n";
+}
+
+/*
+########
+# Esc -> std::string
+# HTML에 넣을 문자열의 &, <, >, " 를 엔티티로 바꾼다.
+########
+*/
+static std::string
+Esc(const std::string &s)
+{
+    std::string out;
+    out.reserve(s.size());
+    for (const char c : s) {
+        switch (c) {
+        case '&':
+            out += "&amp;";
+            break;
+        case '<':
+            out += "&lt;";
+            break;
+        case '>':
+            out += "&gt;";
+            break;
+        case '"':
+            out += "&quot;";
+            break;
+        default:
+            out += c;
+        }
+    }
+    return out;
+}
+
+/*
+########
+# Pill -> std::string (HTML span)
+# 판정이나 심각도를 색 배지로 만든다. 클래스 이름은 소문자 값이다.
+########
+*/
+static std::string
+Pill(const std::string &verdict)
+{
+    return "<span class=\"pill " + Lower(verdict) + "\">" + Esc(verdict) + "</span>";
+}
+
+/*
+########
+# Counts -> typedef std::vector<std::pair<std::string, unsigned> >
+# (항목, 개수) 목록. Top()의 결과 형식이다.
+########
+*/
+typedef std::vector<std::pair<std::string, unsigned> > Counts;
+
+/*
+########
+# Top -> Counts
+# 개수 많은 순(같으면 이름 순)으로 정렬해 limit개만 남긴다.
+########
+*/
+static Counts
+Top(const std::map<std::string, unsigned> &counts, const size_t limit)
+{
+    Counts result(counts.begin(), counts.end());
+    std::sort(result.begin(), result.end(), [](const std::pair<std::string, unsigned> &x, const std::pair<std::string, unsigned> &y) {
+        return x.second > y.second || (x.second == y.second && x.first < y.first);
+    });
+    if (result.size() > limit)
+        result.resize(limit);
+    return result;
+}
+
+/*
+########
+# ReportCard -> void (HTML 출력)
+# 요약 카드 하나(라벨, 값, 색 클래스)를 쓴다.
+########
+*/
+static void
+ReportCard(std::ostream &out, const char *label, const unsigned value, const char *cls)
+{
+    out << "<div class=\"card " << cls << "\"><div class=\"label\">" << label <<
+        "</div><div class=\"value\">" << value << "</div></div>";
+}
+
+/*
+########
+# ReportRules -> void (HTML 출력)
+# 규칙 표: 번호, 동작, 규칙 줄, decided와 막대, also matched. 비교 모드면 다른 설정에 없는 규칙에 "only here",
+# 판정한 적 없는 규칙에 "never decides"를 붙이고, 마지막에 implicit 줄을 넣는다.
+########
+*/
+static void
+ReportRules(std::ostream &out, const ConfigRun &run, const std::set<std::string> &otherTexts, const bool compare)
+{
+    unsigned most = 1;
+    for (const auto &rule : run.rules)
+        most = std::max(most, rule.decided);
+    most = std::max(most, run.implicitHits);
+
+    out << "<table class=\"rules\"><thead><tr><th>#</th><th>action</th><th>rule</th>"
+        "<th class=\"num\">decided</th><th class=\"barcol\"></th><th class=\"num\">also matched</th></tr></thead><tbody>";
+    for (const auto &rule : run.rules) {
+        const bool unique = compare && !otherTexts.count(rule.text);
+        out << "<tr" << (rule.decided ? "" : " class=\"unused\"") << "><td>" << Esc(Short(rule.name)) <<
+            "</td><td>" << Pill(rule.action == "allow" ? "ALLOW" : "DENY") << "</td><td class=\"mono\">" <<
+            Esc(rule.text) << (unique ? " <span class=\"tag\">only here</span>" : "") <<
+            (rule.decided ? "" : " <span class=\"tag muted\">never decides</span>") <<
+            "</td><td class=\"num\">" << rule.decided << "</td><td class=\"barcol\"><div class=\"bar " << rule.action <<
+            "\"><span style=\"width:" << (100.0 * rule.decided / most) << "%\"></span></div></td><td class=\"num\">" <<
+            rule.shadowed << "</td></tr>";
+    }
+    out << "<tr><td>-</td><td>" << Pill(ImplicitVerdict(run)) << "</td><td class=\"mono\">implicit (no rule matched)</td>"
+        "<td class=\"num\">" << run.implicitHits << "</td><td class=\"barcol\"><div class=\"bar\"><span style=\"width:" <<
+        (100.0 * run.implicitHits / most) << "%\"></span></div></td><td class=\"num\">-</td></tr></tbody></table>";
+}
+
+/*
+########
+# ReportDenials -> void (HTML 출력)
+# 요청을 차단한 규칙마다(많은 순) 상위 목적지, 상위 클라이언트, 그 요청을 허용했을 다음 allow 규칙을 보여 준다.
+########
+*/
+static void
+ReportDenials(std::ostream &out, const ConfigRun &run)
+{
+    class DenyInfo
+    {
+    public:
+        unsigned count = 0;
+        std::string text;
+        std::map<std::string, unsigned> hosts, clients, alternatives;
+    };
+    std::map<std::string, DenyInfo> byRule;
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Decision &d = run.decisions[i];
+        if (d.verdict != "DENY")
+            continue;
+        DenyInfo &info = byRule[d.rule];
+        ++info.count;
+        info.text = d.ruleText;
+        ++info.hosts[HostOf(Records[i], d)];
+        ++info.clients[Records[i].clientIp];
+        const std::string allow = FirstMatching(d, "allow");
+        ++info.alternatives[allow.empty() ? "no allow rule matches" : "allowed by " + allow];
+    }
+    if (byRule.empty()) {
+        out << "<p class=\"muted\">No request is denied.</p>";
+        return;
+    }
+
+    std::vector<std::pair<std::string, const DenyInfo *> > sorted;
+    for (const auto &entry : byRule)
+        sorted.push_back(std::make_pair(entry.first, &entry.second));
+    std::sort(sorted.begin(), sorted.end(), [](const std::pair<std::string, const DenyInfo *> &x, const std::pair<std::string, const DenyInfo *> &y) {
+        return x.second->count > y.second->count;
+    });
+
+    for (const auto &entry : sorted) {
+        const DenyInfo &info = *entry.second;
+        out << "<div class=\"deny\"><div class=\"denyhead\">" << Pill("DENY") << " <b>" << Esc(entry.first) <<
+            "</b> <span class=\"mono\">" << Esc(info.text) << "</span><span class=\"count\">" << info.count <<
+            " requests</span></div><div class=\"cols\">";
+        const char *titles[] = { "Top destinations", "Top clients", "Next matching allow rule" };
+        const std::map<std::string, unsigned> *maps[] = { &info.hosts, &info.clients, &info.alternatives };
+        for (int k = 0; k < 3; ++k) {
+            out << "<div><h4>" << titles[k] << "</h4><ol>";
+            for (const auto &item : Top(*maps[k], 10))
+                out << "<li><span class=\"mono\">" << Esc(item.first) << "</span> <span class=\"muted\">" << item.second << "</span></li>";
+            out << "</ol></div>";
+        }
+        out << "</div></div>";
+    }
+}
+
+/*
+########
+# TraceOf -> std::string
+# 요청이 속한 묶음(클라이언트, 메서드, 목적지, 판정, 규칙)에 보관된 평가 과정을 찾는다.
+########
+*/
+static std::string
+TraceOf(const ConfigRun &run, const Record &r, const Decision &d)
+{
+    const auto it = run.traceAt.find(r.clientIp + "\x1f" + r.method + "\x1f" + HostOf(r, d) + "\x1f" + d.verdict + "\x1f" + d.rule);
+    return it == run.traceAt.end() ? std::string() : run.decisions[it->second].trace;
+}
+
+/*
+########
+# ReportRequests -> void (HTML 출력)
+# 요청을 (클라이언트, 메서드, 목적지, 결과[, 새 결과]) 묶음으로 세어 많은 순으로 표를 만든다.
+# 판정 규칙을 누르면 규칙 줄과 평가 과정이 펼쳐진다. 검색·판정 필터·"바뀐 것만" 체크박스를 넣고 ReportRowLimit에서 자른다.
+########
+*/
+static void
+ReportRequests(std::ostream &out, const bool compare)
+{
+    class Group
+    {
+    public:
+        unsigned count = 0;
+        size_t first = 0;
+    };
+    std::map<std::string, Group> groups;
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Record &r = Records[i];
+        const Decision &a = Runs[0].decisions[i];
+        std::string key = r.clientIp + "\x1f" + r.method + "\x1f" + HostOf(r, a) + "\x1f" + a.verdict + "\x1f" + a.rule;
+        if (compare)
+            key += "\x1f" + Runs[1].decisions[i].verdict + "\x1f" + Runs[1].decisions[i].rule;
+        Group &g = groups[key];
+        if (!g.count++)
+            g.first = i;
+    }
+    std::vector<const Group *> sorted;
+    for (const auto &entry : groups)
+        sorted.push_back(&entry.second);
+    std::sort(sorted.begin(), sorted.end(), [](const Group *x, const Group *y) {
+        return x->count > y->count || (x->count == y->count && x->first < y->first);
+    });
+
+    out << "<div class=\"filters\"><input id=\"req-q\" type=\"search\" placeholder=\"Filter: client, host, rule...\" oninput=\"applyFilter('req')\">"
+        "<select id=\"req-v\" onchange=\"applyFilter('req')\"><option value=\"\">all verdicts</option>"
+        "<option>ALLOW</option><option>DENY</option><option>AUTH</option><option>DUNNO</option><option>SKIP</option></select>";
+    if (compare)
+        out << "<label><input id=\"req-c\" type=\"checkbox\" onchange=\"applyFilter('req')\"" <<
+            " checked> changed only</label>";
+    out << "</div>";
+    if (sorted.size() > ReportRowLimit)
+        out << "<p class=\"muted\">Showing the " << ReportRowLimit << " largest of " << sorted.size() << " groups.</p>";
+
+    out << "<table id=\"req\" class=\"requests\"><thead><tr><th class=\"num\">count</th><th>client</th><th>method</th>"
+        "<th>destination</th><th>" << (compare ? "current" : "verdict") << "</th><th>decided by</th><th>matching rules</th>";
+    if (compare)
+        out << "<th>new</th><th>decided by (new)</th>";
+    out << "<th>first line</th></tr></thead><tbody>";
+
+    size_t shown = 0;
+    for (const Group *g : sorted) {
+        if (++shown > ReportRowLimit)
+            break;
+        const Record &r = Records[g->first];
+        const Decision &a = Runs[0].decisions[g->first];
+        const bool changed = compare && Changed(a, Runs[1].decisions[g->first]);
+        out << "<tr data-verdict=\"" << Esc(a.verdict) << "\" data-changed=\"" << (changed ? 1 : 0) << "\"" <<
+            (changed ? " class=\"changed\"" : "") << "><td class=\"num\">" << g->count << "</td><td class=\"mono\">" <<
+            Esc(r.clientIp) << "</td><td>" << Esc(r.method) << "</td><td class=\"mono\">" << Esc(HostOf(r, a)) <<
+            "</td><td>" << Pill(a.verdict) << "</td><td><details><summary>" << Esc(Short(a.rule)) <<
+            "</summary><div class=\"mono small\">" << Esc(a.ruleText) << "</div><pre>" << Esc(TraceOf(Runs[0], r, a)) <<
+            "</pre></details></td><td class=\"mono small\">" << Esc(MatchChain(a)) << "</td>";
+        if (compare) {
+            const Decision &b = Runs[1].decisions[g->first];
+            out << "<td>" << Pill(b.verdict) << "</td><td><details><summary>" << Esc(Short(b.rule)) <<
+                "</summary><div class=\"mono small\">" << Esc(b.ruleText) << "</div><pre>" << Esc(TraceOf(Runs[1], r, b)) <<
+                "</pre></details></td>";
+        }
+        out << "<td class=\"num\">" << r.lineNo << "</td></tr>";
+    }
+    out << "</tbody></table>";
+}
+
+/*
+########
+# ReportTransitions -> void (HTML 출력)
+# --sim-compare에서 (현재 판정·규칙 -> 새 판정·규칙) 전환별 요청 수와 예시 요청을 보여 준다.
+########
+*/
+static void
+ReportTransitions(std::ostream &out)
+{
+    std::map<std::string, unsigned> counts;
+    std::map<std::string, size_t> example;
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Decision &a = Runs[0].decisions[i];
+        const Decision &b = Runs[1].decisions[i];
+        if (!Changed(a, b))
+            continue;
+        const std::string key = a.verdict + "\x1f" + a.rule + "\x1f" + b.verdict + "\x1f" + b.rule;
+        if (!counts[key]++)
+            example[key] = i;
+    }
+    if (counts.empty()) {
+        out << "<p class=\"muted\">No request changes its verdict or deciding rule.</p>";
+        return;
+    }
+    out << "<table class=\"requests\"><thead><tr><th class=\"num\">requests</th><th>current</th><th>rule</th>"
+        "<th></th><th>new</th><th>rule</th><th>example</th></tr></thead><tbody>";
+    for (const auto &t : Top(counts, ReportRowLimit)) {
+        const size_t i = example[t.first];
+        const Decision &a = Runs[0].decisions[i];
+        const Decision &b = Runs[1].decisions[i];
+        out << "<tr" << (a.verdict != b.verdict ? " class=\"changed\"" : "") << "><td class=\"num\">" << t.second <<
+            "</td><td>" << Pill(a.verdict) << "</td><td class=\"mono small\"><b>" << Esc(Short(a.rule)) << "</b> " <<
+            Esc(a.ruleText) << "</td><td>&rarr;</td><td>" << Pill(b.verdict) << "</td><td class=\"mono small\"><b>" <<
+            Esc(Short(b.rule)) << "</b> " << Esc(b.ruleText) << "</td><td class=\"mono small\">" <<
+            Esc(Records[i].clientIp + " " + Records[i].method + " " + Records[i].url) << "</td></tr>";
+    }
+    out << "</tbody></table>";
+}
+
+/*
+########
+# ReportLogDifferences -> void (HTML 출력)
+# 시뮬레이션 판정이 로그의 %Ss와 다른(DIFF) 요청을 (클라이언트, 목적지, 로그 결과, 판정, 규칙)별로 묶어 보여 주고,
+# http_access 밖의 지시어(miss_access, ssl_bump 등)나 그 뒤 바뀐 설정이 원인일 수 있음을 알린다.
+########
+*/
+static void
+ReportLogDifferences(std::ostream &out)
+{
+    std::map<std::string, unsigned> counts;
+    std::map<std::string, size_t> example;
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Decision &d = Runs[0].decisions[i];
+        if (d.vsLog != "DIFF")
+            continue;
+        const Record &r = Records[i];
+        const std::string key = r.clientIp + "\x1f" + HostOf(r, d) + "\x1f" + r.squidStatus + "\x1f" + d.verdict + "\x1f" + d.rule;
+        if (!counts[key]++)
+            example[key] = i;
+    }
+    if (counts.empty()) {
+        out << "<p class=\"muted\">Every evaluable request matches what access.log recorded.</p>";
+        return;
+    }
+    out << "<p class=\"muted\">TCP_DENIED can also come from directives other than http_access "
+        "(miss_access, adapted_http_access, ssl_bump, ...) or from a config that changed after logging.</p>"
+        "<table class=\"requests\"><thead><tr><th class=\"num\">requests</th><th>client</th><th>destination</th>"
+        "<th>logged</th><th>simulated</th><th>decided by</th></tr></thead><tbody>";
+    for (const auto &t : Top(counts, ReportRowLimit)) {
+        const size_t i = example[t.first];
+        const Record &r = Records[i];
+        const Decision &d = Runs[0].decisions[i];
+        out << "<tr><td class=\"num\">" << t.second << "</td><td class=\"mono\">" << Esc(r.clientIp) <<
+            "</td><td class=\"mono\">" << Esc(HostOf(r, d)) << "</td><td class=\"mono\">" << Esc(r.squidStatus + "/" + r.status) <<
+            "</td><td>" << Pill(d.verdict) << "</td><td class=\"mono small\"><b>" << Esc(Short(d.rule)) << "</b> " <<
+            Esc(d.ruleText) << "</td></tr>";
+    }
+    out << "</tbody></table>";
+}
+
+/*
+########
+# ReportFindings -> void (HTML 출력)
+# --optimize 결과 표(심각도, 항목, 대상, 설명과 위치, 권장 조치)를 쓴다.
+########
+*/
+static void
+ReportFindings(std::ostream &out, const ConfigRun &run)
+{
+    if (run.findings.empty()) {
+        out << "<p class=\"muted\">Nothing to optimize.</p>";
+        return;
+    }
+    out << "<table class=\"requests\"><thead><tr><th>severity</th><th>finding</th><th>subject</th>"
+        "<th>details</th><th>suggestion</th></tr></thead><tbody>";
+    for (const auto &f : run.findings) {
+        out << "<tr><td>" << Pill(SeverityName(f.severity)) << "</td><td>" << Esc(f.category) <<
+            "</td><td class=\"mono\">" << Esc(f.subject) << "</td><td>" << Esc(f.message);
+        if (!f.where.empty())
+            out << "<div class=\"mono small muted\">" << Esc(f.where) << "</div>";
+        out << "</td><td>" << Esc(f.fix) << "</td></tr>";
+    }
+    out << "</tbody></table>";
+}
+
+/*
+########
+# WriteReport -> bool (쓰기 실패면 false)
+# 단일 HTML 리포트: 메타 정보, 요약 카드, 최적화 결과, 설정 비교 전환, 규칙 표, 규칙별 차단 요청,
+# 요청 묶음 표, 로그와 다른 요청, 필터용 스크립트. 라이트/다크 색 변수를 포함하고 외부 파일을 쓰지 않는다.
+########
+*/
+static bool
+WriteReport()
+{
+    std::ofstream out(ReportFile);
+    if (!out) {
+        std::cerr << "squid --simulate: cannot write " << ReportFile << std::endl;
+        return false;
+    }
+    const bool compare = CompareConf != nullptr;
+    const ConfigRun &cur = Runs[0];
+
+    std::set<std::string> texts[2];
+    for (int k = 0; k < (compare ? 2 : 1); ++k) {
+        for (const auto &rule : Runs[k].rules)
+            texts[k].insert(rule.text);
+    }
+
+    unsigned verdictChanges = 0, nowDenied = 0, nowAllowed = 0, ruleChanges = 0;
+    if (compare) {
+        for (size_t i = 0; i < Records.size(); ++i) {
+            const Decision &a = Runs[0].decisions[i];
+            const Decision &b = Runs[1].decisions[i];
+            if (!Changed(a, b))
+                continue;
+            if (a.verdict == b.verdict) {
+                ++ruleChanges;
+                continue;
+            }
+            ++verdictChanges;
+            if (b.verdict == "DENY")
+                ++nowDenied;
+            if (b.verdict == "ALLOW")
+                ++nowAllowed;
+        }
+    }
+
+    const time_t now = time(nullptr);
+    char stamp[64];
+    strftime(stamp, sizeof(stamp), "%Y-%m-%d %H:%M:%S UTC", gmtime(&now));
+
+    out << "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
+        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
+        "<title>Squid ACL Simulation</title><style>"
+        ":root{--bg:#f7f7f5;--panel:#fff;--text:#1d1d1b;--muted:#6b6b66;--line:#e3e2dc;--allow:#1a7f4b;--allow-bg:#e3f4ea;"
+        "--deny:#c0362c;--deny-bg:#fbe6e3;--warn:#9a6700;--warn-bg:#fff4d6;--accent:#3b5bdb;--changed:#fff8e1}"
+        "@media (prefers-color-scheme:dark){:root{--bg:#161615;--panel:#1f1f1d;--text:#ecebe6;--muted:#9c9b95;--line:#33332f;"
+        "--allow:#5fd08f;--allow-bg:#163322;--deny:#ff7b6e;--deny-bg:#3a1a17;--warn:#e8b949;--warn-bg:#3a2e10;--accent:#8ea2ff;--changed:#2c2817}}"
+        "*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 system-ui,-apple-system,'Segoe UI','Noto Sans KR',sans-serif}"
+        "main{max-width:1280px;margin:0 auto;padding:24px 16px 64px}h1{font-size:22px;margin:0 0 4px}h2{font-size:17px;margin:32px 0 12px}"
+        "h4{margin:0 0 6px;font-size:13px;color:var(--muted);font-weight:600}.muted{color:var(--muted)}.mono{font-family:ui-monospace,Menlo,Consolas,monospace}"
+        ".small{font-size:12px}.meta{color:var(--muted);font-size:13px}.meta code{color:var(--text)}"
+        ".cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-top:16px}"
+        ".card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px 14px}.card .label{font-size:12px;color:var(--muted)}"
+        ".card .value{font-size:24px;font-weight:650}.card.allow .value{color:var(--allow)}.card.deny .value{color:var(--deny)}.card.warn .value{color:var(--warn)}"
+        ".panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:4px 0;overflow-x:auto}"
+        "table{border-collapse:collapse;width:100%}th,td{padding:7px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}"
+        "th{font-size:12px;color:var(--muted);font-weight:600;white-space:nowrap}tbody tr:last-child td{border-bottom:0}.num{text-align:right;font-variant-numeric:tabular-nums}"
+        "tr.unused td{opacity:.55}tr.changed td{background:var(--changed)}"
+        ".pill{display:inline-block;padding:1px 8px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.03em}"
+        ".pill.allow{background:var(--allow-bg);color:var(--allow)}.pill.deny{background:var(--deny-bg);color:var(--deny)}"
+        ".pill.auth,.pill.dunno,.pill.skip,.pill.medium{background:var(--warn-bg);color:var(--warn)}"
+        ".pill.high{background:var(--deny-bg);color:var(--deny)}.pill.low,.pill.info{background:var(--line);color:var(--muted)}"
+        ".tag{font-size:11px;border:1px solid var(--accent);color:var(--accent);border-radius:4px;padding:0 5px;margin-left:4px;font-family:system-ui}"
+        ".tag.muted{border-color:var(--line);color:var(--muted)}.barcol{width:22%}.bar{height:8px;background:var(--line);border-radius:4px;overflow:hidden;margin-top:6px}"
+        ".bar span{display:block;height:100%;background:var(--muted)}.bar.allow span{background:var(--allow)}.bar.deny span{background:var(--deny)}"
+        ".deny{background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--deny);border-radius:10px;padding:12px 14px;margin-bottom:10px}"
+        ".denyhead{display:flex;flex-wrap:wrap;gap:8px;align-items:baseline}.count{margin-left:auto;color:var(--muted)}"
+        ".cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:10px}ol{margin:0;padding-left:20px}"
+        ".filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;align-items:center}"
+        "input[type=search],select{background:var(--panel);color:var(--text);border:1px solid var(--line);border-radius:6px;padding:6px 8px;font:inherit}"
+        "input[type=search]{flex:1;min-width:200px}details summary{cursor:pointer;font-weight:600}"
+        "pre{margin:6px 0 0;font-size:11px;white-space:pre-wrap;color:var(--muted)}"
+        "</style></head><body><main>";
+
+    const bool replayed = LogFile != nullptr;
+    out << "<h1>Squid http_access simulation</h1><div class=\"meta\">";
+    if (replayed)
+        out << "log <code>" << Esc(LogFile) << "</code> &middot; ";
+    out << "current <code>" << Esc(cur.path) << "</code>";
+    if (compare)
+        out << " &middot; new <code>" << Esc(Runs[1].path) << "</code>";
+    out << " &middot; generated " << stamp << " &middot; DNS " << (DnsMode == 2 ? "system resolver" : "off (hosts_file only)") << "</div>";
+
+    out << "<div class=\"cards\">";
+    if (replayed) {
+        ReportCard(out, "requests", Records.size(), "");
+        ReportCard(out, "allowed", cur.allowed, "allow");
+        ReportCard(out, "denied", cur.denied, "deny");
+        ReportCard(out, "auth / other", cur.other, "warn");
+        ReportCard(out, "not evaluable offline", cur.unsure, "warn");
+        ReportCard(out, "differs from log", cur.differ, "warn");
+        ReportCard(out, "skipped lines", cur.skipped, "");
+    }
+    if (compare && replayed) {
+        ReportCard(out, "verdict changes", verdictChanges, "warn");
+        ReportCard(out, "newly denied", nowDenied, "deny");
+        ReportCard(out, "newly allowed", nowAllowed, "allow");
+        ReportCard(out, "rule-only changes", ruleChanges, "");
+    }
+    if (Optimize) {
+        ReportCard(out, "optimize findings", cur.findings.size(), "warn");
+        if (compare)
+            ReportCard(out, "optimize findings (new)", Runs[1].findings.size(), "warn");
+    }
+    out << "</div>";
+
+    if (Optimize) {
+        out << "<h2>Optimization" << (compare ? " &mdash; current squid.conf" : "") << "</h2><div class=\"panel\">";
+        ReportFindings(out, cur);
+        out << "</div>";
+        if (compare) {
+            out << "<h2>Optimization &mdash; new squid.conf</h2><div class=\"panel\">";
+            ReportFindings(out, Runs[1]);
+            out << "</div>";
+        }
+    }
+
+    if (compare && replayed) {
