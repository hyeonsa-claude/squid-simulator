+    out << "<h2>Rules" << (compare ? " &mdash; current squid.conf" : "") << "</h2>"
+        "<p class=\"muted small\">decided: requests this rule decided. also matched: requests it matches although an earlier rule decided.</p>"
+        "<div class=\"panel\">";
+    ReportRules(out, cur, texts[1], compare);
+    out << "</div>";
+    if (compare) {
+        out << "<h2>Rules &mdash; new squid.conf</h2><div class=\"panel\">";
+        ReportRules(out, Runs[1], texts[0], compare);
+        out << "</div>";
+    }
+
+    if (replayed) {
+        out << "<h2>Denied requests by rule" << (compare ? " &mdash; current" : "") << "</h2>";
+        ReportDenials(out, cur);
+        if (compare) {
+            out << "<h2>Denied requests by rule &mdash; new</h2>";
+            ReportDenials(out, Runs[1]);
+        }
+
+        out << "<h2>Requests</h2><p class=\"muted small\">Grouped by client, method, destination and outcome. "
+            "Click a rule to see how every rule was evaluated.</p>";
+        ReportRequests(out, compare);
+
+        out << "<h2>Simulation vs. access.log</h2><div class=\"panel\">";
+        ReportLogDifferences(out);
+        out << "</div>";
+    }
+
+    out << "<script>function applyFilter(id){var t=document.getElementById(id);if(!t)return;"
+        "var q=(document.getElementById(id+'-q').value||'').toLowerCase();var v=document.getElementById(id+'-v').value;"
+        "var c=document.getElementById(id+'-c');var rows=t.tBodies[0].rows;for(var i=0;i<rows.length;i++){var r=rows[i];"
+        "var ok=!q||r.textContent.toLowerCase().indexOf(q)>=0;if(ok&&v)ok=r.getAttribute('data-verdict')===v;"
+        "if(ok&&c&&c.checked)ok=r.getAttribute('data-changed')==='1';r.style.display=ok?'':'none';}}"
+        "applyFilter('req');</script></main></body></html>\n";
