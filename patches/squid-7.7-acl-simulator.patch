+# fqdncacheSimulatorLookup -> const char * (호스트 이름, 실패하면 nullptr)
+# squid --simulate에서 비동기 역방향 DNS 대신 쓰는 조회. fqdncache_simulator_mode 2일 때만
+# getnameinfo()로 동기 조회해 결과를 hosts_file 항목처럼 고정 캐시에 넣고, 1이면 조회하지 않는다.
+# 실패한 주소는 기억해 다시 막히는 조회를 하지 않는다. 버퍼 1025바이트는 NI_MAXHOST다.
+########
+*/
+static const char *
+fqdncacheSimulatorLookup(const Ip::Address &addr, char *name)
+{
+    if (fqdncache_simulator_mode != 2)
+        return nullptr;
+
+    static std::set<std::string> failed;
+    if (failed.count(name))
+        return nullptr;
+
+    struct addrinfo *ai = nullptr;
+    addr.getAddrInfo(ai);
+    char host[1025];
+    const int err = getnameinfo(ai->ai_addr, ai->ai_addrlen, host, sizeof(host), nullptr, 0, NI_NAMEREQD);
+    Ip::Address::FreeAddr(ai);
+    if (err != 0) {
+        debugs(35, 3, "simulator: no rDNS for " << name);
+        failed.insert(name);
+        return nullptr;
+    }
+
+    SBufList names;
+    names.push_back(SBuf(host));
+    fqdncacheAddEntryFromHosts(name, names);
+    const fqdncache_entry *f = fqdncache_get(name);
+    return f ? f->names[0] : nullptr;
+}
