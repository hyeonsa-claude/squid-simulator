+/// ACL simulator replacement for async DNS: resolves synchronously (mode 2)
+/// and caches the answer as a static entry, or gives up (mode 1)
+static const ipcache_addrs *
+ipcacheSimulatorLookup(const char *name)
+{
+    if (ipcache_simulator_mode != 2)
+        return NULL;
+
+    static std::set<std::string> failed; // do not repeat blocking lookups that failed
+    if (failed.count(name))
+        return NULL;
+
+    struct addrinfo hints;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = Ip::EnableIpv6 ? AF_UNSPEC : AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    struct addrinfo *res = NULL;
+    if (getaddrinfo(name, NULL, &hints, &res) != 0 || !res) {
+        debugs(14, 3, "simulator: cannot resolve " << name);
+        failed.insert(name);
+        return NULL;
+    }
+
+    std::vector<Ip::Address> found;
+    for (const struct addrinfo *ai = res; ai && found.size() < 32; ai = ai->ai_next) {
+        Ip::Address a;
+        if (!(a = *ai))
+            continue;
+        a.port(0);
+        if (std::find(found.begin(), found.end(), a) == found.end())
+            found.push_back(a);
+    }
+    freeaddrinfo(res);
+    if (found.empty()) {
+        failed.insert(name);
+        return NULL;
+    }
+
+    ipcache_entry *i = new ipcache_entry(name);
+    i->addrs.count = found.size();
+    i->addrs.cur = 0;
+    i->addrs.badcount = 0;
+    i->addrs.in_addrs = static_cast<Ip::Address *>(xcalloc(found.size(), sizeof(Ip::Address)));
+    i->addrs.bad_mask = (unsigned char *)xcalloc(found.size(), sizeof(unsigned char));
+    for (size_t k = 0; k < found.size(); ++k)
+        i->addrs.in_addrs[k] = found[k];
+    i->flags.fromhosts = true;
+    ipcacheAddEntry(i);
+    ipcacheLockEntry(i);
+    return &i->addrs;
+}
