+/// ACL simulator replacement for async rDNS: resolves synchronously (mode 2)
+/// and caches the answer as a static entry, or gives up (mode 1)
+static const char *
+fqdncacheSimulatorLookup(const Ip::Address &addr, char *name)
+{
+    if (fqdncache_simulator_mode != 2)
+        return NULL;
+
+    static std::set<std::string> failed; // do not repeat blocking lookups that failed
+    if (failed.count(name))
+        return NULL;
+
+    struct addrinfo *ai = NULL;
+    addr.getAddrInfo(ai);
+    char host[1025]; // NI_MAXHOST
