+/// one access.log line
+class Record
+{
+public:
+    unsigned lineNo = 0;
+    bool parsed = false;
+    bool hasTime = false;
+    time_t when = 0;
+    int tzOffset = 0; ///< seconds east of UTC, from %tl
+    std::string localIp, clientIp, method, url, version, host;
+    std::string status, squidStatus;
+};
+
+/// a rule that matched a request
+class RuleMatch
+{
+public:
+    std::string name; ///< http_access#N
+    std::string action; ///< allow, deny, or ? for exceptional answers
+    std::string text; ///< squid.conf line
+};
+
+/// how one squid.conf treats one request
+class Decision
+{
+public:
+    std::string verdict = "SKIP"; ///< ALLOW, DENY, AUTH, DUNNO, SKIP
+    std::string rule = "-"; ///< http_access#N, implicit, or -
+    std::string ruleText;
+    std::vector<RuleMatch> matches; ///< all matching rules in order; [0] decides unless implicit
+    std::string unsure; ///< ACLs that need lookups we cannot do offline
+    std::string trace; ///< rule-by-rule evaluation (kept for --sim-trace and the report)
+    std::string vsLog = "n/a"; ///< same, DIFF, UNSURE, n/a (current config only)
+};
+
+/// a configured http_access rule
+class RuleInfo
+{
+public:
+    std::string name;
+    std::string action;
+    std::string text;
+    std::vector<std::string> acls; ///< ACL names, "!name" when negated
+    unsigned decided = 0; ///< requests this rule decided
+    unsigned shadowed = 0; ///< requests it matched after an earlier rule decided
+};
+
+/// an --optimize result
+class Finding
+{
+public:
+    int severity; ///< 3 high, 2 medium, 1 low
+    std::string category;
+    std::string subject; ///< ACL or rule name
+    std::string where; ///< file:line or the squid.conf line
+    std::string message;
+    std::string fix;
+};
+
+/// results of replaying the log through one squid.conf
+class ConfigRun
+{
+public:
+    std::string path;
+    std::vector<RuleInfo> rules;
+    std::vector<Finding> findings; ///< --optimize results
+    std::vector<Decision> decisions; ///< parallel to Records
+    std::map<std::string, size_t> traceAt; ///< group key -> decision index holding its trace
+    unsigned allowed = 0, denied = 0, other = 0, skipped = 0, unsure = 0, differ = 0;
+    unsigned implicitHits = 0;
+};
+
+static std::vector<Record> Records;
+static ConfigRun Runs[2]; ///< current and (with --sim-compare) new squid.conf
+static bool Color = false; ///< ANSI colors on a terminal
+
+/// one evaluated ACL tree node, reported by ACLChecklist::Tracer
+class Step
+{
+public:
+    const Acl::InnerNode *parent;
+    const ACL *node;
+    int result; ///< 1 match, 0 mismatch
+};
+
+static std::vector<Step> Steps; ///< evaluation order of the current check
+/// ACLs whose result offline is a guess: they wanted an async lookup or
+/// they test data that the access.log format does not record
+static std::set<std::string> Skipped;
+
+/// ACL types that test data missing from "%tl %la %>a "%rm %ru HTTP/%rv" %>Hs %<st %Ss:%Sh"
+static const std::set<std::string> NoLogData = {
+    "browser", "referer_regex", "req_header", "req_mime_type", "rep_header", "rep_mime_type",
+    "http_status", "hier_code", "peername", "peername_regex", "maxconn", "max_user_ip",
+    "proxy_auth", "proxy_auth_regex", "ident", "ident_regex", "external", "ext_user", "ext_user_regex",
+    "user_cert", "ca_cert", "ssl_error", "server_cert_fingerprint", "at_step", "note", "tag",
+    "clientside_mark", "client_connection_mark", "adaptation_service", "arp", "eui64", "random"
+};
+
+static void
+Trace(const ACLChecklist *, const Acl::InnerNode *parent, const ACL *child, int result)
+{
+    if (result < 0 || NoLogData.count(child->typeString())) {
+        Skipped.insert(child->name);
+        if (result < 0)
+            return;
+    }
+    Steps.push_back(Step{parent, child, result});
+}
+
+/* access.log parsing */
+
+static int
+MonthNumber(const char *mon)
+{
+    static const char *names[] = { "Jan", "Feb", "Mar", "Apr", "May", "Jun",
+                                   "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
+                                 };
+    for (int i = 0; i < 12; ++i) {
+        if (strcasecmp(mon, names[i]) == 0)
+            return i;
+    }
+    return -1;
+}
+
+/// parses %tl ("31/Oct/2026:09:59:01" "+0900")
+static bool
+ParseTime(const std::string &date, const std::string &zone, Record &r)
+{
+    int day, year, hh, mm, ss;
+    char mon[4];
+    if (sscanf(date.c_str(), "%d/%3[A-Za-z]/%d:%d:%d:%d", &day, mon, &year, &hh, &mm, &ss) != 6)
+        return false;
+    const int month = MonthNumber(mon);
+    if (month < 0 || zone.size() != 5 || (zone[0] != '+' && zone[0] != '-'))
+        return false;
+
+    struct tm tm;
+    memset(&tm, 0, sizeof(tm));
+    tm.tm_mday = day;
+    tm.tm_mon = month;
+    tm.tm_year = year - 1900;
+    tm.tm_hour = hh;
+    tm.tm_min = mm;
+    tm.tm_sec = ss;
+
+    const int zh = atoi(zone.substr(1, 2).c_str());
+    const int zm = atoi(zone.substr(3, 2).c_str());
+    r.tzOffset = (zone[0] == '-' ? -1 : 1) * (zh * 3600 + zm * 60);
+    r.when = timegm(&tm) - r.tzOffset;
+    r.hasTime = true;
+    return true;
+}
+
+/// parses: %tl %la %>a "%rm %ru HTTP/%rv" %>Hs %<st %Ss:%Sh
+static bool
+ParseLine(const std::string &line, Record &r)
+{
+    const auto q1 = line.find('"');
+    const auto q2 = line.rfind('"');
+    if (q1 == std::string::npos || q2 == q1)
+        return false;
+
+    std::istringstream head(line.substr(0, q1));
+    std::string date, zone;
+    head >> date >> zone >> r.localIp >> r.clientIp;
+    if (r.clientIp.empty())
+        return false;
+    (void)ParseTime(date, zone, r);
+
+    std::istringstream req(line.substr(q1 + 1, q2 - q1 - 1));
+    std::vector<std::string> words;
+    for (std::string w; req >> w;)
+        words.push_back(w);
+    if (words.size() < 2)
+        return false;
+    if (words.size() >= 3 && words.back().compare(0, 5, "HTTP/") == 0) {
+        r.version = words.back().substr(5);
+        words.pop_back();
+    }
+    r.method = words[0];
+    r.url = words[1];
+    for (size_t i = 2; i < words.size(); ++i)
+        r.url += " " + words[i];
+    r.host = r.url;
+
+    std::istringstream tail(line.substr(q2 + 1));
+    std::string size, tags;
+    tail >> r.status >> size >> tags;
+    r.squidStatus = tags.substr(0, tags.find(':'));
+    return true;
+}
+
+/* helpers */
+
+/// makes localtime() (and thus "acl time") use the proxy's logged UTC offset
+static void
+UseLogTimezone(const int offset)
+{
+    static int current = INT_MIN;
+    if (offset == current)
+        return;
+    current = offset;
+    const int a = offset < 0 ? -offset : offset;
+    char tz[32];
+    // POSIX TZ offsets count west of UTC, hence the inverted sign
+    snprintf(tz, sizeof(tz), "SIM%c%02d:%02d", offset > 0 ? '-' : '+', a / 3600, (a % 3600) / 60);
+    setenv("TZ", tz, 1);
+    tzset();
+}
+
+/// what Squid logged for this request: "DENY", "ALLOW", or "" (unknown)
+static const char *
+LoggedVerdict(const Record &r)
+{
+    const std::string &s = r.squidStatus;
+    if (s.compare(0, 10, "TCP_DENIED") == 0 && s != "TCP_DENIED_REPLY")
+        return "DENY";
+    if (s.empty() || s == "-" || s.compare(0, 4, "NONE") == 0 || s.compare(0, 8, "TAG_NONE") == 0)
+        return "";
+    return "ALLOW";
+}
+
+static const char *
+VerdictName(const allow_t &answer)
+{
+    if (answer.allowed())
+        return "ALLOW";
+    if (answer.denied())
+        return "DENY";
+    if (answer == ACCESS_AUTH_REQUIRED)
+        return "AUTH";
+    return "DUNNO";
+}
+
+/// zero-based position of a rule from its "http_access#N" name
+static int
+RulePosition(const std::string &name)
+{
+    const auto hash = name.rfind('#');
+    return hash == std::string::npos ? -1 : atoi(name.c_str() + hash + 1) - 1;
+}
+
+/// "http_access#5" -> "#5"
+static std::string
+Short(const std::string &name)
+{
+    const auto hash = name.rfind('#');
+    return hash == std::string::npos ? name : name.substr(hash);
+}
+
+static std::string
+Upper(std::string s)
+{
+    for (auto &c : s)
+        c = toupper(static_cast<unsigned char>(c));
+    return s;
+}
+
+static std::string
+Lower(std::string s)
+{
+    for (auto &c : s)
+        c = tolower(static_cast<unsigned char>(c));
+    return s;
+}
+
+/// a squid.conf line without its trailing "# comment" (ACL and rule lines only)
+static std::string
+ConfLine(const char *cfgline)
+{
+    std::string line = cfgline ? cfgline : "";
+    const auto hash = line.find(" #");
+    if (hash != std::string::npos)
+        line.erase(hash);
+    const auto tab = line.find("\t#");
+    if (tab != std::string::npos)
+        line.erase(tab);
+    while (!line.empty() && (line.back() == ' ' || line.back() == '\t'))
+        line.pop_back();
+    return line;
+}
+
+static std::string
+Paint(const std::string &s, const char *code)
+{
+    return Color ? "\033[" + std::string(code) + "m" + s + "\033[0m" : s;
+}
+
+static const char *
+VerdictColor(const std::string &verdict)
+{
+    if (verdict == "ALLOW")
+        return "1;32";
+    if (verdict == "DENY")
+        return "1;31";
+    return "1;33";
+}
+
+static std::string
+Pad(std::string s, const size_t width)
+{
+    if (s.size() < width)
+        s.append(width - s.size(), ' ');
+    return s;
+}
+
+/// the answer when no rule matches: the opposite of the last rule action;
+/// the rule named by without is treated as deleted
+static std::string
+ImplicitVerdict(const ConfigRun &run, const std::string &without = std::string())
+{
+    for (auto rule = run.rules.rbegin(); rule != run.rules.rend(); ++rule) {
+        if (rule->name != without)
+            return rule->action == "allow" ? "DENY" : "ALLOW";
+    }
+    return "DUNNO";
+}
+
+/// what would happen if the deciding rule were removed
+static std::string
+WithoutDecisive(const Decision &d, const ConfigRun &run)
+{
+    if (d.matches.size() >= 2)
+        return Upper(d.matches[1].action) + " by " + d.matches[1].name;
+    return ImplicitVerdict(run, d.rule) + " by implicit rule";
+}
+
+/// "#5 deny > #9 allow > #12 allow"
+static std::string
+MatchChain(const Decision &d)
+{
+    if (d.matches.empty())
+        return "none";
+    std::string chain;
+    for (const auto &m : d.matches) {
+        if (!chain.empty())
+            chain += " > ";
+        chain += Short(m.name) + " " + m.action;
+    }
+    return chain;
+}
+
+static std::string
+FirstMatching(const Decision &d, const char *action)
+{
+    for (const auto &m : d.matches) {
+        if (m.action == action)
+            return m.name;
+    }
+    return "";
+}
+
+static bool
+WasSkipped(const ACL *node)
+{
+    const char *name = node->name;
+    return Skipped.count(name) || (name[0] == '!' && Skipped.count(name + 1));
+}
+
+/// rule-by-rule evaluation of the last check
+static std::string
+FormatTrace(const Acl::Tree *tree)
+{
+    std::ostringstream out;
+    std::vector<const Step *> leaves;
+    for (const auto &step : Steps) {
+        if (step.parent != tree) {
+            leaves.push_back(&step);
+            continue;
+        }
+        out << "             " << Pad(Short(step.node->name), 5) <<
+            (step.result ? " MATCH " : " no    ");
+        for (const auto *leaf : leaves) {
+            if (leaf->parent != step.node)
+                continue; // nested any-of/all-of/!acl internals
+            out << " " << leaf->node->name << "=" <<
+                (WasSkipped(leaf->node) ? "?" : (leaf->result ? "yes" : "no"));
+        }
+        out << "   [" << ConfLine(step.node->cfgline) << "]\n";
+        leaves.clear();
+    }
+    return out.str();
+}
+
+/// every configured rule, from the parsed tree
+static std::vector<RuleInfo>
+CollectRules(const Acl::Tree *tree)
+{
+    std::vector<RuleInfo> result;
+    const SBufList dump = tree->treeDump("http_access", [](const allow_t &a) {
+        return a.allowed() ? "allow" : "deny";
+    });
+    static const SBuf NewLine("\n");
+    RuleInfo rule;
+    size_t tokens = 0;
+    for (const auto &token : dump) {
+        if (!(token == NewLine)) {
+            if (++tokens == 2)
+                rule.action = token.toStdString();
+            else if (tokens > 2)
+                rule.acls.push_back(token.toStdString());
+            if (!rule.text.empty())
+                rule.text += " ";
+            rule.text += token.toStdString();
+            continue;
+        }
+        rule.name = "http_access#" + std::to_string(result.size() + 1);
+        result.push_back(rule);
+        rule = RuleInfo();
+        tokens = 0;
+    }
+    return result;
+}
+
+/* evaluation */
+
+static void
+CountDecision(ConfigRun &run, const Decision &d)
+{
+    if (d.verdict == "ALLOW")
+        ++run.allowed;
+    else if (d.verdict == "DENY")
+        ++run.denied;
+    else if (d.verdict == "SKIP")
+        ++run.skipped;
+    else
+        ++run.other;
+    if (!d.unsure.empty())
+        ++run.unsure;
+    if (d.vsLog == "DIFF")
+        ++run.differ;
+
+    // the deciding rule may have no match entry (e.g., it ended the check with AUTH)
+    const int decisive = d.rule == "implicit" ? -1 : RulePosition(d.rule);
+    if (d.rule == "implicit")
+        ++run.implicitHits;
+    else if (decisive >= 0 && size_t(decisive) < run.rules.size())
+        ++run.rules[decisive].decided;
+    for (size_t i = 0; i < d.matches.size(); ++i) {
+        const int pos = RulePosition(d.matches[i].name);
+        if (pos < 0 || size_t(pos) >= run.rules.size() || (i == 0 && pos == decisive))
+            continue;
+        ++run.rules[pos].shadowed;
+    }
+}
+
+/// replays one record through the current http_access rules
+static Decision
+Evaluate(Record &r, ConfigRun &run, const bool current, const int localPort)
+{
+    Decision d;
+    if (!r.parsed) {
+        d.ruleText = "unparsable log line";
+        return d;
+    }
+
+    Acl::Tree *tree = Config.accessList.http;
+
+    HttpRequestMethod method;
+    method.HttpRequestMethodXXX(r.method.c_str());
+    const MasterXaction::Pointer mx = new MasterXaction(XactionInitiator::initClient);
+    HttpRequest::Pointer request(HttpRequest::FromUrl(SBuf(r.url.c_str()), mx, method));
+    if (!request) {
+        d.ruleText = "unparsable URL";
+        return d;
+    }
+    r.host = std::string(request->url.host()) + ":" + std::to_string(request->url.port());
+
+    unsigned vMajor = 1, vMinor = 1;
+    if (sscanf(r.version.c_str(), "%u.%u", &vMajor, &vMinor) == 2)
+        request->http_ver = Http::ProtocolVersion(vMajor, vMinor);
+
+    if (!(request->client_addr = r.clientIp.c_str()))
+        request->client_addr.setNoAddr();
+#if FOLLOW_X_FORWARDED_FOR
+    request->indirect_client_addr = request->client_addr;
+#endif
+    if (!(request->my_addr = r.localIp.c_str()))
+        request->my_addr.setAnyAddr();
+    request->my_addr.port(localPort);
+    // myportname: the http_port listening on localPort, else the first one
+    const AnyP::PortCfg *listener = HttpPortList.getRaw();
+    for (const AnyP::PortCfg *p = listener; p; p = p->next.getRaw()) {
+        if (p->s.port() == localPort) {
+            listener = p;
+            break;
+        }
+    }
+    if (listener && listener->name)
+        request->myportname = listener->name;
+    if (DnsMode == 2)
+        request->flags.destinationIpLookedUp = true; // lookups here are final
+
+    AccessLogEntry::Pointer al = new AccessLogEntry;
+    al->request = request.getRaw();
+    HTTPMSGLOCK(al->request);
+    al->adapted_request = request.getRaw(); // no adaptation offline
+    HTTPMSGLOCK(al->adapted_request);
+    al->url = SBuf(r.url.c_str());
+    al->cache.caddr = request->client_addr;
+
+    if (r.hasTime)
+        UseLogTimezone(r.tzOffset);
+
+    // Pass 0 is the real check. Each later pass ignores all rules up to the
+    // previous winner, revealing the next matching rule, until none is left.
+    Skipped.clear();
+    allow_t firstAnswer;
+    const ACL *lastEvaluated = nullptr;
+    bool firstPassMatched = false;
+    std::string trace;
+    std::set<std::string> unsure; // only pass 0 decides the verdict
+    ACLChecklist::SkipRulesThrough = -1;
+    for (size_t pass = 0; pass <= run.rules.size(); ++pass) {
+        Steps.clear();
+        ACLFilledChecklist checklist(tree, request.getRaw(), nullptr);
+        checklist.al = al;
+        if (DnsMode == 2) {
+            checklist.markDestinationDomainChecked();
+            checklist.markSourceDomainChecked();
+        }
+        // every logged debug message resets the clock (getCurrentTime()),
+        // so restore the logged time right before "acl time" may read it
+        if (r.hasTime) {
+            squid_curtime = r.when;
+            current_time.tv_sec = r.when;
+            current_time.tv_usec = 0;
+            current_dtime = r.when;
+        }
+        const allow_t answer = checklist.fastCheck();
+
+        const ACL *winner = nullptr;
+        for (const auto &step : Steps) {
+            if (step.parent != tree)
+                continue;
+            if (pass == 0)
+                lastEvaluated = step.node;
+            if (step.result)
+                winner = step.node;
+        }
+        if (pass == 0) {
+            firstAnswer = answer;
+            firstPassMatched = winner;
+            trace = FormatTrace(tree);
+            unsure = Skipped;
+            if (!answer.allowed() && !answer.denied()) {
+                // AUTH or DUNNO: the last ACL checked in that rule ended the check
+                const ACL *culprit = lastEvaluated;
+                for (const auto &step : Steps) {
+                    if (lastEvaluated && step.parent == lastEvaluated)
+                        culprit = step.node;
+                }
+                unsure.insert(culprit ? culprit->name : "?");
+            }
+        }
+        if (!winner)
+            break;
+
+        RuleMatch m;
+        m.name = winner->name;
+        m.action = answer.allowed() ? "allow" : (answer.denied() ? "deny" : "?");
+        m.text = ConfLine(winner->cfgline);
+        d.matches.push_back(m);
+        if (m.action == "?")
+            break; // exceptional answers (e.g., AUTH) end the check
+
+        ACLChecklist::SkipRulesThrough = RulePosition(m.name);
+        if (ACLChecklist::SkipRulesThrough < 0)
+            break;
+    }
+    ACLChecklist::SkipRulesThrough = -1;
+
+    d.verdict = VerdictName(firstAnswer);
+    if (firstPassMatched) {
+        d.rule = d.matches[0].name;
+        d.ruleText = d.matches[0].text;
+    } else if (!firstAnswer.allowed() && !firstAnswer.denied() && lastEvaluated) {
+        // an exceptional answer while this rule was being checked
+        d.rule = lastEvaluated->name;
+        d.ruleText = ConfLine(lastEvaluated->cfgline);
+    } else {
+        d.rule = "implicit";
+        d.ruleText = "(no rule matched: opposite of the last rule's action)";
+    }
+
+    for (const auto &name : unsure)
+        d.unsure += (d.unsure.empty() ? "" : " ") + name;
+
+    if (current) {
+        const char *logged = LoggedVerdict(r);
+        if (!d.unsure.empty())
+            d.vsLog = "UNSURE";
+        else if (*logged)
+            d.vsLog = d.verdict == logged ? "same" : "DIFF";
+    }
+
+    // keep one trace per report group; all of them for --sim-trace
+    const std::string key = r.clientIp + "\x1f" + r.method + "\x1f" + r.host + "\x1f" + d.verdict + "\x1f" + d.rule;
+    const bool firstOfGroup = run.traceAt.find(key) == run.traceAt.end();
+    if (ShowTrace || (ReportFile && firstOfGroup))
+        d.trace = trace;
+    if (ReportFile && firstOfGroup)
+        run.traceAt[key] = run.decisions.size();
+    return d;
+}
+
+/* --optimize */
+
+static void
+AddFinding(ConfigRun &run, const int severity, const char *category, const std::string &subject,
+           const std::string &where, const std::string &message, const std::string &fix)
+{
+    Finding f;
+    f.severity = severity;
+    f.category = category;
+    f.subject = subject;
+    f.where = where;
+    f.message = message;
+    f.fix = fix;
+    // a parser may report the same problem twice (e.g., splay tree re-comparisons)
+    for (const auto &old : run.findings) {
+        if (old.category == f.category && old.subject == f.subject && old.where == f.where && old.message == f.message)
+            return;
+    }
+    run.findings.push_back(f);
+}
+
+static std::string
+JoinDump(const ACL *acl)
+{
+    std::string values;
+    for (const auto &item : acl->dump()) {
+        if (!values.empty())
+            values += " ";
+        values += item.toStdString();
+    }
+    return values;
+}
+
+/// names of ACLs that match every request
+static std::set<std::string>
+UniversalAcls()
+{
+    std::set<std::string> names;
+    names.insert("all");
+    // other regex types (browser, req_header, ...) mismatch when their field is absent
+    for (const auto &note : Acl::ConfigNotes) {
+        if (note.kind == "universal" && (note.type == "url_regex" || note.type == "urlpath_regex"))
+            names.insert(note.acl);
+    }
+    // "dst all" still needs a DNS answer, so only "src" is universal
+    static const std::set<std::string> anyAddress = { "all", "0.0.0.0/0", "::/0", "[::]/0" };
+    for (const ACL *a = Config.aclList; a; a = a->next) {
+        if (strcmp(a->typeString(), "src") != 0)
+            continue;
+        for (const auto &item : a->dump()) {
+            if (anyAddress.count(item.toStdString()))
+                names.insert(a->name);
+        }
+    }
+    return names;
+}
+
+/// finds unneeded or ineffective ACLs and http_access rules in the parsed squid.conf
+static void
+Analyze(ConfigRun &run)
+{
+    // what the ACL parsers noticed
+    for (const auto &note : Acl::ConfigNotes) {
+        if (note.kind == "predefined")
+            AddFinding(run, 2, "built-in ACL redefined", note.acl, note.where + "  " + ConfLine(note.line.c_str()), note.message,
+                       "delete this acl line; Squid already defines '" + note.acl + "'");
+        else if (note.kind == "covered")
+            AddFinding(run, 1, "covered by a wider entry", note.acl, note.where + "  " + ConfLine(note.line.c_str()), note.message,
+                       "delete the narrower entry");
+        else if (note.kind == "duplicate")
+            AddFinding(run, 1, "duplicate entry", note.acl, note.where + "  " + ConfLine(note.line.c_str()), note.message,
+                       "delete the repeated entry");
+        else if (note.kind == "universal")
+            AddFinding(run, 2, "matches everything", note.acl, note.where + "  " + ConfLine(note.line.c_str()), note.message,
+                       "use the built-in 'all' ACL or remove the pattern");
+    }
+
+    // unused and identical ACL definitions
+    std::map<std::string, std::vector<std::string> > bySignature;
+    for (ACL *a = Config.aclList; a; a = a->next) {
+        if (Acl::PredefinedAcls.count(a->name))
+            continue;
+        if (!Acl::AclReferences.count(Lower(a->name)))
+            AddFinding(run, 1, "unused ACL", a->name, ConfLine(a->cfgline),
+                       "defined, but no directive or other ACL uses it", "delete its acl line(s)");
+        std::string options;
+        for (const auto &option : a->dumpOptions())
+            options += option.toStdString() + " ";
+        bySignature[std::string(a->typeString()) + " " + options + JoinDump(a)].push_back(a->name);
+    }
+    for (const auto &entry : bySignature) {
+        if (entry.second.size() < 2)
+            continue;
+        std::string names;
+        for (const auto &name : entry.second)
+            names += (names.empty() ? "" : ", ") + name;
+        AddFinding(run, 1, "identical ACLs", names, entry.first,
+                   "these ACLs have the same type and values", "keep one of them and use its name everywhere");
+    }
+
+    // http_access rules
+    const std::set<std::string> universal = UniversalAcls();
+    const size_t count = run.rules.size();
+    std::vector<std::set<std::string> > conditions(count);
+    std::vector<bool> impossible(count, false), reported(count, false);
+    for (size_t j = 0; j < count; ++j) {
+        const RuleInfo &rule = run.rules[j];
+        std::set<std::string> seen;
+        for (const auto &acl : rule.acls) {
+            const bool negated = acl[0] == '!';
+            const std::string base = negated ? acl.substr(1) : acl;
+            if (!seen.insert(acl).second)
+                AddFinding(run, 1, "repeated ACL in rule", rule.name, rule.text,
+                           "'" + acl + "' appears twice", "remove the repetition");
+            if (seen.count(negated ? base : "!" + base)) {
+                impossible[j] = true;
+                AddFinding(run, 3, "rule never matches", rule.name, rule.text,
+                           "it requires both '" + base + "' and '!" + base + "'", "fix or delete the rule");
+            }
+            if (universal.count(base)) {
+                if (negated) {
+                    impossible[j] = true;
+                    AddFinding(run, 3, "rule never matches", rule.name, rule.text,
+                               "'!" + base + "' never matches because '" + base + "' matches everything",
+                               "fix or delete the rule");
+                } else if (rule.acls.size() > 1) {
+                    AddFinding(run, 1, "redundant 'all'", rule.name, rule.text,
+                               "'" + base + "' matches everything, so it adds no condition",
+                               "remove it, unless it is last on purpose to suppress an authentication challenge");
+                }
+                continue; // a universal ACL does not narrow the rule
+            }
+            conditions[j].insert(acl);
+        }
+    }
+
+    // a rule is dead when an earlier rule needs only a subset of its ACLs
+    bool unconditionalBefore = false; // an earlier rule matches every request
+    for (size_t j = 0; j < count; ++j) {
+        if (impossible[j])
+            continue;
+        const bool unconditional = conditions[j].empty();
+        const RuleInfo &rule = run.rules[j];
+        for (size_t i = 0; i < j; ++i) {
+            if (impossible[i] || !std::includes(conditions[j].begin(), conditions[j].end(),
+                                                conditions[i].begin(), conditions[i].end()))
+                continue;
+            const RuleInfo &earlier = run.rules[i];
+            reported[j] = true;
+            // the implicit default matters only if some request can reach it
+            const bool setsDefault = j + 1 == count && !unconditionalBefore &&
+                                     ImplicitVerdict(run, rule.name) != ImplicitVerdict(run);
+            if (earlier.action == rule.action && setsDefault)
+                AddFinding(run, 1, "redundant rule", rule.name, rule.text,
+                           "every request it matches is already matched by " + earlier.name + " [" + earlier.text +
+                           "] with the same action",
+                           "keep it anyway: as the last rule it makes unmatched requests " + ImplicitVerdict(run));
+            else if (earlier.action == rule.action)
+                AddFinding(run, 2, "redundant rule", rule.name, rule.text,
+                           "every request it matches is already matched by " + earlier.name + " [" + earlier.text +
+                           "] with the same action", "delete this rule");
+            else
+                AddFinding(run, 3, "unreachable rule", rule.name, rule.text,
+                           "every request it matches is decided first by " + earlier.name + " [" + earlier.text +
+                           "] with the opposite action", "move it above " + earlier.name + " or delete it");
+            break;
+        }
+        unconditionalBefore = unconditionalBefore || unconditional;
+    }
+
+    // what the replayed log shows
+    if (LogFile && !Records.empty()) {
+        for (size_t j = 0; j < count; ++j) {
+            if (impossible[j] || reported[j])
+                continue;
+            const RuleInfo &rule = run.rules[j];
+            if (!rule.decided && !rule.shadowed)
+                AddFinding(run, 1, "no logged request matches", rule.name, rule.text,
+                           "none of the " + std::to_string(Records.size()) + " logged requests match it",
+                           "check whether it is still needed");
+            else if (!rule.decided)
+                AddFinding(run, 2, "never decides in the log", rule.name, rule.text,
+                           "it matches " + std::to_string(rule.shadowed) +
+                           " logged requests, but an earlier rule always decides them first",
+                           "check the rule order or delete it");
+        }
+    }
+
+    std::stable_sort(run.findings.begin(), run.findings.end(), [](const Finding &x, const Finding &y) {
+        return x.severity > y.severity;
+    });
+}
+
+static const char *
+SeverityName(const int severity)
+{
+    return severity >= 3 ? "HIGH" : (severity == 2 ? "MEDIUM" : "LOW");
+}
