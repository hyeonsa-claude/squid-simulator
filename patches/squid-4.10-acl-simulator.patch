+/* driver */
+
+static bool
+ReadLog()
+{
+    std::ifstream file;
+    std::istream *in = &std::cin;
+    if (strcmp(LogFile, "-") != 0) {
+        file.open(LogFile);
+        if (!file) {
+            std::cerr << "squid --simulate: cannot open " << LogFile << std::endl;
+            return false;
+        }
+        in = &file;
+    }
+
+    std::string line;
+    unsigned lineNo = 0;
+    while (std::getline(*in, line)) {
+        ++lineNo;
+        if (!line.empty() && line.back() == '\r')
+            line.pop_back();
+        if (line.empty() || line[0] == '#')
+            continue;
+        Record r;
+        r.lineNo = lineNo;
+        r.parsed = ParseLine(line, r);
+        Records.push_back(r);
+    }
+    return true;
+}
+
+/// replays all records through the currently parsed squid.conf
+static bool
+RunConfig(ConfigRun &run, const bool current, const bool printEach)
+{
+    Acl::Tree *tree = Config.accessList.http;
+    if (!tree) {
+        std::cerr << "squid --simulate: " << run.path << " has no http_access rules" << std::endl;
+        return false;
+    }
+
+    parseEtcHosts(); // hosts_file entries resolve even with --sim-dns off
+    // no live connections to count: "acl maxconn" never matches offline
+    Config.onoff.client_db = 0;
+    const int localPort = LocalPortOption >= 0 ? LocalPortOption :
+                          (HttpPortList != nullptr ? HttpPortList->s.port() : CACHE_HTTP_PORT);
+
+    run.rules = CollectRules(tree);
+    run.decisions.reserve(Records.size());
+    for (auto &r : Records) {
+        run.decisions.push_back(Evaluate(r, run, current, localPort));
+        CountDecision(run, run.decisions.back());
+        if (printEach)
+            PrintDecision(r, run.decisions.back(), run);
+    }
+    return true;
+}
+
+/// runs the simulation and/or the optimizer; returns the process exit code
+static int
+Run()
+{
+    Color = isatty(STDOUT_FILENO);
+    if (LogFile && !ReadLog())
+        return 1;
+
+    ipcache_simulator_mode = DnsMode;
+    fqdncache_simulator_mode = DnsMode;
+    ipcache_init();
+    fqdncache_init();
+    ACLChecklist::Tracer = &Trace;
+
+    // per-request lines only when they are the main output
+    const bool printEach = LogFile && !CompareConf && (!ReportFile || ShowTrace);
+
+    Runs[0].path = ConfigFile;
+    if (!RunConfig(Runs[0], true, printEach))
+        return 1;
+    if (Optimize)
+        Analyze(Runs[0]); // before another squid.conf replaces the parsed one
+
+    if (CompareConf) {
+        Runs[1].path = CompareConf;
+        Acl::ClearConfigNotes();
+        if (parseConfigFile(CompareConf) != 0) {
+            std::cerr << "squid --simulate: errors in " << CompareConf << std::endl;
+            return 1;
+        }
+        if (!RunConfig(Runs[1], false, false))
+            return 1;
+        if (Optimize)
+            Analyze(Runs[1]);
+        if (LogFile)
+            PrintChanges();
+    }
+
+    ACLChecklist::Tracer = nullptr;
+    if (LogFile) {
+        PrintRunSummary(CompareConf ? "current" : "", Runs[0], true);
+        if (CompareConf) {
+            PrintRunSummary("new", Runs[1], false);
+            PrintCompareSummary();
+        }
+    }
+    if (Optimize) {
+        PrintFindings(CompareConf ? "current " : "", Runs[0]);
+        if (CompareConf)
+            PrintFindings("new ", Runs[1]);
+    }
+
+    if (ReportFile) {
+        if (!WriteReport())
+            return 1;
+        std::cout << "\n# report written to " << ReportFile << "\n";
+    }
+    return 0;
+}
