+void
+Acl::NoteConfig(const char *kind, const std::string &message, const char *aclName, const char *aclType)
+{
+    if (!CollectConfigNotes || ParsingDefaults())
+        return;
+    if (!aclName) {
+        aclName = ParsingAcl;
+        aclType = ParsingAclType;
+    }
+    if (!aclName)
+        return; // not parsing (e.g., matching uses the same comparison code)
+    ConfigNote note;
+    note.kind = kind;
+    note.acl = aclName;
+    note.type = aclType ? aclType : "";
+    note.where = std::string(cfg_filename ? cfg_filename : "?") + ":" + std::to_string(config_lineno);
+    note.line = config_input_line;
+    note.message = message;
+    ConfigNotes.push_back(note);
+}
+
+bool
+Acl::SeenValue(const std::string &value)
+{
+    return CollectConfigNotes && ParsingAcl && !SeenValues[ParsingAcl].insert(value).second;
+}
+
+void
+Acl::NoteReference(const char *aclName)
+{
+    if (!CollectConfigNotes)
+        return;
+    std::string key(aclName);
+    for (auto &c : key)
+        c = tolower(static_cast<unsigned char>(c)); // ACL names are case-insensitive
+    ++AclReferences[key];
+}
+
+void
+Acl::ClearConfigNotes()
+{
+    ConfigNotes.clear();
+    AclReferences.clear();
+    SeenValues.clear();
+}
 
