+/* terminal output */
+
+static void
+PrintFindings(const char *label, const ConfigRun &run)
+{
+    std::cout << "\n# optimize " << label << "squid.conf: " << run.path << " (" << run.findings.size() << " findings)\n";
+    for (const auto &f : run.findings) {
+        const char *color = f.severity >= 3 ? "1;31" : (f.severity == 2 ? "1;33" : "36");
+        std::cout << "  " << Paint(Pad(SeverityName(f.severity), 6), color) << "  " << Pad(f.category, 27) <<
+                  "  " << f.subject << "\n" <<
+                  "          " << f.message << "\n";
+        if (!f.where.empty())
+            std::cout << "          at:  " << f.where << "\n";
+        std::cout << "          fix: " << f.fix << "\n";
+    }
+}
+
+static void
+PrintDecision(const Record &r, const Decision &d, const ConfigRun &run)
+{
+    char num[16];
+    snprintf(num, sizeof(num), "%7u", r.lineNo);
+    std::cout << num << "  " << Paint(Pad(d.verdict, 5), VerdictColor(d.verdict)) << "  " <<
+              Pad(d.rule, 16) << "  " << r.clientIp << "  " << r.method << " " << r.url;
+    if (!r.squidStatus.empty()) {
+        std::string vs = d.vsLog;
+        if (vs == "DIFF")
+            vs = Paint(vs, "1;35");
+        std::cout << "  (log " << r.squidStatus << "/" << r.status << ": " << vs << ")";
+    }
+    std::cout << "\n";
+    if (d.verdict == "SKIP") {
+        std::cout << "           " << d.ruleText << "\n";
+        return;
+    }
+    std::cout << "           decided by: " << d.ruleText << "\n";
+    std::cout << "           matching:   " << MatchChain(d);
+    if (d.rule != "implicit")
+        std::cout << "   | without " << Short(d.rule) << ": " << WithoutDecisive(d, run);
+    std::cout << "\n";
+    if (!d.unsure.empty())
+        std::cout << "           " << Paint("not evaluable offline: " + d.unsure, "33") << "\n";
+    if (ShowTrace)
+        std::cout << d.trace;
+}
+
+static bool
+Changed(const Decision &a, const Decision &b)
+{
+    // rule numbers shift when rules are added, so compare the rule text
+    return a.verdict != b.verdict || a.ruleText != b.ruleText;
+}
+
+static void
+PrintChanges()
+{
+    std::cout << "# requests whose result differs between\n#   current: " << Runs[0].path <<
+              "\n#   new:     " << Runs[1].path << "\n";
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Decision &a = Runs[0].decisions[i];
+        const Decision &b = Runs[1].decisions[i];
+        if (!Changed(a, b))
+            continue;
+        const Record &r = Records[i];
+        char num[16];
+        snprintf(num, sizeof(num), "%7u", r.lineNo);
+        const bool verdictChanged = a.verdict != b.verdict;
+        std::cout << num << "  " << Paint(Pad(a.verdict, 5), VerdictColor(a.verdict)) << " -> " <<
+                  Paint(Pad(b.verdict, 5), VerdictColor(b.verdict)) << "  " <<
+                  (verdictChanged ? Paint("VERDICT", "1;35") : std::string("rule   ")) << "  " <<
+                  r.clientIp << "  " << r.method << " " << r.url << "\n" <<
+                  "           current: " << Pad(Short(a.rule), 9) << a.ruleText << "\n" <<
+                  "           new:     " << Pad(Short(b.rule), 9) << b.ruleText << "\n";
+        if (ShowTrace)
+            std::cout << "           current trace:\n" << a.trace << "           new trace:\n" << b.trace;
+    }
+}
+
+static void
+PrintRunSummary(const char *label, const ConfigRun &run, const bool current)
+{
+    std::cout << "\n# " << label << " squid.conf: " << run.path << "\n" <<
+              "#   ALLOW " << run.allowed << "  DENY " << run.denied << "  other " << run.other <<
+              "  skipped " << run.skipped << "  not-evaluable-offline " << run.unsure;
+    if (current)
+        std::cout << "  differs-from-log " << run.differ;
+    std::cout << "\n#   decided  also-matched  rule\n";
+    for (const auto &rule : run.rules) {
+        char counts[64];
+        snprintf(counts, sizeof(counts), "%9u  %12u  ", rule.decided, rule.shadowed);
+        std::cout << "# " << counts << Pad(Short(rule.name), 5) << " " << rule.text <<
+                  (rule.decided ? "" : "   <- never decides") << "\n";
+    }
+    char counts[64];
+    snprintf(counts, sizeof(counts), "%9u  %12s  ", run.implicitHits, "-");
+    std::cout << "# " << counts << "implicit " << ImplicitVerdict(run) << "\n";
+}
+
+static void
+PrintCompareSummary()
+{
+    std::map<std::string, unsigned> transitions;
+    unsigned verdictChanges = 0, ruleChanges = 0;
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Decision &a = Runs[0].decisions[i];
+        const Decision &b = Runs[1].decisions[i];
+        if (!Changed(a, b))
+            continue;
+        if (a.verdict != b.verdict)
+            ++verdictChanges;
+        else
+            ++ruleChanges;
+        ++transitions[a.verdict + " " + Short(a.rule) + " -> " + b.verdict + " " + Short(b.rule)];
+    }
+    std::vector<std::pair<std::string, unsigned> > sorted(transitions.begin(), transitions.end());
+    std::sort(sorted.begin(), sorted.end(), [](const std::pair<std::string, unsigned> &x, const std::pair<std::string, unsigned> &y) {
+        return x.second > y.second;
+    });
+    std::cout << "\n# changes: " << verdictChanges << " verdict changes, " << ruleChanges <<
+              " deciding-rule changes (same verdict)\n";
+    for (const auto &t : sorted)
+        std::cout << "# " << Pad(std::to_string(t.second), 9) << " " << t.first << "\n";
+}
+
+/* HTML report */
+
+static std::string
+Esc(const std::string &s)
+{
+    std::string out;
+    out.reserve(s.size());
+    for (const char c : s) {
+        switch (c) {
+        case '&':
+            out += "&amp;";
+            break;
+        case '<':
+            out += "&lt;";
+            break;
+        case '>':
+            out += "&gt;";
+            break;
+        case '"':
+            out += "&quot;";
+            break;
+        default:
+            out += c;
+        }
+    }
+    return out;
+}
+
+static std::string
+Pill(const std::string &verdict)
+{
+    return "<span class=\"pill " + Lower(verdict) + "\">" + Esc(verdict) + "</span>";
+}
+
+typedef std::vector<std::pair<std::string, unsigned> > Counts;
+
+static Counts
+Top(const std::map<std::string, unsigned> &counts, const size_t limit)
+{
+    Counts result(counts.begin(), counts.end());
+    std::sort(result.begin(), result.end(), [](const std::pair<std::string, unsigned> &x, const std::pair<std::string, unsigned> &y) {
+        return x.second > y.second || (x.second == y.second && x.first < y.first);
+    });
+    if (result.size() > limit)
+        result.resize(limit);
+    return result;
+}
+
+static void
+ReportCard(std::ostream &out, const char *label, const unsigned value, const char *cls)
+{
+    out << "<div class=\"card " << cls << "\"><div class=\"label\">" << label <<
+        "</div><div class=\"value\">" << value << "</div></div>";
+}
+
+static void
+ReportRules(std::ostream &out, const ConfigRun &run, const std::set<std::string> &otherTexts, const bool compare)
+{
+    unsigned most = 1;
+    for (const auto &rule : run.rules)
+        most = std::max(most, rule.decided);
+    most = std::max(most, run.implicitHits);
+
+    out << "<table class=\"rules\"><thead><tr><th>#</th><th>action</th><th>rule</th>"
+        "<th class=\"num\">decided</th><th class=\"barcol\"></th><th class=\"num\">also matched</th></tr></thead><tbody>";
+    for (const auto &rule : run.rules) {
+        const bool unique = compare && !otherTexts.count(rule.text);
+        out << "<tr" << (rule.decided ? "" : " class=\"unused\"") << "><td>" << Esc(Short(rule.name)) <<
+            "</td><td>" << Pill(rule.action == "allow" ? "ALLOW" : "DENY") << "</td><td class=\"mono\">" <<
+            Esc(rule.text) << (unique ? " <span class=\"tag\">only here</span>" : "") <<
+            (rule.decided ? "" : " <span class=\"tag muted\">never decides</span>") <<
+            "</td><td class=\"num\">" << rule.decided << "</td><td class=\"barcol\"><div class=\"bar " << rule.action <<
+            "\"><span style=\"width:" << (100.0 * rule.decided / most) << "%\"></span></div></td><td class=\"num\">" <<
+            rule.shadowed << "</td></tr>";
+    }
+    out << "<tr><td>-</td><td>" << Pill(ImplicitVerdict(run)) << "</td><td class=\"mono\">implicit (no rule matched)</td>"
+        "<td class=\"num\">" << run.implicitHits << "</td><td class=\"barcol\"><div class=\"bar\"><span style=\"width:" <<
+        (100.0 * run.implicitHits / most) << "%\"></span></div></td><td class=\"num\">-</td></tr></tbody></table>";
+}
+
+/// for every rule that denied something: what, who, and what would allow it
+static void
+ReportDenials(std::ostream &out, const ConfigRun &run)
+{
+    class DenyInfo
+    {
+    public:
+        unsigned count = 0;
+        std::string text;
+        std::map<std::string, unsigned> hosts, clients, alternatives;
+    };
+    std::map<std::string, DenyInfo> byRule;
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Decision &d = run.decisions[i];
+        if (d.verdict != "DENY")
+            continue;
+        DenyInfo &info = byRule[d.rule];
+        ++info.count;
+        info.text = d.ruleText;
+        ++info.hosts[Records[i].host];
+        ++info.clients[Records[i].clientIp];
+        const std::string allow = FirstMatching(d, "allow");
+        ++info.alternatives[allow.empty() ? "no allow rule matches" : "allowed by " + allow];
+    }
+    if (byRule.empty()) {
+        out << "<p class=\"muted\">No request is denied.</p>";
+        return;
+    }
+
+    std::vector<std::pair<std::string, const DenyInfo *> > sorted;
+    for (const auto &entry : byRule)
+        sorted.push_back(std::make_pair(entry.first, &entry.second));
+    std::sort(sorted.begin(), sorted.end(), [](const std::pair<std::string, const DenyInfo *> &x, const std::pair<std::string, const DenyInfo *> &y) {
+        return x.second->count > y.second->count;
+    });
+
+    for (const auto &entry : sorted) {
+        const DenyInfo &info = *entry.second;
+        out << "<div class=\"deny\"><div class=\"denyhead\">" << Pill("DENY") << " <b>" << Esc(entry.first) <<
+            "</b> <span class=\"mono\">" << Esc(info.text) << "</span><span class=\"count\">" << info.count <<
+            " requests</span></div><div class=\"cols\">";
+        const char *titles[] = { "Top destinations", "Top clients", "Next matching allow rule" };
+        const std::map<std::string, unsigned> *maps[] = { &info.hosts, &info.clients, &info.alternatives };
+        for (int k = 0; k < 3; ++k) {
+            out << "<div><h4>" << titles[k] << "</h4><ol>";
+            for (const auto &item : Top(*maps[k], 10))
+                out << "<li><span class=\"mono\">" << Esc(item.first) << "</span> <span class=\"muted\">" << item.second << "</span></li>";
+            out << "</ol></div>";
+        }
+        out << "</div></div>";
+    }
+}
+
+static std::string
+TraceOf(const ConfigRun &run, const Record &r, const Decision &d)
+{
+    const auto it = run.traceAt.find(r.clientIp + "\x1f" + r.method + "\x1f" + r.host + "\x1f" + d.verdict + "\x1f" + d.rule);
+    return it == run.traceAt.end() ? std::string() : run.decisions[it->second].trace;
+}
+
+/// distinct (client, method, destination, outcome) groups
+static void
+ReportRequests(std::ostream &out, const bool compare)
+{
+    class Group
+    {
+    public:
+        unsigned count = 0;
+        size_t first = 0;
+    };
+    std::map<std::string, Group> groups;
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Record &r = Records[i];
+        const Decision &a = Runs[0].decisions[i];
+        std::string key = r.clientIp + "\x1f" + r.method + "\x1f" + r.host + "\x1f" + a.verdict + "\x1f" + a.rule;
+        if (compare)
+            key += "\x1f" + Runs[1].decisions[i].verdict + "\x1f" + Runs[1].decisions[i].rule;
+        Group &g = groups[key];
+        if (!g.count++)
+            g.first = i;
+    }
+    std::vector<const Group *> sorted;
+    for (const auto &entry : groups)
+        sorted.push_back(&entry.second);
+    std::sort(sorted.begin(), sorted.end(), [](const Group *x, const Group *y) {
+        return x->count > y->count || (x->count == y->count && x->first < y->first);
+    });
+
+    out << "<div class=\"filters\"><input id=\"req-q\" type=\"search\" placeholder=\"Filter: client, host, rule...\" oninput=\"applyFilter('req')\">"
+        "<select id=\"req-v\" onchange=\"applyFilter('req')\"><option value=\"\">all verdicts</option>"
+        "<option>ALLOW</option><option>DENY</option><option>AUTH</option><option>DUNNO</option><option>SKIP</option></select>";
+    if (compare)
+        out << "<label><input id=\"req-c\" type=\"checkbox\" onchange=\"applyFilter('req')\"" <<
+            " checked> changed only</label>";
+    out << "</div>";
+    if (sorted.size() > ReportRowLimit)
+        out << "<p class=\"muted\">Showing the " << ReportRowLimit << " largest of " << sorted.size() << " groups.</p>";
+
+    out << "<table id=\"req\" class=\"requests\"><thead><tr><th class=\"num\">count</th><th>client</th><th>method</th>"
+        "<th>destination</th><th>" << (compare ? "current" : "verdict") << "</th><th>decided by</th><th>matching rules</th>";
+    if (compare)
+        out << "<th>new</th><th>decided by (new)</th>";
+    out << "<th>first line</th></tr></thead><tbody>";
+
+    size_t shown = 0;
+    for (const Group *g : sorted) {
+        if (++shown > ReportRowLimit)
+            break;
+        const Record &r = Records[g->first];
+        const Decision &a = Runs[0].decisions[g->first];
+        const bool changed = compare && Changed(a, Runs[1].decisions[g->first]);
+        out << "<tr data-verdict=\"" << Esc(a.verdict) << "\" data-changed=\"" << (changed ? 1 : 0) << "\"" <<
+            (changed ? " class=\"changed\"" : "") << "><td class=\"num\">" << g->count << "</td><td class=\"mono\">" <<
+            Esc(r.clientIp) << "</td><td>" << Esc(r.method) << "</td><td class=\"mono\">" << Esc(r.host) <<
+            "</td><td>" << Pill(a.verdict) << "</td><td><details><summary>" << Esc(Short(a.rule)) <<
+            "</summary><div class=\"mono small\">" << Esc(a.ruleText) << "</div><pre>" << Esc(TraceOf(Runs[0], r, a)) <<
+            "</pre></details></td><td class=\"mono small\">" << Esc(MatchChain(a)) << "</td>";
+        if (compare) {
+            const Decision &b = Runs[1].decisions[g->first];
+            out << "<td>" << Pill(b.verdict) << "</td><td><details><summary>" << Esc(Short(b.rule)) <<
+                "</summary><div class=\"mono small\">" << Esc(b.ruleText) << "</div><pre>" << Esc(TraceOf(Runs[1], r, b)) <<
+                "</pre></details></td>";
+        }
+        out << "<td class=\"num\">" << r.lineNo << "</td></tr>";
+    }
+    out << "</tbody></table>";
+}
+
+static void
+ReportTransitions(std::ostream &out)
+{
+    std::map<std::string, unsigned> counts;
+    std::map<std::string, size_t> example;
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Decision &a = Runs[0].decisions[i];
+        const Decision &b = Runs[1].decisions[i];
+        if (!Changed(a, b))
+            continue;
+        const std::string key = a.verdict + "\x1f" + a.rule + "\x1f" + b.verdict + "\x1f" + b.rule;
+        if (!counts[key]++)
+            example[key] = i;
+    }
+    if (counts.empty()) {
+        out << "<p class=\"muted\">No request changes its verdict or deciding rule.</p>";
+        return;
+    }
+    out << "<table class=\"requests\"><thead><tr><th class=\"num\">requests</th><th>current</th><th>rule</th>"
+        "<th></th><th>new</th><th>rule</th><th>example</th></tr></thead><tbody>";
+    for (const auto &t : Top(counts, ReportRowLimit)) {
+        const size_t i = example[t.first];
+        const Decision &a = Runs[0].decisions[i];
+        const Decision &b = Runs[1].decisions[i];
+        out << "<tr" << (a.verdict != b.verdict ? " class=\"changed\"" : "") << "><td class=\"num\">" << t.second <<
+            "</td><td>" << Pill(a.verdict) << "</td><td class=\"mono small\"><b>" << Esc(Short(a.rule)) << "</b> " <<
+            Esc(a.ruleText) << "</td><td>&rarr;</td><td>" << Pill(b.verdict) << "</td><td class=\"mono small\"><b>" <<
+            Esc(Short(b.rule)) << "</b> " << Esc(b.ruleText) << "</td><td class=\"mono small\">" <<
+            Esc(Records[i].clientIp + " " + Records[i].method + " " + Records[i].url) << "</td></tr>";
+    }
+    out << "</tbody></table>";
+}
+
+static void
+ReportLogDifferences(std::ostream &out)
+{
+    std::map<std::string, unsigned> counts;
+    std::map<std::string, size_t> example;
+    for (size_t i = 0; i < Records.size(); ++i) {
+        const Decision &d = Runs[0].decisions[i];
+        if (d.vsLog != "DIFF")
+            continue;
+        const Record &r = Records[i];
+        const std::string key = r.clientIp + "\x1f" + r.host + "\x1f" + r.squidStatus + "\x1f" + d.verdict + "\x1f" + d.rule;
+        if (!counts[key]++)
+            example[key] = i;
+    }
+    if (counts.empty()) {
+        out << "<p class=\"muted\">Every evaluable request matches what access.log recorded.</p>";
+        return;
+    }
+    out << "<p class=\"muted\">TCP_DENIED can also come from directives other than http_access "
+        "(miss_access, adapted_http_access, ssl_bump, ...) or from a config that changed after logging.</p>"
+        "<table class=\"requests\"><thead><tr><th class=\"num\">requests</th><th>client</th><th>destination</th>"
+        "<th>logged</th><th>simulated</th><th>decided by</th></tr></thead><tbody>";
+    for (const auto &t : Top(counts, ReportRowLimit)) {
+        const size_t i = example[t.first];
+        const Record &r = Records[i];
+        const Decision &d = Runs[0].decisions[i];
+        out << "<tr><td class=\"num\">" << t.second << "</td><td class=\"mono\">" << Esc(r.clientIp) <<
+            "</td><td class=\"mono\">" << Esc(r.host) << "</td><td class=\"mono\">" << Esc(r.squidStatus + "/" + r.status) <<
+            "</td><td>" << Pill(d.verdict) << "</td><td class=\"mono small\"><b>" << Esc(Short(d.rule)) << "</b> " <<
+            Esc(d.ruleText) << "</td></tr>";
+    }
+    out << "</tbody></table>";
+}
+
+static void
+ReportFindings(std::ostream &out, const ConfigRun &run)
+{
+    if (run.findings.empty()) {
+        out << "<p class=\"muted\">Nothing to optimize.</p>";
+        return;
+    }
+    out << "<table class=\"requests\"><thead><tr><th>severity</th><th>finding</th><th>subject</th>"
+        "<th>details</th><th>suggestion</th></tr></thead><tbody>";
+    for (const auto &f : run.findings) {
+        out << "<tr><td>" << Pill(SeverityName(f.severity)) << "</td><td>" << Esc(f.category) <<
+            "</td><td class=\"mono\">" << Esc(f.subject) << "</td><td>" << Esc(f.message);
+        if (!f.where.empty())
+            out << "<div class=\"mono small muted\">" << Esc(f.where) << "</div>";
+        out << "</td><td>" << Esc(f.fix) << "</td></tr>";
+    }
+    out << "</tbody></table>";
+}
