# Build target of this branch: Ubuntu 26.04 LTS (resolute) ships squid 7.2 at release
# and squid 7.7 in resolute-updates (7.7-0ubuntu0.26.04.1, published 2026-10-22).
TARGET_OS="Ubuntu 26.04 LTS (resolute)"
SQUID_VERSION=7.7
SQUID_TARBALL=squid-7.7.tar.xz
SQUID_URL=https://github.com/squid-cache/squid/releases/download/SQUID_7_7/squid-7.7.tar.xz
# Ubuntu's orig tarball is byte-identical to the upstream release
SQUID_URL_MIRROR=https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/squid/7.7-0ubuntu0.26.04.1/squid_7.7.orig.tar.xz
SQUID_SHA256=e3bd613b91b1c498ec2992276063342a85cd6edddd5521294e04f44bc055da9b
PATCH_FILE=patches/squid-7.7-acl-simulator.patch

# Ubuntu's source patches that change squid itself (defaults in cf.data.pre and an
# internal.cc fix). Skipped: 0002 (install paths, set by configure options below)
# and 0005 (systemd unit file).
DISTRO_DEBIAN_URL=https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/squid/7.7-0ubuntu0.26.04.1/squid_7.7-0ubuntu0.26.04.1.debian.tar.xz
DISTRO_DEBIAN_SHA256=dae5ae79248276c1a9d93629bf01b4d7b8bd00d38bbb26b966a63fc1a2191e90
DISTRO_PATCHES="0001-Default-configuration-file-for-debian.patch 0006-upstream-807ae4df2164defbb5f59b99282e24010b4a0b85.patch 90-cf.data.ubuntu.patch 99-ubuntu-ssl-cert-snakeoil.patch"

# Packages needed to build (apt-get install), from the package's Build-Depends
BUILD_DEPS="build-essential pkgconf libltdl-dev libgnutls28-dev nettle-dev libcap2-dev libcrypt-dev libecap3-dev libxml2-dev libexpat1-dev libnetfilter-conntrack-dev libsystemd-dev libcppunit-dev"

# Core options of Ubuntu's "squid" package (the GnuTLS flavour; squid-openssl is a
# separate package), from debian/rules, without the optional authentication/external
# helpers: those are separate programs and do not change how squid parses squid.conf
# or evaluates ACLs.
CONFIGURE_OPTS="--prefix=/usr --sysconfdir=/etc/squid --localstatedir=/var --libexecdir=/usr/lib/squid
 --datadir=/usr/share/squid --mandir=/usr/share/man --with-logdir=/var/log/squid --with-pidfile=/run/squid.pid
 --with-swapdir=/var/spool/squid --with-default-user=proxy --with-filedescriptors=65536 --with-large-files
 --enable-inline --disable-arch-native --enable-async-io=8 --enable-storeio=ufs,aufs,diskd,rock
 --enable-removal-policies=lru,heap --enable-delay-pools --enable-cache-digests --enable-icap-client
 --enable-follow-x-forwarded-for --enable-auth-basic=fake --enable-auth-digest=file
 --enable-auth-negotiate=wrapper --enable-auth-ntlm=fake --enable-external-acl-helpers=file_userip
 --enable-security-cert-validators=fake --enable-storeid-rewrite-helpers=file --enable-url-rewrite-helpers=fake
 --enable-eui --enable-icmp --enable-zph-qos --enable-ecap --disable-translation
 --enable-linux-netfilter --with-systemd --with-gnutls"
