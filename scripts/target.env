# Build target of this branch: Ubuntu 20.04 LTS ships squid 4.10.
TARGET_OS="Ubuntu 20.04 LTS (focal)"
SQUID_VERSION=4.10
SQUID_TARBALL=squid-4.10.tar.gz
SQUID_URL=http://www.squid-cache.org/Versions/v4/squid-4.10.tar.gz
SQUID_URL_MIRROR=https://github.com/squid-cache/squid/releases/download/SQUID_4_10/squid-4.10.tar.gz
SQUID_SHA256=df0685e851a1b68eede3790423986e30f4e162e9f7cd1cf92dbea65177201c8f
PATCH_FILE=patches/squid-4.10-acl-simulator.patch

# Distribution source patches applied before ours (none for this branch)
DISTRO_DEBIAN_URL=
DISTRO_DEBIAN_SHA256=
DISTRO_PATCHES=

# Packages needed to build (apt-get install)
BUILD_DEPS="build-essential pkg-config libltdl-dev libgnutls28-dev libcap-dev libecap3-dev libxml2-dev libexpat1-dev libnetfilter-conntrack-dev libcppunit-dev"

# Core options of Ubuntu's squid 4.10 package (squid -v), without the optional
# authentication/external helpers: those are separate programs and do not change
# how squid parses squid.conf or evaluates ACLs.
CONFIGURE_OPTS="--prefix=/usr --sysconfdir=/etc/squid --localstatedir=/var --libexecdir=/usr/lib/squid
 --datadir=/usr/share/squid --with-logdir=/var/log/squid --with-pidfile=/var/run/squid.pid
 --with-swapdir=/var/spool/squid --with-default-user=proxy --with-filedescriptors=65536 --with-large-files
 --enable-inline --disable-arch-native --enable-async-io=8 --enable-storeio=ufs,aufs,diskd,rock
 --enable-removal-policies=lru,heap --enable-delay-pools --enable-cache-digests --enable-icap-client
 --enable-follow-x-forwarded-for --enable-auth-basic=fake --enable-auth-digest=file
 --enable-auth-negotiate=wrapper --enable-auth-ntlm=fake --enable-external-acl-helpers=file_userip
 --enable-security-cert-validators=fake --enable-storeid-rewrite-helpers=file --enable-url-rewrite-helpers=fake
 --enable-eui --enable-esi --enable-icmp --enable-zph-qos --enable-ecap --disable-translation
 --with-gnutls --enable-linux-netfilter"
