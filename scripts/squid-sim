#!/usr/bin/env python3
"""squid-sim: one entry point for the squid simulator and the squid cache manager.

Simulator (runs the patched squid binary built by scripts/build.sh; options pass through):
  squid-sim -f /etc/squid/squid.conf --simulate access.log [--sim-compare new.conf] [--optimize] [--report out.html]
  squid-sim                                   uses squid_conf and access_log from squid-sim.conf
  squid-sim --convert access.log              print the log converted to simulformat

The log may use any squid logformat. squid-sim.conf (--sim-conf FILE, $SQUID_SIM_CONF,
/etc/squid/squid-sim.conf, or squid-sim.conf next to scripts/) says which one; by default the
format is detected from the log, trying the format squid.conf's access_log writes first.
squid-sim converts other formats to simulformat before squid reads them (.gz logs too).

Cache manager of a running squid (read-only HTTP GETs to /squid-internal-mgr/):
  squid-sim --manager                         filtered snapshot of the main pages
  squid-sim -m --page ipcache                 one page, filtered (like curl .../squid-internal-mgr/ipcache)
  squid-sim -m --page ipcache --raw           one page exactly as squid returns it
  squid-sim -m --report 60m [--interval 60s]  record for 60 minutes, then write a report

Noise is left out unless --include-local is given: loopback clients, /etc/hosts entries,
localhost names, and the manager's own requests (also subtracted from request counters).
Python 3.8+ standard library only.
"""

import argparse
import base64
import calendar
import datetime
import glob
import gzip
import html
import http.client
import io
import ipaddress
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_PAGES = ["info", "counters", "client_list", "ipcache", "fqdncache", "active_requests"]
STATE_CHANGING = {"shutdown", "reconfigure", "rotate", "offline_toggle", "kill", "restart"}
COUNTER_KEYS = ["client_http.requests", "client_http.hits", "client_http.errors",
                "client_http.kbytes_in", "client_http.kbytes_out", "server.all.requests",
                "server.all.errors", "dns.queries"]
LOCAL_NAMES = re.compile(r"^(localhost|ip6-[a-z]+)(\.|$)", re.I)


def parse_duration(text):
    """
    ########
    # parse_duration -> float (초)
    # "60m", "1h", "90s", "1h30m" 같은 기간을 초로 바꾼다. 단위 없는 숫자는 분으로 본다.
    # 형식이 틀리면 argparse 오류를 낸다.
    ########
    """
    text = text.strip().lower()
    if re.fullmatch(r"\d+(\.\d+)?", text):
        return float(text) * 60
    parts = re.findall(r"(\d+(?:\.\d+)?)([hms])", text)
    if not parts or "".join(n + u for n, u in parts) != text:
        raise argparse.ArgumentTypeError("expected a duration such as 60m, 1h, 30s or 1h30m: %r" % text)
    return sum(float(n) * {"h": 3600, "m": 60, "s": 1}[u] for n, u in parts)


def fmt_duration(seconds):
    """
    ########
    # fmt_duration -> str ("1h5m3s" 형식)
    # 초를 사람이 읽기 쉬운 기간 문자열로 바꾼다.
    ########
    """
    seconds = int(round(seconds))
    h, rest = divmod(seconds, 3600)
    m, s = divmod(rest, 60)
    return ("%dh" % h if h else "") + ("%dm" % m if m else "") + ("%ds" % s if s or not (h or m) else "")


def is_local_addr(text):
    """
    ########
    # is_local_addr -> bool
    # 주소가 loopback(127.0.0.0/8, ::1, IPv4 매핑 포함)이거나 미지정 주소(0.0.0.0, ::)인지. 주소가 아니면 False.
    ########
    """
    text = text.strip().strip("[]")
    try:
        ip = ipaddress.ip_address(text)
    except ValueError:
        return False
    if ip.version == 6 and ip.ipv4_mapped:
        ip = ip.ipv4_mapped
    return ip.is_loopback or ip.is_unspecified


def is_ip_literal(text):
    """
    ########
    # is_ip_literal -> bool
    # 문자열이 IP 주소인지(대괄호 IPv6 허용).
    ########
    """
    try:
        ipaddress.ip_address(text.strip("[]"))
        return True
    except ValueError:
        return False


def first_http_port(conf):
    """
    ########
    # first_http_port -> str ("http://호스트:포트")
    # squid.conf(include 포함)의 첫 일반 http_port로 캐시 매니저 주소를 만든다. intercept, transparent, tproxy 포트는
    # 매니저 요청을 받지 않으므로 건너뛴다. 모든 주소에서 듣는 포트면 127.0.0.1을 쓰고, 없으면 127.0.0.1:3128.
    ########
    """
    for line in squid_conf_lines(conf):
        words = line.split()
        if words[0] != "http_port" or len(words) < 2:
            continue
        if any(w in ("intercept", "transparent", "tproxy") for w in words[2:]):
            continue
        spec = words[1]
        port = spec.rsplit(":", 1)[-1] if ":" in spec else spec
        if port.isdigit():
            host = spec.rsplit(":", 1)[0] if ":" in spec else "127.0.0.1"
            if host in ("", "0.0.0.0", "[::]", "*"):
                host = "127.0.0.1"
            return "http://%s:%s" % (host, port)
    return "http://127.0.0.1:3128"


class Manager:
    """
    ########
    # Manager -> 클래스: 실행 중인 squid의 캐시 매니저 연결
    # base: .../squid-internal-mgr 주소, headers: User-Agent와 (비밀번호가 있으면) Basic 인증,
    # opener: 환경 변수의 프록시를 거치지 않는 연결, own_addr: squid가 보는 이 도구의 주소,
    # requests/kbytes: 이 도구가 보낸 조회 수와 받은 양(카운터에서 빼기 위해).
    ########
    """
    def __init__(self, base, password=None, timeout=15):
        """
        ########
        # __init__ -> None
        # 주소 끝에 /squid-internal-mgr를 붙이고, 비밀번호가 있으면 "manager:비밀번호" Basic 인증 헤더를 만든다.
        # squid에 직접 연결하도록 빈 ProxyHandler를 쓰고, 연결에 쓸 출발 주소를 미리 구해 둔다.
        ########
        """
        self.base = base.rstrip("/")
        if not self.base.endswith("/squid-internal-mgr"):
            self.base += "/squid-internal-mgr"
        self.timeout = timeout
        self.headers = {"User-Agent": "squid-sim-manager"}
        if password:
            token = base64.b64encode(("manager:%s" % password).encode()).decode()
            self.headers["Authorization"] = "Basic " + token
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        self.own_addr = source_address(self.base)
        self.requests = 0
        self.kbytes = 0.0

    def get(self, page):
        """
        ########
        # get -> str (페이지 본문)
        # 매니저 페이지 하나를 GET으로 읽는다. 성공하면 자기 조회 수와 받은 KB를 센다. 실패하면 예외를 그대로 던진다.
        ########
        """
        req = urllib.request.Request("%s/%s" % (self.base, page), headers=self.headers)
        with self.opener.open(req, timeout=self.timeout) as resp:
            body = resp.read()
        self.requests += 1
        self.kbytes += len(body) / 1024.0
        return body.decode("utf-8", errors="replace")


def kid_blocks(text):
    """
    ########
    # kid_blocks -> list[str] (워커별 본문)
    # squid 5 이상은 SMP 페이지를 "by kidN { ... } by kidN"으로 감싼다. 그 안쪽 본문들을 돌려주고,
    # 감싸지 않은 squid 4 출력이면 전체를 한 덩어리로 돌려준다.
    ########
    """
    blocks, current, inside = [], [], False
    for line in text.splitlines():
        if re.match(r"^by kid\d+ \{\s*$", line):
            inside, current = True, []
            continue
        if re.match(r"^\} by kid\d+\s*$", line):
            blocks.append("\n".join(current))
            inside = False
            continue
        if inside:
            current.append(line)
    return blocks if blocks else [text]


def parse_info(text):
    """
    ########
    # parse_info -> dict (version, clients, uptime, cpu_pct, rss_kb, fd_in_use, fd_max, mem_kb, hit_pct_5min 등)
    # info 페이지에서 버전과 주요 수치를 정규식으로 뽑는다. 없는 항목은 넣지 않는다.
    ########
    """
    info = {}
    m = re.search(r"Squid Object Cache: Version (\S+)", text)
    if m:
        info["version"] = m.group(1)
    patterns = {
        "clients": r"Number of clients accessing cache:\s*(\d+)",
        "http_requests": r"Number of HTTP requests received:\s*(\d+)",
        "uptime": r"UP Time:\s*([\d.]+)",
        "cpu_pct": r"CPU Usage:\s*([\d.]+)%",
        "rss_kb": r"Maximum Resident Size:\s*(\d+)",
        "fd_in_use": r"Number of file desc currently in use:\s*(\d+)",
        "fd_max": r"Maximum number of file descriptors:\s*(\d+)",
        "mem_kb": r"Storage Mem size:\s*(\d+)",
        "hit_pct_5min": r"Hits as % of all requests:\s*5min:\s*([\d.-]+)%",
    }
    for key, pattern in patterns.items():
        m = re.search(pattern, text)
        if m:
            info[key] = float(m.group(1))
    return info


def parse_counters(text):
    """
    ########
    # parse_counters -> dict (카운터 이름 -> 값)
    # counters 페이지의 "이름 = 값" 줄을 읽어 워커별 값을 더한다. sample_time은 뺀다.
    ########
    """
    counters = {}
    for block in kid_blocks(text):
        for line in block.splitlines():
            m = re.match(r"^([\w.]+) = ([\d.]+)", line)
            if m and m.group(1) != "sample_time":
                counters[m.group(1)] = counters.get(m.group(1), 0) + float(m.group(2))
    return counters


def parse_client_list(text):
    """
    ########
    # parse_client_list -> dict (주소 -> {name, http, codes})
    # client_list 페이지에서 클라이언트마다 이름, HTTP 요청 수, 결과 코드별 수를 읽는다(ICP 구역은 무시).
    # 워커별 값은 더한다.
    ########
    """
    clients = {}
    for block in kid_blocks(text):
        current = None
        for line in block.splitlines():
            m = re.match(r"^Address:\s*(\S+)", line)
            if m:
                current = clients.setdefault(m.group(1), {"name": "", "http": 0, "codes": {}})
                continue
            if current is None:
                continue
            if line.startswith("TOTALS"):
                current = None
                continue
            m = re.match(r"^Name:\s*(\S+)", line)
            if m:
                current["name"] = m.group(1)
                continue
            m = re.match(r"^\s+HTTP\s+Requests\s+(\d+)", line)
            if m:
                current["http"] += int(m.group(1))
                current["section"] = "http"
                continue
            m = re.match(r"^\s+ICP\s+Requests\s+(\d+)", line)
            if m:
                current["section"] = "icp"
                continue
            m = re.match(r"^\s+([A-Z_]+)\s+(\d+)\s+\d+%", line)
            if m and current.get("section") == "http":
                current["codes"][m.group(1)] = current["codes"].get(m.group(1), 0) + int(m.group(2))
    for c in clients.values():
        c.pop("section", None)
    return clients


def parse_ipcache(text):
    """
    ########
    # parse_ipcache -> dict (호스트 이름 -> {flags, ttl, ips:[(주소, 정상 여부)]})
    # ipcache 표를 고정 폭(이름 32칸, 플래그 2칸)으로 읽는다. 주소가 다음 줄로 이어지면 앞 항목에 붙인다.
    # 플래그 H는 hosts_file 항목, N은 실패해 부정 캐시된 항목.
    ########
    """
    entries = {}
    for block in kid_blocks(text):
        in_table, last = False, None
        for line in block.splitlines():
            if line.strip().startswith("Hostname") and "Flg" in line:
                in_table = True
                continue
            if not in_table or not line.strip():
                continue
            ips = re.findall(r"(\S+)-(OK|BAD)\b", line)
            m = re.match(r"^ (.{32}) (..)\s+(-?\d+)\s+(-?\d+)\s+(\d+)\(\s*\d+\)", line)
            if m:
                name, flags = m.group(1).strip(), m.group(2).strip()
                last = entries.setdefault(name, {"flags": flags, "ttl": int(m.group(4)), "ips": []})
                last["flags"] = flags
                for ip, status in ips:
                    if (ip, status == "OK") not in last["ips"]:
                        last["ips"].append((ip, status == "OK"))
            elif last is not None and ips:
                for ip, status in ips:
                    if (ip, status == "OK") not in last["ips"]:
                        last["ips"].append((ip, status == "OK"))
    return entries


def parse_fqdncache(text):
    """
    ########
    # parse_fqdncache -> dict (주소 -> {flags, names})
    # fqdncache 표를 고정 폭(주소 45칸)으로 읽어 역방향 이름과 플래그를 얻는다.
    ########
    """
    entries = {}
    for block in kid_blocks(text):
        in_table = False
        for line in block.splitlines():
            if line.startswith("Address") and "Hostnames" in line:
                in_table = True
                continue
            if not in_table or not line.strip():
                continue
            addr, rest = line[:45].strip(), line[45:]
            m = re.match(r"^\s*([HN ]{0,2})\s+(-?\d+)\s+(\d+)\s*(.*)$", rest)
            if not addr or not m:
                continue
            entries[addr] = {"flags": m.group(1).strip(), "names": m.group(4).split()}
    return entries


def parse_active(text):
    """
    ########
    # parse_active -> list[dict] (client, uri, logtype, age, user)
    # active_requests 페이지에서 진행 중인 요청마다 클라이언트, URL, 로그 종류, 경과 초, 사용자를 읽는다.
    # "Connection:"마다 클라이언트를 지워, remote 줄이 없는 요청이 앞 요청의 클라이언트를 물려받지 않게 한다.
    ########
    """
    reqs = []
    for block in kid_blocks(text):
        remote = None
        req = None
        for line in block.splitlines():
            s = line.strip()
            if s.startswith("Connection:"):
                remote = None
            m = re.match(r"^remote:\s*(\S+)", s)
            if m:
                remote = m.group(1).rsplit(":", 1)[0].strip("[]")
                continue
            if s.startswith("uri "):
                req = {"client": remote or "", "uri": s[4:].strip(), "logtype": "", "age": 0.0, "user": "-"}
                reqs.append(req)
                continue
            if req is None:
                continue
            if s.startswith("logType "):
                req["logtype"] = s.split(None, 1)[1]
            m = re.match(r"^start\s+[\d.]+\s+\(([\d.]+) seconds ago\)", s)
            if m:
                req["age"] = float(m.group(1))
            if s.startswith("username "):
                req["user"] = s.split(None, 1)[1]
    return reqs


def filter_snapshot(snap, include_local, own_addr=None):
    """
    ########
    # filter_snapshot -> dict (걸러낸 사본)
    # 의미 없는 항목을 뺀다: loopback과 이 도구가 쓰는 출발 주소의 클라이언트, hosts_file·localhost·IP 그대로인 DNS 이름,
    # loopback 역방향 항목, 매니저 조회 자신의 진행 중 요청. 조회하지 않았거나 실패한 페이지의 구역은 만들지 않는다.
    # --include-local이면 그대로 돌려준다.
    ########
    """
    out = dict(snap)
    if include_local:
        return out

    def ours(addr):
        """
        ########
        # ours -> bool
        # 주소가 loopback이거나 이 도구가 squid에 연결할 때 쓰는 주소인지.
        ########
        """
        return is_local_addr(addr) or (own_addr is not None and same_addr(addr, own_addr))

    if "clients" in snap:
        out["clients"] = {a: c for a, c in snap["clients"].items() if not ours(a)}
    if "ipcache" in snap:
        out["ipcache"] = {h: e for h, e in snap["ipcache"].items()
                          if "H" not in e["flags"] and not LOCAL_NAMES.match(h) and not is_ip_literal(h)}
    if "fqdncache" in snap:
        out["fqdncache"] = {a: e for a, e in snap["fqdncache"].items()
                            if "H" not in e["flags"] and not is_local_addr(a)}
    if "active" in snap:
        out["active"] = [r for r in snap["active"]
                         if "/squid-internal-mgr/" not in r["uri"] and not r["uri"].startswith("cache_object:")
                         and not ours(r["client"])]
    return out


def same_addr(a, b):
    """
    ########
    # same_addr -> bool
    # 두 문자열이 같은 IP 주소인지(IPv4 매핑 IPv6는 IPv4로 보고 비교). 주소가 아니면 False.
    ########
    """
    try:
        x, y = ipaddress.ip_address(a.strip("[]")), ipaddress.ip_address(b.strip("[]"))
    except ValueError:
        return False
    if x.version == 6 and x.ipv4_mapped:
        x = x.ipv4_mapped
    if y.version == 6 and y.ipv4_mapped:
        y = y.ipv4_mapped
    return x == y


def source_address(base):
    """
    ########
    # source_address -> str 또는 None
    # squid 주소로 갈 때 쓰일 이 서버의 출발 주소. UDP 소켓을 connect()만 해서 커널이 고른 주소를 읽으므로
    # 패킷을 보내지 않는다(TCP 연결을 열면 squid가 빈 요청을 access.log에 남긴다).
    ########
    """
    try:
        parsed = urllib.parse.urlsplit(base)
        host, port = parsed.hostname, parsed.port or 80
        family = socket.AF_INET6 if ":" in (host or "") else socket.AF_INET
        with socket.socket(family, socket.SOCK_DGRAM) as s:
            s.connect((host, port))
            return s.getsockname()[0]
    except (OSError, ValueError, TypeError):
        return None


def take_snapshot(mgr, pages, errors):
    """
    ########
    # take_snapshot -> dict (time, 자기 조회 수, 페이지별 해석 결과)
    # 페이지마다 조회해 해석기에 넣는다. 실패한 페이지는 시각과 함께 errors에 남기고 건너뛴다(연결, HTTP, 주소 오류 모두).
    # 조회 직전의 자기 조회 수와 KB를 기록해 두어 구간 계산에서 뺄 수 있게 한다.
    ########
    """
    snap = {"time": time.time(), "own_requests_before": mgr.requests, "own_kbytes_before": mgr.kbytes}
    parsers = {"info": ("info", parse_info), "counters": ("counters", parse_counters),
               "client_list": ("clients", parse_client_list), "ipcache": ("ipcache", parse_ipcache),
               "fqdncache": ("fqdncache", parse_fqdncache), "active_requests": ("active", parse_active)}
    for page in pages:
        try:
            text = mgr.get(page)
        except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError) as e:
            errors.append("%s %s: %s" % (time.strftime("%H:%M:%S"), page, e))
            continue
        if page in parsers:
            key, parser = parsers[page]
            snap[key] = parser(text)
    return snap


def print_snapshot(snap, base):
    """
    ########
    # print_snapshot -> None (표준 출력)
    # 한 번 조회한 결과를 구역별로 출력한다: 클라이언트(요청 수, 상위 결과 코드), 정방향 DNS(주소, TTL, 실패),
    # 역방향 DNS, 진행 중 요청(오래된 순), 주요 카운터. 조회한 페이지의 구역만 나온다.
    ########
    """
    info = snap.get("info", {})
    print("# squid %s at %s, up %s" % (info.get("version", "?"), base, fmt_duration(info.get("uptime", 0))))
    if "clients" in snap:
        print("\n## clients (loopback excluded)")
        rows = sorted(snap["clients"].items(), key=lambda kv: -kv[1]["http"])
        for addr, c in rows:
            codes = ", ".join("%s %d" % kv for kv in sorted(c["codes"].items(), key=lambda kv: -kv[1])[:4])
            print("  %-40s %8d  %s" % (addr, c["http"], codes))
        if not rows:
            print("  (none)")
    if "ipcache" in snap:
        print("\n## DNS cache: forward lookups (hosts-file and localhost entries excluded)")
        for host, e in sorted(snap["ipcache"].items()):
            ips = " ".join(ip + ("" if ok else "(bad)") for ip, ok in e["ips"]) or "-"
            neg = "  NEGATIVE (lookup failed)" if "N" in e["flags"] else ""
            print("  %-45s ttl %6d  %s%s" % (host, e["ttl"], ips, neg))
        if not snap["ipcache"]:
            print("  (none)")
    if "fqdncache" in snap:
        print("\n## DNS cache: reverse lookups")
        for addr, e in sorted(snap["fqdncache"].items()):
            print("  %-45s %s%s" % (addr, " ".join(e["names"]) or "-", "  NEGATIVE" if "N" in e["flags"] else ""))
        if not snap["fqdncache"]:
            print("  (none)")
    if "active" in snap:
        print("\n## active requests (manager requests excluded)")
        for r in sorted(snap["active"], key=lambda r: -r["age"]):
            print("  %8.1fs  %-40s %s  %s" % (r["age"], r["client"], r["logtype"], r["uri"]))
        if not snap["active"]:
            print("  (none)")
    if "counters" in snap:
        print("\n## counters since squid started (manager requests included)")
        for key in COUNTER_KEYS:
            if key in snap["counters"]:
                print("  %-28s %d" % (key, snap["counters"][key]))


def record(mgr, pages, duration, interval, out_dir, include_local):
    """
    ########
    # record -> (snapshots, errors, start)
    # duration 동안 interval마다 take_snapshot()과 filter_snapshot()을 하고 snapshots.jsonl에 한 줄씩 덧붙인다.
    # 첫 조회는 바로 하고, 진행 상황을 표준 오류에 쓴다. Ctrl-C나 SIGTERM이면 그때까지의 결과로 끝낸다.
    ########
    """
    os.makedirs(out_dir, exist_ok=True)
    stop = {"now": False}

    def on_signal(signum, frame):
        """
        ########
        # on_signal -> None
        # 중단 신호를 받으면 멈춤 표시를 하고, 지금까지 모은 것으로 리포트를 쓴다고 알린다.
        ########
        """
        stop["now"] = True
        print("\nstopping early; writing the report with what was recorded", file=sys.stderr)
    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)

    errors, snaps = [], []
    start = time.time()
    end = start + duration
    path = os.path.join(out_dir, "snapshots.jsonl")
    with open(path, "a", encoding="utf-8") as jsonl:
        while True:
            snap = filter_snapshot(take_snapshot(mgr, pages, errors), include_local, mgr.own_addr)
            snaps.append(snap)
            jsonl.write(json.dumps(snap) + "\n")
            jsonl.flush()
            done = len(snaps)
            print("[%s] poll %d: %d clients, %d DNS names, %d active%s" % (
                time.strftime("%H:%M:%S"), done, len(snap.get("clients", {})), len(snap.get("ipcache", {})),
                len(snap.get("active", [])), "  (%d errors so far)" % len(errors) if errors else ""), file=sys.stderr)
            if stop["now"] or time.time() >= end:
                break
            wake = min(end, snaps[-1]["time"] + interval)
            while not stop["now"] and time.time() < wake:
                time.sleep(min(1.0, wake - time.time()))
            if stop["now"]:
                break
    return snaps, errors, start


def restarted_between(a, b):
    """
    ########
    # restarted_between -> bool
    # 두 스냅숏 사이에 squid가 재시작했는지. 가동 시간이 줄었거나 요청 카운터가 줄었으면 재시작으로 본다.
    ########
    """
    up_a, up_b = a.get("info", {}).get("uptime"), b.get("info", {}).get("uptime")
    if up_a is not None and up_b is not None and up_b < up_a:
        return True
    req_a = a.get("counters", {}).get("client_http.requests")
    req_b = b.get("counters", {}).get("client_http.requests")
    return req_a is not None and req_b is not None and req_b < req_a


def summarize(snaps):
    """
    ########
    # summarize -> dict (리포트에 쓸 요약)
    # 스냅숏들로 기록 구간을 요약한다.
    # 요청: 이웃한 스냅숏의 카운터 차이에서 자기 조회 수와 KB를 빼고, squid가 재시작한 구간은 뺀다(음수는 0).
    # 클라이언트: 이웃한 스냅숏 사이의 증가분을 더한다. 재시작했거나 수가 줄었으면(항목이 지워졌다 다시 생김) 0부터 센다.
    # DNS: 기록 중 캐시에서 본 이름, 주소, 실패 여부, 처음 스냅숏에 없던 이름(new).
    # 그 밖에 역방향 DNS, 클라이언트·URL별로 가장 오래 걸린 진행 중 요청, 메모리·CPU 등의 최소/최대/마지막 값.
    ########
    """
    first, last = snaps[0], snaps[-1]
    s = {"start": first["time"], "end": last["time"], "polls": len(snaps),
         "version": last.get("info", {}).get("version") or first.get("info", {}).get("version", "?")}

    restarted = [False] + [restarted_between(a, b) for a, b in zip(snaps, snaps[1:])]
    s["restarts"] = sum(restarted)

    series = []
    for k in range(1, len(snaps)):
        a, b = snaps[k - 1], snaps[k]
        if "counters" not in a or "counters" not in b or restarted[k]:
            continue
        minutes = max((b["time"] - a["time"]) / 60.0, 1e-9)
        own = b["own_requests_before"] - a["own_requests_before"]
        own_kb = b["own_kbytes_before"] - a["own_kbytes_before"]
        d = {key: max(b["counters"].get(key, 0) - a["counters"].get(key, 0), 0) for key in COUNTER_KEYS}
        req = max(d["client_http.requests"] - own, 0)
        series.append({"t": b["time"], "minutes": minutes, "requests": req,
                       "per_min": req / minutes, "errors": d["client_http.errors"],
                       "hits": d["client_http.hits"], "kb_out": max(d["client_http.kbytes_out"] - own_kb, 0),
                       "server": d["server.all.requests"]})
    s["series"] = series
    s["requests"] = sum(x["requests"] for x in series)
    s["errors"] = sum(x["errors"] for x in series)
    s["hits"] = sum(x["hits"] for x in series)
    s["kb_out"] = sum(x["kb_out"] for x in series)
    s["peak_per_min"] = max([x["per_min"] for x in series] or [0])
    minutes = (s["end"] - s["start"]) / 60.0
    s["avg_per_min"] = s["requests"] / minutes if minutes > 0 else 0

    clients = {}
    previous, previous_index = None, -1
    for k, snap in enumerate(snaps):
        if "clients" not in snap:
            continue
        if previous is not None:
            reset = any(restarted[previous_index + 1:k + 1])
            for addr, c in snap["clients"].items():
                before = None if reset else previous["clients"].get(addr)
                if before is None or c["http"] < before["http"]:
                    before = {"http": 0, "codes": {}}
                row = clients.setdefault(addr, {"name": c["name"], "requests": 0, "codes": {}})
                row["requests"] += c["http"] - before["http"]
                for code, value in c["codes"].items():
                    row["codes"][code] = row["codes"].get(code, 0) + max(value - before["codes"].get(code, 0), 0)
        previous, previous_index = snap, k
    s["clients"] = sorted(([a, r] for a, r in clients.items() if r["requests"] > 0),
                          key=lambda ar: -ar[1]["requests"])

    dns = {}
    for snap in snaps:
        for host, e in snap.get("ipcache", {}).items():
            row = dns.setdefault(host, {"first": snap["time"], "ips": set(), "negative": False, "polls": 0})
            row["last"] = snap["time"]
            row["polls"] += 1
            row["ips"].update(ip for ip, ok in e["ips"])
            row["negative"] = row["negative"] or "N" in e["flags"]
    first_dns = next((snap for snap in snaps if "ipcache" in snap), {})
    initial = set(first_dns.get("ipcache", {}))
    s["dns"] = sorted(([h, dict(r, ips=sorted(r["ips"]), new=h not in initial)] for h, r in dns.items()),
                      key=lambda hr: (hr[1]["negative"], -hr[1]["polls"], hr[0]))
    rdns = {}
    for snap in snaps:
        for addr, e in snap.get("fqdncache", {}).items():
            rdns[addr] = {"names": e["names"], "negative": "N" in e["flags"]}
    s["rdns"] = sorted(rdns.items())

    active = {}
    for snap in snaps:
        for r in snap.get("active", []):
            key = (r["client"], r["uri"])
            row = active.setdefault(key, {"client": r["client"], "uri": r["uri"], "max_age": 0, "seen": 0,
                                          "logtype": r["logtype"], "user": r["user"]})
            row["max_age"] = max(row["max_age"], r["age"])
            row["seen"] += 1
    s["active"] = sorted(active.values(), key=lambda r: -r["max_age"])

    res = {}
    for key in ("rss_kb", "fd_in_use", "mem_kb", "cpu_pct"):
        values = [snap["info"][key] for snap in snaps if key in snap.get("info", {})]
        if values:
            res[key] = (min(values), max(values), values[-1])
    s["resources"] = res
    return s


def write_text(s, errors, base, path):
    """
    ########
    # write_text -> None (summary.txt)
    # 요약을 텍스트로 쓴다: 기간, 조회 수, 재시작, 요청 수와 분당 평균·최대, 상위 클라이언트, DNS 이름, 오래 걸린 요청, 오류.
    ########
    """
    lines = []
    w = lines.append
    t0 = datetime.datetime.fromtimestamp(s["start"]).strftime("%Y-%m-%d %H:%M:%S")
    t1 = datetime.datetime.fromtimestamp(s["end"]).strftime("%Y-%m-%d %H:%M:%S")
    w("squid cache manager report: squid %s at %s" % (s["version"], base))
    w("window: %s - %s (%s), %d polls, %d errors" % (t0, t1, fmt_duration(s["end"] - s["start"]), s["polls"], len(errors)))
    w("excluded: loopback clients, /etc/hosts and localhost DNS entries, manager requests")
    if s["restarts"]:
        w("squid restarted %d time(s) while recording; those intervals are left out" % s["restarts"])
    w("")
    w("requests %d  (avg %.1f/min, peak %.1f/min)  errors %d  hits %d  sent %.0f KB" % (
        s["requests"], s["avg_per_min"], s["peak_per_min"], s["errors"], s["hits"], s["kb_out"]))
    w("")
    w("top clients:")
    for addr, r in s["clients"][:20]:
        codes = ", ".join("%s %d" % kv for kv in sorted(r["codes"].items(), key=lambda kv: -kv[1]) if kv[1])
        w("  %-40s %8d  %s" % (addr, r["requests"], codes))
    if not s["clients"]:
        w("  (no client other than localhost sent requests)")
    w("")
    w("DNS names resolved (new = not cached when recording started):")
    for host, r in s["dns"][:200]:
        w("  %-45s %s%s%s" % (host, " ".join(r["ips"]) or "-", "  NEW" if r["new"] else "",
                              "  FAILED" if r["negative"] else ""))
    if not s["dns"]:
        w("  (none)")
    w("")
    w("longest active requests:")
    for r in s["active"][:20]:
        w("  %8.1fs  %-40s %s" % (r["max_age"], r["client"], r["uri"]))
    if not s["active"]:
        w("  (none in flight at poll times)")
    if errors:
        w("")
        w("errors:")
        for e in errors[:50]:
            w("  " + e)
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


def write_html(s, errors, base, path):
    """
    ########
    # write_html -> None (report.html)
    # 외부 파일 없이 열리는 HTML 리포트를 쓴다: 요약 카드, 분당 요청 막대그래프(SVG), 클라이언트, DNS(새 이름·실패 표시),
    # 역방향 DNS, 오래 걸린 요청, 자원 사용, 오류. 라이트/다크 색을 모두 지원하고 모든 값을 HTML 이스케이프한다.
    ########
    """
    e = html.escape
    t0 = datetime.datetime.fromtimestamp(s["start"]).strftime("%Y-%m-%d %H:%M:%S")
    t1 = datetime.datetime.fromtimestamp(s["end"]).strftime("%Y-%m-%d %H:%M:%S")

    def card(label, value, cls=""):
        """
        ########
        # card -> str (HTML)
        # 요약 카드 하나(라벨, 값)를 만든다.
        ########
        """
        return '<div class="card %s"><div class="label">%s</div><div class="value">%s</div></div>' % (cls, e(label), e(value))

    series = s["series"]
    chart = '<p class="muted">Not enough polls for a traffic chart.</p>'
    if series:
        w, h, pad = 880, 180, 36
        top = max(max(x["per_min"] for x in series), 1)
        bw = (w - pad - 8) / len(series)
        bars, labels = [], []
        for i, x in enumerate(series):
            bh = (h - 40) * x["per_min"] / top
            bx = pad + i * bw
            bars.append('<rect x="%.1f" y="%.1f" width="%.1f" height="%.1f" rx="2"><title>%s: %.1f req/min</title></rect>' % (
                bx + 1, h - 22 - bh, max(bw - 2, 1), bh,
                datetime.datetime.fromtimestamp(x["t"]).strftime("%H:%M:%S"), x["per_min"]))
        for i in (0, len(series) // 2, len(series) - 1):
            x = series[i]
            labels.append('<text x="%.1f" y="%d" class="axis">%s</text>' % (
                pad + i * bw + 2, h - 6, datetime.datetime.fromtimestamp(x["t"]).strftime("%H:%M")))
        chart = ('<svg viewBox="0 0 %d %d" class="chart" role="img" aria-label="requests per minute">'
                 '<text x="0" y="14" class="axis">%.0f/min</text><line x1="%d" x2="%d" y1="%d" y2="%d" class="base"/>'
                 '%s%s</svg>') % (w, h, top, pad, w, h - 22, h - 22, "".join(bars), "".join(labels))

    client_rows = "".join(
        "<tr><td class='mono'>%s</td><td>%s</td><td class='num'>%d</td><td class='mono small'>%s</td></tr>" % (
            e(a), e(r["name"] if r["name"] != a else ""), r["requests"],
            e(", ".join("%s %d" % kv for kv in sorted(r["codes"].items(), key=lambda kv: -kv[1]) if kv[1])))
        for a, r in s["clients"][:100]) or "<tr><td colspan=4 class='muted'>No client other than localhost sent requests.</td></tr>"
    dns_rows = "".join(
        "<tr><td class='mono'>%s</td><td class='mono small'>%s</td><td>%s</td><td class='num'>%d</td></tr>" % (
            e(hn), e(" ".join(r["ips"]) or "-"),
            ("<span class='pill bad'>failed</span> " if r["negative"] else "") + ("<span class='pill new'>new</span>" if r["new"] else ""),
            r["polls"])
        for hn, r in s["dns"][:500]) or "<tr><td colspan=4 class='muted'>No DNS names besides /etc/hosts and localhost.</td></tr>"
    rdns_rows = "".join(
        "<tr><td class='mono'>%s</td><td class='mono'>%s</td></tr>" % (e(a), e(" ".join(r["names"]) or ("(failed)" if r["negative"] else "-")))
        for a, r in s["rdns"][:300]) or "<tr><td colspan=2 class='muted'>None.</td></tr>"
    active_rows = "".join(
        "<tr><td class='num'>%.1f s</td><td class='mono'>%s</td><td class='mono small'>%s</td><td>%s</td></tr>" % (
            r["max_age"], e(r["client"]), e(r["uri"]), e(r["logtype"]))
        for r in s["active"][:100]) or "<tr><td colspan=4 class='muted'>No request was in flight at poll times.</td></tr>"
    res_names = {"rss_kb": "max resident size (KB)", "fd_in_use": "file descriptors in use",
                 "mem_kb": "storage memory (KB)", "cpu_pct": "CPU usage (%)"}
    res_rows = "".join("<tr><td>%s</td><td class='num'>%g</td><td class='num'>%g</td><td class='num'>%g</td></tr>" % (
        e(res_names[k]), v[0], v[1], v[2]) for k, v in s["resources"].items())
    err_html = ("<h2>Errors</h2><ul>%s</ul>" % "".join("<li class='mono small'>%s</li>" % e(x) for x in errors[:100])) if errors else ""

    doc = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1"><title>Squid Manager Report</title><style>
:root{--bg:#f7f7f5;--panel:#fff;--text:#1d1d1b;--muted:#6b6b66;--line:#e3e2dc;--accent:#3b5bdb;--bad:#c0362c;--bad-bg:#fbe6e3;--new:#1a7f4b;--new-bg:#e3f4ea}
@media (prefers-color-scheme:dark){:root{--bg:#161615;--panel:#1f1f1d;--text:#ecebe6;--muted:#9c9b95;--line:#33332f;--accent:#8ea2ff;--bad:#ff7b6e;--bad-bg:#3a1a17;--new:#5fd08f;--new-bg:#163322}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 system-ui,-apple-system,'Segoe UI','Noto Sans KR',sans-serif}
main{max-width:1100px;margin:0 auto;padding:24px 16px 64px}h1{font-size:22px;margin:0 0 4px}h2{font-size:17px;margin:28px 0 10px}
.muted{color:var(--muted)}.mono{font-family:ui-monospace,Menlo,Consolas,monospace}.small{font-size:12px}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-top:16px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px 14px}.card .label{font-size:12px;color:var(--muted)}.card .value{font-size:22px;font-weight:650}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:4px 0;overflow-x:auto}
table{border-collapse:collapse;width:100%}th,td{padding:7px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
th{font-size:12px;color:var(--muted)}tbody tr:last-child td{border-bottom:0}.num{text-align:right;font-variant-numeric:tabular-nums}
.pill{display:inline-block;padding:0 7px;border-radius:999px;font-size:11px;font-weight:700}.pill.bad{background:var(--bad-bg);color:var(--bad)}.pill.new{background:var(--new-bg);color:var(--new)}
.chart{width:100%;height:auto}.chart rect{fill:var(--accent)}.chart .axis{fill:var(--muted);font-size:11px}.chart .base{stroke:var(--line)}
</style></head><body><main>"""
    doc += "<h1>Squid cache manager report</h1>"
    doc += "<div class='muted'>squid %s at <span class='mono'>%s</span> &middot; %s &ndash; %s (%s) &middot; %d polls</div>" % (
        e(s["version"]), e(base), t0, t1, fmt_duration(s["end"] - s["start"]), s["polls"])
    doc += "<p class='muted small'>Excluded: loopback clients, /etc/hosts and localhost DNS entries, and the manager's own requests (also subtracted from request counts).</p>"
    doc += "<div class='cards'>%s%s%s%s%s%s%s</div>" % (
        card("requests", "%d" % s["requests"]), card("avg / min", "%.1f" % s["avg_per_min"]),
        card("peak / min", "%.1f" % s["peak_per_min"]), card("errors", "%d" % s["errors"]),
        card("clients", "%d" % len(s["clients"])), card("DNS names", "%d" % len(s["dns"])),
        card("DNS failures", "%d" % sum(1 for _, r in s["dns"] if r["negative"])))
    doc += "<h2>Requests per minute</h2><div class='panel' style='padding:12px'>%s</div>" % chart
    doc += "<h2>Clients</h2><div class='panel'><table><thead><tr><th>address</th><th>name</th><th class='num'>requests</th><th>result codes</th></tr></thead><tbody>%s</tbody></table></div>" % client_rows
    doc += "<h2>DNS names resolved</h2><p class='muted small'>new = not in the cache when recording started; failed = negative-cached lookup.</p><div class='panel'><table><thead><tr><th>hostname</th><th>addresses</th><th></th><th class='num'>polls seen</th></tr></thead><tbody>%s</tbody></table></div>" % dns_rows
    doc += "<h2>Reverse DNS</h2><div class='panel'><table><thead><tr><th>address</th><th>names</th></tr></thead><tbody>%s</tbody></table></div>" % rdns_rows
    doc += "<h2>Longest active requests</h2><div class='panel'><table><thead><tr><th class='num'>age</th><th>client</th><th>URL</th><th>log type</th></tr></thead><tbody>%s</tbody></table></div>" % active_rows
    if res_rows:
        doc += "<h2>Resources</h2><div class='panel'><table><thead><tr><th></th><th class='num'>min</th><th class='num'>max</th><th class='num'>last</th></tr></thead><tbody>%s</tbody></table></div>" % res_rows
    doc += err_html + "</main></body></html>\n"
    with open(path, "w", encoding="utf-8") as f:
        f.write(doc)


SIM_CONF_DEFAULTS = {
    "squid_conf": "/etc/squid/squid.conf",
    "access_log": "auto",
    "log_format": "auto",
    "local_ip": "auto",
    "log_timezone": "local",
    "sim_port": "auto",
    "sim_dns": "auto",
    "manager_url": "auto",
    "manager_password_env": "",
}


class SimConf:
    """
    ########
    # SimConf -> 클래스: squid-sim.conf 설정
    # settings: 지시어 -> 값(SIM_CONF_DEFAULTS로 시작), formats: 이 파일의 logformat 정의, path: 읽은 파일.
    ########
    """
    def __init__(self, path=None):
        """
        ########
        # __init__ -> None
        # 기본값으로 시작해, 파일이 주어지면 읽는다.
        ########
        """
        self.path = path
        self.settings = dict(SIM_CONF_DEFAULTS)
        self.formats = {}
        if path:
            self.read(path)

    def read(self, path):
        """
        ########
        # read -> None (settings, formats 갱신)
        # 한 줄에 지시어 하나를 읽는다. logformat은 이름과 줄 끝까지의 형식을, 나머지는 첫 단어만 값으로 쓴다(뒤는 주석).
        # squid_conf와 access_log의 상대 경로는 이 파일의 디렉터리 기준으로 바꾼다. 모르는 지시어면 줄 번호와 함께 끝낸다.
        ########
        """
        try:
            f = open(path, encoding="utf-8", errors="replace")
        except OSError as e:
            sys.exit("squid-sim: cannot read %s: %s" % (path, e))
        with f:
            for number, raw in enumerate(f, 1):
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                words = line.split(None, 2)
                key = words[0]
                if key == "logformat":
                    if len(words) < 3:
                        sys.exit("squid-sim: %s:%d: logformat needs a name and a format" % (path, number))
                    self.formats[words[1]] = words[2]
                    continue
                if key not in SIM_CONF_DEFAULTS or len(words) < 2:
                    sys.exit("squid-sim: %s:%d: unknown or incomplete directive: %s" % (path, number, line))
                value = words[1]
                if key in ("squid_conf", "access_log") and value != "auto" and not os.path.isabs(value):
                    value = os.path.join(os.path.dirname(os.path.abspath(path)), value)
                self.settings[key] = value

    def get(self, key):
        """
        ########
        # get -> str 또는 None
        # 지시어 값. auto이거나 비어 있으면 None(알아서 정하라는 뜻).
        ########
        """
        value = self.settings[key]
        return None if value in ("auto", "") else value


def find_sim_conf(explicit):
    """
    ########
    # find_sim_conf -> str 또는 None (설정 파일 경로)
    # --sim-conf, $SQUID_SIM_CONF, /etc/squid/squid-sim.conf, 저장소의 squid-sim.conf 중 처음 있는 것.
    ########
    """
    if explicit:
        return explicit
    for path in (os.environ.get("SQUID_SIM_CONF"), "/etc/squid/squid-sim.conf", os.path.join(ROOT, "squid-sim.conf")):
        if path and os.path.isfile(path):
            return path
    return None


def squid_conf_lines(path, depth=0):
    """
    ########
    # squid_conf_lines -> 반복자 (주석과 빈 줄을 뺀 줄)
    # squid.conf를 읽으며 include 지시어의 파일(glob 패턴, 정렬)을 그 자리에서 이어 읽는다.
    # 읽을 수 없는 파일은 건너뛰고, 16단계보다 깊은 include는 무시한다.
    ########
    """
    if depth > 16:
        return
    try:
        f = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return
    with f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            words = line.split()
            if words[0] == "include":
                for pattern in words[1:]:
                    for included in sorted(glob.glob(pattern)):
                        yield from squid_conf_lines(included, depth + 1)
                continue
            yield line


class SquidConf:
    """
    ########
    # SquidConf -> 클래스: squid.conf 중 access.log와 관련된 부분
    # formats: logformat 정의, logs: access_log의 (위치, 형식 이름), has_access_log: access_log 줄이 있었는지,
    # port_ip: 첫 http_port에 적힌 주소, uses_local_ip: localip/myip ACL을 쓰는지.
    ########
    """

    def __init__(self, path):
        """
        ########
        # __init__ -> None
        # squid_conf_lines()로 읽으며 logformat, access_log(옛 형식 "파일 형식"과 logformat=이름 모두), http_port 주소,
        # localip/myip ACL을 모은다.
        ########
        """
        self.path = path
        self.formats = {}
        self.logs = []
        self.has_access_log = False
        self.port_ip = None
        self.uses_local_ip = False
        for line in squid_conf_lines(path):
            words = line.split()
            if words[0] == "logformat" and len(words) >= 3:
                self.formats[words[1]] = line.split(None, 2)[2]
            elif words[0] == "access_log" and len(words) >= 2:
                self.has_access_log = True
                if words[1] == "none":
                    continue
                name = next((w.split("=", 1)[1] for w in words[2:] if w.startswith("logformat=")), None)
                if name is None and len(words) >= 3 and "=" not in words[2]:
                    name = words[2]
                self.logs.append((words[1], name))
            elif words[0] == "http_port" and len(words) >= 2 and self.port_ip is None:
                m = re.match(r"^\[?([0-9a-fA-F.:]+?)\]?:\d+$", words[1])
                if m and is_ip_literal(m.group(1)) and not ipaddress.ip_address(m.group(1)).is_unspecified:
                    self.port_ip = m.group(1)
            elif words[0] == "acl" and len(words) >= 3 and words[2] in ("localip", "myip"):
                self.uses_local_ip = True

    def log_file(self):
        """
        ########
        # log_file -> str 또는 None
        # 첫 파일 access_log 경로(daemon:, stdio: 접두어 제거). access_log 줄이 아예 없으면 squid 기본값
        # /var/log/squid/access.log. 파일이 아닌 곳(udp:, syslog: 등)뿐이면 None.
        ########
        """
        if not self.has_access_log and os.path.isfile(self.path):
            return DEFAULT_ACCESS_LOG
        for place, _ in self.logs:
            if place.startswith(("daemon:", "stdio:")):
                place = place.split(":", 1)[1]
            if place.startswith("/"):
                return place
        return None

    def log_format(self):
        """
        ########
        # log_format -> str 또는 None
        # 첫 access_log가 쓰는 형식 이름. 정의되지 않은 이름이거나 형식을 적지 않았으면 squid 기본값 squid.
        # access_log 줄이 없어도 squid. access_log none뿐이면 None.
        ########
        """
        if not self.has_access_log and os.path.isfile(self.path):
            return "squid"
        for _, name in self.logs:
            return name if name and (name in self.formats or name in BUILTIN_FORMATS) else "squid"
        return None


SIMULFORMAT = '%tl %la %>a "%rm %ru HTTP/%rv" %>Hs %<st %Ss:%Sh'
DEFAULT_ACCESS_LOG = "/var/log/squid/access.log"
BUILTIN_FORMATS = {
    "simulformat": SIMULFORMAT,
    "squid": "%ts.%03tu %6tr %>a %Ss/%03>Hs %<st %rm %ru %[un %Sh/%<a %mt",
    "common": '%>a %[ui %[un [%tl] "%rm %ru HTTP/%rv" %>Hs %<st %Ss:%Sh',
    "combined": '%>a %[ui %[un [%tl] "%rm %ru HTTP/%rv" %>Hs %<st "%{Referer}>h" "%{User-Agent}>h" %Ss:%Sh',
    "referrer": "%ts.%03tu %>a %{Referer}>h %ru",
}
KNOWN_CODES = sorted("""
    >a >A >p >la >lp >eui >qos >nfmark la lp <a <A <p <la <lp <qos <nfmark
    ts tu tl tg tr tt dt tS tR busy_time rm ru rp rv rG >rm >ru >rp >rv >rs >rd >rP >rdp <rm <ru <rp <rv <rs <rd <rP
    Ss Sh Hs >Hs <Hs <pt <tt <bs >bs <st >st <sh >sh st mt ea un ul ui uj ue us et sn err_code err_detail note
    >h <h >ha <ha master_xaction ssl::bump_mode ssl::>sni ssl::>cert_subject ssl::>cert_issuer
    ssl::<cert_subject ssl::<cert_issuer ssl::<cert_errors ssl::>negotiated_version ssl::<negotiated_version
    ssl::>received_hello_version ssl::<received_hello_version ssl::>received_supported_version
    ssl::<received_supported_version ssl::>negotiated_cipher ssl::<negotiated_cipher ssl::<cert
    proxy_protocol::>h icap::tt icap::<last_h adapt::<last_h adapt::sum_trs adapt::all_trs
""".split(), key=len, reverse=True)
FIELD_PREFIX = re.compile(r'%([-"\[#\'/]*)(0?\d+)?(?:\.\d+)?(\{[^}]*\})?')
FALLBACK_CODE = re.compile(r"(?:[a-z_]+::)?[<>]?[A-Za-z_]+")
ARGUMENT = re.compile(r"\{[^}]*\}")
ROLES = {"tl": "tl", "tg": "tg", "ts": "ts", "la": "la", ">la": "la", ">a": "client", "rm": "method", ">rm": "method",
         "ru": "url", ">ru": "url", "rv": "version", ">rv": "version", ">Hs": "status", "Hs": "status",
         "<st": "size", "st": "size", "Ss": "ss", "Sh": "sh"}
TIME_DEFAULTS = {"tl": "%d/%b/%Y:%H:%M:%S %z", "tg": "%d/%b/%Y:%H:%M:%S"}
STRFTIME_REGEX = {"d": r"\d{1,2}", "e": r"\s?\d{1,2}", "m": r"\d{1,2}", "b": r"[A-Za-z]{3}", "h": r"[A-Za-z]{3}",
                  "B": r"[A-Za-z]+", "a": r"[A-Za-z]{3}", "A": r"[A-Za-z]+", "Y": r"\d{4}", "y": r"\d{2}",
                  "H": r"\d{1,2}", "I": r"\d{1,2}", "M": r"\d{2}", "S": r"\d{2}", "p": r"[AaPp][Mm]",
                  "j": r"\d{3}", "z": r"[+-]\d{4}", "Z": r"[A-Za-z]+", "T": r"\d{1,2}:\d{2}:\d{2}",
                  "F": r"\d{4}-\d{1,2}-\d{1,2}", "s": r"\d+", "%": "%"}
STRPTIME_ALIASES = {"e": "%d", "h": "%b", "T": "%H:%M:%S", "F": "%Y-%m-%d"}
NUMERIC = {"ts", "tu", "tr", "tt", "dt", "<pt", "<tt", "<st", ">st", "st", "<sh", ">sh", "<bs", ">bs"}
MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
HOST_PORT = re.compile(r"^(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9.-]+):\d+$")


def strftime_regex(spec):
    """
    ########
    # strftime_regex -> str (정규식)
    # squid가 시각에 쓰는 strftime 형식(%d/%b/%Y:%H:%M:%S %z 등)을 그 출력에 맞는 정규식으로 바꾼다.
    # 공백은 하나 이상의 공백으로 보고, 모르는 지시자면 ValueError.
    ########
    """
    parts, i = [], 0
    while i < len(spec):
        if spec[i] == "%" and i + 1 < len(spec):
            directive = spec[i + 1]
            if directive not in STRFTIME_REGEX:
                raise ValueError("unsupported time directive %%%s in %r" % (directive, spec))
            parts.append(STRFTIME_REGEX[directive])
            i += 2
            continue
        parts.append(r"\s+" if spec[i].isspace() else re.escape(spec[i]))
        i += 1
    return "".join(parts)


def strptime_spec(spec):
    """
    ########
    # strptime_spec -> str
    # strptime이 모르는 strftime 지시자를 같은 뜻으로 바꾼다: %e -> %d, %h -> %b, %T -> %H:%M:%S, %F -> %Y-%m-%d.
    ########
    """
    return re.sub(r"%([eThF])", lambda m: STRPTIME_ALIASES[m.group(1)], spec)


def parse_offset(text):
    """
    ########
    # parse_offset -> int 또는 None (UTC 오프셋 초)
    # log_timezone 값을 읽는다. local이면 None(이 서버의 타임존, 서머타임 포함), +0900이나 +09:00이면 초.
    # 형식이 틀리면 바로 끝낸다(변환 도중이 아니라 시작할 때).
    ########
    """
    if text == "local":
        return None
    m = re.fullmatch(r"([+-])(\d\d):?(\d\d)", text)
    if not m:
        sys.exit("squid-sim: log_timezone must be local or like +0900, not %r" % text)
    return (1 if m.group(1) == "+" else -1) * (int(m.group(2)) * 3600 + int(m.group(3)) * 60)


def unescape(value):
    """
    ########
    # unescape -> str
    # squid의 %"코드 출력처럼 백슬래시로 이스케이프된 값을 원래대로 되돌린다(n, r, t는 제어 문자로).
    ########
    """
    return re.sub(r"\\(.)", lambda m: {"n": "\n", "r": "\r", "t": "\t"}.get(m.group(1), m.group(1)), value)


def parse_format(spec):
    """
    ########
    # parse_format -> list (('lit', 텍스트) 또는 ('field', 코드, 따옴표, 너비, 인자))
    # squid logformat 문자열을 리터럴과 필드로 나눈다. %% 는 리터럴 %.
    # 필드는 % 뒤에 인코딩(" [ # ' /), 정렬(-), 너비(0 채움 포함), .최대, {인자}가 오고 코드가 온다.
    # 코드는 알려진 코드 중 가장 긴 것을 먼저 맞추고(%Ss/%03>Hs가 Ss, /, >Hs로 나뉘도록), 모르면 FALLBACK_CODE로 읽는다.
    # {인자}는 코드 앞이나 뒤 어느 쪽이든 받는다.
    ########
    """
    items, lit, i = [], "", 0
    while i < len(spec):
        if spec[i] != "%":
            lit += spec[i]
            i += 1
            continue
        if spec.startswith("%%", i):
            lit += "%"
            i += 2
            continue
        prefix = FIELD_PREFIX.match(spec, i)
        j = prefix.end()
        code = next((c for c in KNOWN_CODES if spec.startswith(c, j)), None)
        if code is None:
            m = FALLBACK_CODE.match(spec, j)
            if not m:
                raise ValueError("cannot read the format code at %r" % spec[i:i + 12])
            code = m.group(0)
        j += len(code)
        argument = prefix.group(3)
        arg = ARGUMENT.match(spec, j)
        if arg:
            j = arg.end()
            argument = argument or arg.group(0)
        if lit:
            items.append(("lit", lit))
            lit = ""
        items.append(("field", code, '"' in prefix.group(1), bool(prefix.group(2)),
                      argument[1:-1] if argument else None))
        i = j
    if lit:
        items.append(("lit", lit))
    return items


class LogFormat:
    """
    ########
    # LogFormat -> 클래스: 한 logformat의 줄 판별·변환기
    # regex: 줄 전체에 맞는 정규식, roles: 정규식 그룹이 simulformat의 어떤 값인지, time_specs: 시각 필드의 strftime 형식,
    # quoted: 따옴표 인코딩된 값, missing: 없는 필수 필드(%>a, %ru), has_local_ip, has_time,
    # passthrough: 이미 simulformat이라 변환이 필요 없는지, offset: 시각 변환에 쓸 UTC 오프셋.
    ########
    """

    def __init__(self, name, spec, local_ip=None, timezone="local"):
        """
        ########
        # __init__ -> None
        # parse_format() 결과로 정규식을 만든다. 리터럴의 공백은 하나 이상의 공백으로, 필드 값은 문맥에 맞춰:
        # 따옴표 인코딩이면 이스케이프를 허용한 따옴표 문자열, 시각이면 그 strftime 형식의 정규식, 숫자 코드면 숫자 또는 -,
        # 따옴표 사이면 따옴표가 아닌 문자, 뒤에 공백 아닌 리터럴이 붙으면 그 문자를 뺀 문자, 그 밖에는 공백 아닌 문자.
        # 너비가 있으면 앞쪽 채움 공백을 허용한다.
        ########
        """
        self.name, self.spec = name, spec
        self.local_ip = local_ip or "-"
        self.offset = parse_offset(timezone)
        items = parse_format(spec)
        parts, self.roles, self.time_specs, self.quoted = [], [], {}, set()
        for k, item in enumerate(items):
            if item[0] == "lit":
                text = item[1]
                chunks = re.split(r"(\s+)", text)
                parts.append("".join(r"\s+" if c.isspace() else re.escape(c) for c in chunks if c))
                continue
            _, code, quoted, padded, argument = item
            before = items[k - 1][1] if k and items[k - 1][0] == "lit" else ""
            after = items[k + 1][1] if k + 1 < len(items) and items[k + 1][0] == "lit" else ""
            role = ROLES.get(code)
            if quoted:
                value = r'"(?:[^"\\]|\\.)*"'
                if role:
                    self.quoted.add(role)
            elif code in TIME_DEFAULTS:
                time_spec = argument or TIME_DEFAULTS[code]
                value = strftime_regex(time_spec)
                if role and role not in self.time_specs:
                    self.time_specs[role] = time_spec
            elif code in NUMERIC:
                value = r"-|-?\d+"
            elif before.endswith('"') and after.startswith('"'):
                value = r'[^"]*'
            elif after and not after[0].isspace():
                value = r"[^\s%s]+" % re.escape(after[0])
            else:
                value = r"\S+"
            if role:
                self.roles.append(role)
            parts.append((r"\s*" if padded else "") + ("(%s)" if role else "(?:%s)") % value)
        self.regex = re.compile("^" + "".join(parts) + r"\s*$")
        have = set(self.roles)
        self.missing = [code for code, role in (("%>a", "client"), ("%ru", "url")) if role not in have]
        self.has_local_ip = "la" in have
        self.has_time = bool(have & {"tl", "tg", "ts"})
        self.passthrough = " ".join(spec.split()) == SIMULFORMAT

    def local_time(self, epoch):
        """
        ########
        # local_time -> str (%tl 형식 "02/Nov/2026:10:00:00 +0900")
        # UTC epoch를 log_timezone의 현지 시각으로 쓴다. local이면 그 시각의 이 서버 오프셋(서머타임 포함)을 쓴다.
        ########
        """
        if self.offset is None:
            tm = time.localtime(epoch)
            offset = tm.tm_gmtoff
        else:
            offset = self.offset
            tm = time.gmtime(epoch + offset)
        sign = "-" if offset < 0 else "+"
        return "%02d/%s/%04d:%02d:%02d:%02d %s%02d%02d" % (
            tm.tm_mday, MONTHS[tm.tm_mon - 1], tm.tm_year, tm.tm_hour, tm.tm_min, tm.tm_sec,
            sign, abs(offset) // 3600, abs(offset) % 3600 // 60)

    def epoch(self, value, spec, utc):
        """
        ########
        # epoch -> int (UTC epoch)
        # 시각 문자열을 strftime 형식으로 읽는다. %s면 그대로 숫자. 값에 %z가 있으면 그 오프셋을, 없으면
        # %tg는 UTC로, %tl은 log_timezone(또는 이 서버의 현지 시각)으로 해석한다. 읽지 못하면 ValueError.
        ########
        """
        if spec == "%s":
            return int(value)
        stamp = datetime.datetime.strptime(" ".join(value.split()), strptime_spec(spec))
        if stamp.tzinfo is not None:
            return int(stamp.timestamp())
        if utc:
            return calendar.timegm(stamp.timetuple())
        if self.offset is not None:
            return calendar.timegm(stamp.timetuple()) - self.offset
        return int(time.mktime(stamp.timetuple()))

    def when(self, v):
        """
        ########
        # when -> str 또는 None
        # simulformat에 넣을 시각. 기본 형식의 %tl은 그대로 쓰고, 다른 형식의 %tl·%tg·%ts는 epoch를 거쳐 현지 시각으로 바꾼다.
        # 시각 필드가 없으면 "- -"(시뮬레이터가 현재 시각을 쓰고 경고), 시각을 읽지 못하면 None(그 줄은 맞지 않는 줄).
        ########
        """
        try:
            if "tl" in v:
                if self.time_specs["tl"] == TIME_DEFAULTS["tl"]:
                    return v["tl"]
                return self.local_time(self.epoch(v["tl"], self.time_specs["tl"], False))
            if "tg" in v:
                return self.local_time(self.epoch(v["tg"], self.time_specs["tg"], True))
        except ValueError:
            return None
        if v.get("ts", "-").isdigit():
            return self.local_time(int(v["ts"]))
        return "- -"

    def convert(self, line):
        """
        ########
        # convert -> str 또는 None
        # 줄 하나를 simulformat으로 바꾼다. 맞지 않으면 None. 따옴표 인코딩 값은 따옴표를 벗기고 이스케이프를 푼다.
        # %la가 없으면 local_ip, %rm이 없으면 URL이 호스트:포트면 CONNECT 아니면 GET, %rv가 없으면 1.1, 나머지는 -.
        ########
        """
        m = self.regex.match(line)
        if not m:
            return None
        v = {}
        for role, value in zip(self.roles, m.groups()):
            if value is None:
                continue
            if role in self.quoted and len(value) >= 2 and value[0] == '"' and value[-1] == '"':
                value = unescape(value[1:-1])
            v.setdefault(role, value)
        when = self.when(v)
        if when is None:
            return None
        url = v.get("url", "-")
        method = v.get("method") or ("CONNECT" if HOST_PORT.match(url) else "GET")
        return '%s %s %s "%s %s HTTP/%s" %s %s %s:%s' % (
            when, v.get("la", self.local_ip), v.get("client", "-"), method, url, v.get("version", "1.1"),
            v.get("status", "-"), v.get("size", "-"), v.get("ss", "-"), v.get("sh", "-"))


def open_log(path):
    """
    ########
    # open_log -> 텍스트 파일 객체
    # 로그를 연다(.gz면 gzip). UTF-8이 아닌 바이트는 surrogateescape로 보존해 URL이 바뀌지 않게 하고, 줄 끝은 그대로 둔다.
    ########
    """
    if path.endswith(".gz"):
        return gzip.open(path, "rt", encoding="utf-8", errors="surrogateescape", newline="")
    return open(path, encoding="utf-8", errors="surrogateescape", newline="")


def sample_lines(path, count=50):
    """
    ########
    # sample_lines -> list[str]
    # 주석과 빈 줄을 뺀 처음 count개 줄. 형식 판별에 쓴다.
    ########
    """
    lines = []
    with open_log(path) as f:
        for line in f:
            line = line.rstrip("\r\n")
            if line and not line.startswith("#"):
                lines.append(line)
                if len(lines) >= count:
                    break
    return lines


def choose_format(log, sim, squid):
    """
    ########
    # choose_format -> (LogFormat, 판별 근거 문자열)
    # 로그 형식을 정한다. log_format이 지정돼 있으면 그 형식(squid-sim.conf, squid.conf, 미리 정의된 형식 순으로 찾음).
    # auto면 처음 50줄을 squid.conf가 쓰는 형식, 설정 파일의 logformat, squid.conf의 logformat, 미리 정의된 형식 순으로
    # 맞춰 보고 가장 많이 맞는 것(같으면 앞 순서)을 고른다. 하나도 맞지 않으면 시도한 형식을 보여 주고 끝낸다.
    ########
    """
    formats = {}
    for source in (BUILTIN_FORMATS, squid.formats, sim.formats):
        formats.update(source)
    local_ip = sim.get("local_ip") or squid.port_ip
    tz = sim.settings["log_timezone"]
    wanted = sim.get("log_format")
    if wanted:
        if wanted not in formats:
            sys.exit("squid-sim: log_format %s is not defined (known: %s)" % (wanted, ", ".join(sorted(formats))))
        return LogFormat(wanted, formats[wanted], local_ip, tz), "log_format in %s" % sim.path

    declared = squid.log_format()
    order = ([declared] if declared else []) + list(sim.formats) + list(squid.formats) + list(BUILTIN_FORMATS)
    lines = sample_lines(log)
    best, best_hits = None, -1
    for name in dict.fromkeys(order):
        try:
            fmt = LogFormat(name, formats[name], local_ip, tz)
        except ValueError:
            continue
        if fmt.missing:
            continue
        hits = sum(1 for line in lines if fmt.regex.match(line))
        if hits > best_hits:
            best, best_hits = fmt, hits
    if not lines:
        return LogFormat("simulformat", SIMULFORMAT), "empty log"
    if best is None or best_hits == 0:
        sys.exit("squid-sim: no known logformat matches %s; add its logformat line to squid-sim.conf "
                 "and set log_format (tried: %s)" % (log, ", ".join(dict.fromkeys(order))))
    return best, "detected, %d of %d sample lines match" % (best_hits, len(lines))


def convert_log(path, fmt, out):
    """
    ########
    # convert_log -> (변환한 줄 수, 맞지 않은 줄 수)
    # 로그 전체를 simulformat으로 out에 쓴다. 주석과 빈 줄은 그대로 두어 줄 번호를 유지하고,
    # 맞지 않는 줄은 따옴표를 바꿔 squid가 SKIP으로 보고하게 원문을 남긴다.
    ########
    """
    converted = unmatched = 0
    with open_log(path) as f:
        for line in f:
            line = line.rstrip("\r\n")
            if not line or line.startswith("#"):
                out.write(line + "\n")
                continue
            new = fmt.convert(line)
            if new is None:
                unmatched += 1
                new = line.replace('"', "'")
            else:
                converted += 1
            out.write(new + "\n")
    return converted, unmatched


def find_binary(explicit):
    """
    ########
    # find_binary -> str 또는 None
    # 패치한 squid 경로: --binary, $SQUID_SIM_BINARY, 저장소의 build/squid-*/src/squid 순.
    ########
    """
    if explicit:
        return explicit
    if os.environ.get("SQUID_SIM_BINARY"):
        return os.environ["SQUID_SIM_BINARY"]
    found = sorted(glob.glob(os.path.join(ROOT, "build", "squid-*", "src", "squid")))
    return found[-1] if found else None


def take_option(argv, names, has_value=True):
    """
    ########
    # take_option -> str, True, 또는 None
    # argv에서 "--이름 값" 또는 "--이름=값"을 지우고 값을 돌려준다(has_value=False면 플래그로 보고 True).
    # 값이 빠져 있으면 끝낸다.
    ########
    """
    for i, a in enumerate(argv):
        for name in names:
            if a == name:
                if not has_value:
                    del argv[i]
                    return True
                if i + 1 >= len(argv):
                    sys.exit("squid-sim: %s needs a value" % name)
                value = argv[i + 1]
                del argv[i:i + 2]
                return value
            if has_value and name.startswith("--") and a.startswith(name + "="):
                del argv[i]
                return a.split("=", 1)[1]
    return None


def peek_option(argv, names):
    """
    ########
    # peek_option -> str 또는 None
    # argv를 바꾸지 않고 "--이름 값", "--이름=값", "-f 값"의 값을 읽는다.
    ########
    """
    for i, a in enumerate(argv):
        for name in names:
            if a == name and i + 1 < len(argv):
                return argv[i + 1]
            if name.startswith("--") and a.startswith(name + "="):
                return a.split("=", 1)[1]
    return None


LONG_OPTIONS = ["foreground", "kid", "simulate", "sim-trace", "sim-dns", "sim-port", "sim-compare", "report",
                "optimize", "help", "version", "binary", "sim-conf", "log-format", "convert"]


def normalize_args(argv):
    """
    ########
    # normalize_args -> list[str]
    # squid의 getopt_long처럼 긴 옵션의 고유한 줄임(--simul -> --simulate)을 완전한 이름으로 펴고,
    # 붙여 쓴 -f파일을 -f 파일로 나눈다. 그래야 squid-sim이 squid와 같은 값을 읽는다.
    ########
    """
    result = []
    for a in argv:
        if a.startswith("--") and len(a) > 2:
            name, eq, value = a[2:].partition("=")
            matches = [o for o in LONG_OPTIONS if o.startswith(name)]
            if name not in LONG_OPTIONS and len(matches) == 1:
                a = "--" + matches[0] + eq + value
        elif a.startswith("-f") and len(a) > 2:
            result += ["-f", a[2:]]
            continue
        result.append(a)
    return result


def run_simulator(argv):
    """
    ########
    # run_simulator -> int (squid의 종료 코드)
    # -m 없이 실행했을 때의 진입점. 인자를 정규화하고 squid-sim 전용 옵션(--binary, --sim-conf, --log-format, --convert)을 뺀다.
    # squid.conf는 -f 또는 squid_conf, 로그는 --simulate 또는 access_log(없으면 squid.conf에서)로 정하고,
    # --optimize만 있으면 로그 없이 실행한다. sim_port, sim_dns를 채우고 개인 임시 디렉터리에서 replay()한 뒤 지운다.
    ########
    """
    argv = normalize_args(argv)
    binary = take_option(argv, ["--binary"])
    sim = SimConf(find_sim_conf(take_option(argv, ["--sim-conf"])))
    forced_format = take_option(argv, ["--log-format"])
    if forced_format:
        sim.settings["log_format"] = forced_format
    convert_only = take_option(argv, ["--convert"])

    squid_conf = peek_option(argv, ["-f"]) or sim.settings["squid_conf"]
    squid = SquidConf(squid_conf)
    log = convert_only or peek_option(argv, ["--simulate"])
    if log is None and not convert_only and "--optimize" not in argv:
        log = sim.get("access_log") or squid.log_file()
        if not log:
            sys.exit("squid-sim: no log to replay; pass --simulate FILE or set access_log in squid-sim.conf")
        argv += ["--simulate", log]
    if "-f" not in argv:
        argv = ["-f", squid_conf] + argv
    for key, option in (("sim_port", "--sim-port"), ("sim_dns", "--sim-dns")):
        if sim.get(key) and peek_option(argv, [option]) is None:
            argv += [option, sim.get(key)]

    tmp = tempfile.mkdtemp(prefix="squid-sim-")
    try:
        return replay(argv, binary, sim, squid, log, convert_only, tmp)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def replay(argv, binary, sim, squid, log, convert_only, tmp):
    """
    ########
    # replay -> int (squid의 종료 코드, 신호로 끝나면 128+신호)
    # 표준 입력 로그는 먼저 임시 파일로 받는다(형식 판별과 변환이 두 번 읽으므로). 형식을 정하고 알리며,
    # %la나 시각이 없어 결과가 달라질 수 있으면 경고한다. --convert면 변환 결과만 출력한다.
    # simulformat이 아니거나 gzip이면 임시 파일로 변환해 --simulate를 그 파일로 바꾼다.
    # 패치한 squid를 자식 프로세스로 실행하고, 받은 SIGINT/SIGTERM/SIGHUP을 자식에게 넘겨 임시 파일이 남지 않게 한다.
    ########
    """
    shown = log
    if log == "-":
        log = os.path.join(tmp, "stdin.log")
        with open(log, "wb") as out:
            shutil.copyfileobj(sys.stdin.buffer, out)
        set_simulate(argv, log)
    fmt = None
    if log:
        if not os.path.isfile(log):
            sys.exit("squid-sim: cannot open %s" % log)
        fmt, how = choose_format(log, sim, squid)
        if fmt.missing:
            sys.exit("squid-sim: logformat %s has no %s; the simulator needs the client address and URL"
                     % (fmt.name, " or ".join(fmt.missing)))
        print("squid-sim: %s is logformat %s (%s)" % (shown, fmt.name, how), file=sys.stderr)
        if not fmt.has_local_ip and squid.uses_local_ip and fmt.local_ip == "-":
            print("squid-sim: warning: the log has no %la and squid.conf uses localip/myip ACLs; "
                  "set local_ip in squid-sim.conf", file=sys.stderr)
        if not fmt.has_time:
            print("squid-sim: warning: the log has no time; time ACLs use the current time", file=sys.stderr)

    if convert_only:
        sys.stdout.flush()
        out = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="surrogateescape", newline="\n")
        converted, unmatched = convert_log(log, fmt, out)
        out.flush()
        out.detach()
        print("squid-sim: %d lines converted, %d did not match" % (converted, unmatched), file=sys.stderr)
        return 0

    binary = find_binary(binary)
    if not binary or not os.access(binary, os.X_OK):
        sys.exit("squid-sim: patched squid not found; run scripts/build.sh or pass --binary PATH")
    if fmt and not (fmt.passthrough and not log.endswith(".gz")):
        name = "stdin.log" if shown == "-" else re.sub(r"\.gz$", "", os.path.basename(log))
        copy = os.path.join(tmp, "simulformat-" + name)
        with open(copy, "w", encoding="utf-8", errors="surrogateescape", newline="\n") as out:
            converted, unmatched = convert_log(log, fmt, out)
        print("squid-sim: converted %d lines to simulformat (%d did not match and are reported as skipped)"
              % (converted, unmatched), file=sys.stderr)
        set_simulate(argv, copy)
    sys.stdout.flush()
    sys.stderr.flush()
    child = subprocess.Popen([binary] + argv)

    def forward(signum, frame):
        """
        ########
        # forward -> None
        # 받은 신호를 squid 자식 프로세스에 그대로 보낸다.
        ########
        """
        child.send_signal(signum)
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, forward)
    status = child.wait()
    return status if status >= 0 else 128 - status


def set_simulate(argv, path):
    """
    ########
    # set_simulate -> None (argv 변경)
    # argv의 --simulate 값을 주어진 경로로 바꾼다("--simulate 값", "--simulate=값" 모두).
    ########
    """
    for i, a in enumerate(argv):
        if a == "--simulate" and i + 1 < len(argv):
            argv[i + 1] = path
        elif a.startswith("--simulate="):
            argv[i] = "--simulate=" + path


def main():
    """
    ########
    # main -> int (종료 코드)
    # -m/--manager가 없으면 시뮬레이터(run_simulator)로, -h/--help면 사용법을 출력한다.
    # 매니저 모드: squid-sim.conf를 읽고 옵션을 해석해 주소(--url, manager_url, http_port 순)와 비밀번호 환경 변수를 정한다.
    # 상태를 바꾸는 페이지(shutdown 등)는 거부한다. --raw면 원문, --report가 없으면 한 번 조회해 요약,
    # 있으면 counters를 맨 앞에 두고 기록한 뒤 summary.txt와 report.html을 쓴다.
    ########
    """
    argv = sys.argv[1:]
    if not any(a in ("--manager", "-m") for a in argv):
        if argv and argv[0] in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        return run_simulator(argv)

    sim = SimConf(find_sim_conf(take_option(argv, ["--sim-conf"])))

    p = argparse.ArgumentParser(prog="squid-sim --manager",
                                description="Query or record the cache manager of a running squid (read-only).")
    p.add_argument("--manager", "-m", action="store_true", help="cache manager mode")
    p.add_argument("--url", help="squid address, e.g. http://127.0.0.1:8090 (default: first http_port of --conf)")
    p.add_argument("--conf", default=sim.settings["squid_conf"], help="squid.conf used to guess --url")
    p.add_argument("--page", action="append", help="page(s) to show, e.g. ipcache (repeat or comma-separate)")
    p.add_argument("--raw", action="store_true", help="print pages exactly as squid returns them")
    p.add_argument("--report", type=parse_duration, metavar="DURATION",
                   help="record for DURATION (60m, 1h, 30s; a bare number means minutes) and write a report")
    p.add_argument("--interval", type=parse_duration, default=60.0, metavar="DURATION",
                   help="time between polls while recording (default 60s)")
    p.add_argument("--out", help="report directory (default ./manager-report-YYYYmmdd-HHMMSS)")
    p.add_argument("--include-local", action="store_true", help="keep localhost/hosts-file entries and manager requests")
    p.add_argument("--password-env", metavar="VAR", help="environment variable holding the cachemgr_passwd password")
    p.add_argument("--timeout", type=float, default=15.0, help="seconds per request (default 15)")
    args = p.parse_args(argv)
    if args.interval < 1:
        p.error("--interval must be at least 1s")

    base = args.url or sim.get("manager_url") or first_http_port(args.conf)
    password_env = args.password_env or sim.get("manager_password_env")
    password = os.environ.get(password_env) if password_env else None
    mgr = Manager(base, password, args.timeout)
    pages = []
    for item in args.page or []:
        pages += [x for x in item.split(",") if x]
    pages = pages or list(DEFAULT_PAGES)
    refused = [x for x in pages if x.split("?")[0].lower() in STATE_CHANGING]
    if refused:
        p.error("refusing %s: squid-sim only reads; use squid -k or squidclient for actions that change squid"
                % ", ".join(refused))

    if args.report is None:
        if args.raw:
            for page in pages:
                try:
                    sys.stdout.write(mgr.get(page))
                except (urllib.error.URLError, OSError) as e:
                    sys.exit("squid-sim: %s/%s: %s" % (mgr.base, page, e))
            return 0
        errors = []
        snap = filter_snapshot(take_snapshot(mgr, pages, errors), args.include_local, mgr.own_addr)
        print_snapshot(snap, mgr.base)
        for err in errors:
            print("error: " + err, file=sys.stderr)
        return 1 if errors and len(errors) == len(pages) else 0

    for page in ("counters", "info"):
        if page not in pages:
            pages.insert(0, page)
    pages.remove("counters")
    pages.insert(0, "counters")
    out_dir = args.out or "manager-report-" + time.strftime("%Y%m%d-%H%M%S")
    print("recording %s every %s from %s into %s (Ctrl-C stops early)" % (
        fmt_duration(args.report), fmt_duration(args.interval), mgr.base, out_dir), file=sys.stderr)
    snaps, errors, _ = record(mgr, pages, args.report, args.interval, out_dir, args.include_local)
    if len(snaps) < 1 or all("counters" not in s for s in snaps):
        print("no successful poll; is squid running at %s and does http_access allow manager from here?" % mgr.base,
              file=sys.stderr)
        return 1
    s = summarize(snaps)
    write_text(s, errors, mgr.base, os.path.join(out_dir, "summary.txt"))
    write_html(s, errors, mgr.base, os.path.join(out_dir, "report.html"))
    print("wrote %s/report.html, %s/summary.txt, %s/snapshots.jsonl" % (out_dir, out_dir, out_dir), file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
